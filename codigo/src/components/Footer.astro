---
/**
 * Footer.astro — cierre del sitio. Rediseño 21/10/2026 (ref. landonorris.com):
 * marquesina, columnas de links, nombre en display enorme a sangre y botón
 * «Volver arriba».
 *
 * MISMOS textos, links y redes que antes. La columna «Seguir» sigue con los
 * canales reales confirmados (Instagram @alecurcio_capitaldevida, YouTube,
 * LinkedIn — per Web/Ecosistema Digital Actual.md) y siguen INERTES (sin
 * href, aria-disabled) hasta que se confirme la URL oficial en el vault: un
 * link que salta a "#" se lee como roto.
 *
 * La marquesina es decorativa (aria-hidden): repite textos que ya están en
 * el footer. Se pausa fuera de pantalla y con prefers-reduced-motion queda
 * quieta.
 * Usage: <Footer /> — no props, identical across the site.
 */
const columnas = [
  {
    titulo: 'Explorar',
    links: [
      { href: '/historia', texto: 'Historia' },
      { href: '/capital-de-vida', texto: 'Capital de Vida' },
      { href: '/negocios', texto: 'Negocios' },
    ],
  },
  {
    titulo: 'Leer',
    links: [
      { href: '/libros', texto: 'Libros' },
      { href: '/aventura', texto: 'Aventura' },
      { href: '/solidario', texto: 'Solidario' },
      { href: '/preguntale', texto: 'Preguntale a Ale' },
    ],
  },
  {
    titulo: 'Más',
    links: [
      { href: '/prensa', texto: 'Prensa' },
      { href: '/seguime', texto: 'Seguime' },
    ],
  },
  {
    titulo: 'Seguir',
    links: [
      { texto: 'Instagram', href: 'https://www.instagram.com/p/DLQC3KHMEOV/?hl=es&img_index=3', externo: true },
      { texto: 'YouTube' },
      { texto: 'LinkedIn' },
    ],
  },
];
const marcas = ['Curcio Capital', 'AYAX', 'El Nido'];
---

<footer class="site-footer">
  <div class="sf-body u-grid-lines">
    <div class="wrap">
      <div class="footer-top">
        <div class="sf-intro">
          <p class="footer-tag">
            Forjado en la adversidad, no heredado. 80 años de AYAX, tres libros, un sistema.
          </p>
          <a class="sf-up" href="#top" data-magnetic data-sf-up>
            <span class="sf-up-icon" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
                ><line x1="12" y1="19" x2="12" y2="5"></line><polyline points="5 12 12 5 19 12"></polyline></svg
              >
            </span>
            <span class="t-mono">Volver arriba</span>
          </a>
        </div>
        <div class="footer-links">
          {
            columnas.map((col, ci) => (
              <div class="footer-col">
                <h4 class="t-mono">
                  <span class="sf-col-idx" aria-hidden="true">{String(ci + 1).padStart(2, '0')}</span>
                  {col.titulo}
                </h4>
                {col.links.map((l) =>
                  'href' in l && l.href ? (
                    <a class="roll-host" href={l.href} {...('externo' in l && l.externo ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>
                      <span class="roll">
                        <span class="roll__in">
                          <span>{l.texto}</span>
                          <span aria-hidden="true">{l.texto}</span>
                        </span>
                      </span>
                    </a>
                  ) : (
                    <a aria-disabled="true">{l.texto}</a>
                  )
                )}
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>

  <div class="sf-name">
    <div class="footer-word t-display">Alejandro Curcio</div>
  </div>

  <div class="wrap">
    <div class="footer-bottom t-mono">
      <span>© 2026 Alejandro Curcio.</span>
      <span>Curcio Capital · AYAX · El Nido</span>
    </div>
  </div>
</footer>

<style>
  /* El selector global `footer {}` de components.css sigue existiendo (otras
     piezas usan <footer> dentro de citas); acá se pisa sólo para el del sitio. */
  footer.site-footer {
    position: relative;
    padding: 0 0 28px;
    margin-top: clamp(40px, 6vw, 96px);
    background: var(--color-black);
    color: var(--ink-hi);
    overflow: hidden;
    border-top: 1px solid var(--line);
  }

  /* ---------- marquesina ---------- */
  .sf-marquee {
    overflow: hidden;
    padding: clamp(18px, 2.4vw, 30px) 0;
    border-bottom: 1px solid var(--line);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
  }
  .sf-marquee-track {
    display: flex;
    width: max-content;
    animation: sf-marquee 16s linear infinite;
  }
  .sf-marquee.is-paused .sf-marquee-track {
    animation-play-state: paused;
  }
  .sf-marquee-group {
    display: flex;
    align-items: center;
    flex: 0 0 auto;
  }
  .sf-marquee-word {
    font-size: clamp(2.25rem, 1rem + 4.2vw, 5.25rem);
    line-height: 1;
    padding: 0 clamp(18px, 2vw, 32px);
    white-space: nowrap;
    color: var(--ink-hi);
  }
  .sf-marquee-word.t-display--outline {
    color: transparent;
    -webkit-text-stroke: 1px rgb(255 255 255 / 0.55);
  }
  /* separador: trébol de marca en dorado */
  .sf-marquee-sep {
    width: clamp(22px, 2.4vw, 38px);
    height: clamp(22px, 2.4vw, 38px);
    flex: 0 0 auto;
    background-color: var(--accent);
    -webkit-mask: url('/media/marca/trebol.png') no-repeat center / contain;
    mask: url('/media/marca/trebol.png') no-repeat center / contain;
  }
  @keyframes sf-marquee {
    to {
      transform: translateX(-50%);
    }
  }

  /* ---------- cuerpo ---------- */
  .sf-body {
    padding: clamp(56px, 7vw, 112px) 0 clamp(40px, 5vw, 72px);
  }
  .footer-top {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(40px, 5vw, 96px);
    padding-bottom: 0;
    border-bottom: 0;
  }
  .sf-intro {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 22px;
  }
  .footer-tag {
    margin: 0;
    max-width: 22ch;
    font-size: clamp(1.375rem, 1rem + 1.2vw, 2.125rem);
    line-height: 1.16;
    letter-spacing: -0.015em;
    font-weight: 500;
    color: var(--ink-hi);
  }
  .sf-up {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    margin-top: 12px;
    color: var(--ink-mid);
    transition: color var(--dur-sm) var(--ease-out);
  }
  .sf-up-icon {
    display: inline-grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1px var(--line-strong);
    color: var(--ink-hi);
    transition:
      background-color var(--dur-sm) var(--ease-out),
      color var(--dur-sm) var(--ease-out),
      box-shadow var(--dur-sm) var(--ease-out);
  }
  .sf-up-icon svg {
    transition: transform 600ms var(--ease-expo);
  }
  .sf-up:hover {
    color: var(--ink-hi);
  }
  .sf-up:hover .sf-up-icon {
    background: var(--accent);
    color: var(--color-black);
    box-shadow: inset 0 0 0 1px var(--accent);
  }
  .sf-up:hover .sf-up-icon svg {
    transform: translateY(-3px);
  }

  .footer-links {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr) minmax(0, 0.8fr) minmax(0, 1.7fr);
    gap: 32px clamp(20px, 2.4vw, 40px);
  }
  .footer-col h4 {
    display: flex;
    gap: 10px;
    align-items: baseline;
    margin-bottom: 22px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--line);
    font-size: var(--fs-mono);
    font-weight: 500;
    letter-spacing: 0.08em;
    color: var(--ink-low);
  }
  .sf-col-idx {
    color: var(--accent);
  }
  .footer-col a {
    display: block;
    width: fit-content;
    max-width: 100%;
    font-size: 15px;
    line-height: 1.35;
    margin-bottom: 12px;
    color: var(--ink-mid);
    transition: color var(--dur-sm) var(--ease-out);
  }
  .footer-col a[href]:hover,
  .footer-col a[href]:focus-visible {
    color: var(--accent);
  }
  /* canales sin URL confirmada: se ven como dato, no como link */
  .footer-col a[aria-disabled='true'] {
    color: var(--ink-low);
    cursor: default;
    overflow-wrap: break-word;
  }
  .footer-col a[aria-disabled='true']:hover {
    color: var(--ink-low);
  }

  /* ---------- nombre a sangre ---------- */
  .sf-name {
    padding: 0 clamp(8px, 1vw, 16px);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    overflow: hidden;
  }
  .footer-word {
    /* Punto de partida; el script lo ajusta al ancho exacto (fit-text) cuando
       cargó la fuente. Sin JS queda en un tamaño que entra con margen. */
    font-size: 11.5vw;
    line-height: 0.9;
    letter-spacing: -0.055em;
    font-weight: 600;
    white-space: nowrap;
    width: max-content;
    margin-inline: auto;
    padding: 0.04em 0 0.06em;
    margin-bottom: 0;
    color: var(--ink-hi);
    background: linear-gradient(180deg, var(--color-white) 30%, rgb(var(--accent-rgb) / 0.95) 130%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    text-wrap: nowrap;
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    padding-top: 22px;
    font-size: var(--fs-mono-sm);
    color: var(--ink-low);
  }

  @media (max-width: 1023px) {
    .footer-top {
      grid-template-columns: 1fr;
    }
    .footer-links {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    /* «Seguir» lleva el handle largo de Instagram: fila propia, sin cortes. */
    .footer-col:last-child {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 720px) {
    .footer-bottom {
      flex-direction: column;
      gap: 6px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sf-marquee-track {
      animation: none;
    }
    .sf-up:hover .sf-up-icon svg {
      transform: none;
    }
  }
</style>

<script>
  // Marquesina: pausa fuera de pantalla (scroll + getBoundingClientRect; sin
  // IntersectionObserver, que no dispara en el preview del proyecto).
  const strip = document.querySelector<HTMLElement>('[data-sf-marquee]');
  if (strip) {
    let pending = false;
    const check = () => {
      pending = false;
      const r = strip.getBoundingClientRect();
      strip.classList.toggle('is-paused', r.bottom < 0 || r.top > innerHeight);
    };
    const onScroll = () => {
      if (!pending) {
        pending = true;
        requestAnimationFrame(check);
      }
    };
    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', onScroll, { passive: true });
    check();
  }

  // Nombre a sangre: ajusta el tamaño para que llene el ancho exacto.
  const word = document.querySelector<HTMLElement>('.site-footer .footer-word');
  if (word) {
    const fit = () => {
      word.style.fontSize = '';
      const box = word.parentElement!.clientWidth - parseFloat(getComputedStyle(word.parentElement!).paddingLeft) * 2;
      const size = parseFloat(getComputedStyle(word).fontSize);
      const natural = word.getBoundingClientRect().width;
      if (natural > 0) word.style.fontSize = `${(size * box * 0.995) / natural}px`;
    };
    (document.fonts?.ready ?? Promise.resolve()).then(fit);
    let t = 0;
    addEventListener('resize', () => {
      clearTimeout(t);
      t = window.setTimeout(fit, 120);
    });
  }

  // Volver arriba: con Lenis si está (smooth global), si no scroll nativo.
  document.querySelector<HTMLAnchorElement>('[data-sf-up]')?.addEventListener('click', (e) => {
    e.preventDefault();
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const lenis = (window as unknown as { __lenis?: { scrollTo: (t: number, o?: object) => void } }).__lenis;
    if (lenis && !reduce) lenis.scrollTo(0, { duration: 1.6 });
    else window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
    // el foco vuelve al principio del documento
    const top = document.getElementById('top');
    if (top) {
      top.setAttribute('tabindex', '-1');
      top.focus({ preventScroll: true });
    }
  });
</script>
