---
/**
 * Header.astro — ribbon dorado de «CEO DE TU VIDA» + barra mínima fija
 * (estilo landonorris.com) + menú overlay a pantalla completa.
 * Rendered once by Base.astro on every page. Usage: <Header /> — sin props.
 *
 * REDISEÑO 21/10/2026. Mismos items y destinos que la barra anterior:
 *   · búsqueda → /preguntale («Preguntale a Ale»)
 *   · Sobre Alejandro → /#facetas
 *   · Explorar: Libros → /libros · Podcast → /seguime#canales
 *   · CTA «CEO DE TU VIDA» → /ceo-de-tu-vida
 * Lo que cambió es el TRATAMIENTO: la barra queda con marca, búsqueda, CTA
 * y un botón «Menú»; los links pasan al overlay en tipografía display.
 *
 * Progresivo: el botón de menú es un <a href="#menu-sitio">. Sin JS el
 * overlay se abre por :target y «Cerrar» (href="#") lo cierra. Con JS se
 * comporta como diálogo: aria-expanded, Escape, foco atrapado, scroll
 * bloqueado (también Lenis, si está: window.__lenis).
 *
 * Previews del menú: SOLO assets existentes de /media que ya usan esas
 * secciones (se cargan recién al abrir el menú por primera vez).
 */
const items = [
  {
    href: '/#facetas',
    nombre: 'Sobre Alejandro',
    preview: '/media/video/bz4x-card-poster.jpg',
  },
  {
    href: '/libros',
    nombre: 'Libros',
    nota: 'Capital de Vida, Toolbook y el tercero',
    grupo: 'Explorar',
    preview: '/media/covers/capital-de-vida-front-640.webp',
  },
  {
    // TODO: cuando se confirme la URL del canal «Alejandro Curcio -
    // Capital de Vida», apuntar acá directo (hoy cae en /seguime, que es
    // donde vive la ficha del canal).
    href: '/seguime#canales',
    nombre: 'Podcast',
    nota: 'Las conversaciones largas, en YouTube',
    grupo: 'Explorar',
    preview: '/media/img/retrato-estudio-640.webp',
  },
  {
    href: '/preguntale',
    nombre: 'Preguntale a Ale',
    preview: '/media/video/brindis-poster.jpg',
  },
];
const ctaPreview = '/media/covers/ceo-de-tu-vida-mockup.jpg';
const pad = (n: number) => String(n).padStart(2, '0');
const arrow = `<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>`;
---

<a class="ribbon" href="/ceo-de-tu-vida">
  <span class="ribbon-brand">CEO DE TU VIDA</span>
  <span class="ribbon-label">— el tercer libro llega en noviembre 2026</span>
  <!-- Cuenta regresiva al lanzamiento (fecha confirmada por el cliente: 2026-11-17, America/Montevideo;
       cambiar data-countdown cuando se anuncie la fecha real). Oculta hasta
       que el JS confirma que la fecha es válida y futura.
       SOLO DÍAS, a propósito: un contador con segundos corriendo es el gesto
       de una landing de infoproducto, y la regla del proyecto es que la
       prueba va antes que la promesa. A dos meses del lanzamiento la
       precisión al segundo no informa nada — sólo mete urgencia fabricada. -->
  <span class="ribbon-count" data-countdown="2026-11-17T00:00:00-03:00" hidden></span>
  <span class="ribbon-arrow" aria-hidden="true">→</span>
</a>

<header class="nav" data-nav>
  <div class="nav-inner">
    <a class="wordmark" href="/">
      <span class="wordmark-trebol" aria-hidden="true"></span>
      <span class="wordmark-text">Alejandro Curcio</span>
    </a>
    <div class="nav-right">
      <a class="pill pill--accent nav-cta" href="/ceo-de-tu-vida" data-magnetic>
        <span class="pill-label" data-roll>CEO DE TU VIDA</span>
        <Fragment set:html={arrow} />
      </a>
      <a
        class="nav-burger"
        href="#menu-sitio"
        role="button"
        aria-controls="menu-sitio"
        aria-expanded="false"
        data-menu-open
        data-magnetic
      >
        <span class="nav-burger-label t-mono">Menú</span>
        <span class="nav-burger-icon" aria-hidden="true"><i></i><i></i></span>
      </a>
    </div>
  </div>
</header>

<div class="menu" id="menu-sitio" role="dialog" aria-modal="true" aria-label="Menú" data-menu>
  <div class="menu-bg" aria-hidden="true"></div>
  <div class="menu-grid" aria-hidden="true"></div>

  <div class="menu-top">
    <a class="wordmark" href="/" tabindex="-1">
      <span class="wordmark-trebol" aria-hidden="true"></span>
      <span class="wordmark-text">Alejandro Curcio</span>
    </a>
    <a class="nav-burger is-close" href="#" role="button" data-menu-close>
      <span class="nav-burger-label t-mono">Cerrar</span>
      <span class="nav-burger-icon" aria-hidden="true"><i></i><i></i></span>
    </a>
  </div>

  <nav class="menu-body" aria-label="Principal">
    <ol class="menu-list">
      {
        items.map((it, i) => (
          <li class="menu-item" style={`--i:${i}`}>
            {it.grupo && (i === 0 || items[i - 1].grupo !== it.grupo) && (
              <span class="menu-grupo t-mono">{it.grupo}</span>
            )}
            <a class="menu-link roll-host" href={it.href} data-preview={it.preview}>
              <span class="menu-idx t-mono" aria-hidden="true">{pad(i + 1)}</span>
              <span class="menu-word t-display">
                <span class="menu-mask">
                  <span class="roll">
                    <span class="roll__in">
                      <span>{it.nombre}</span>
                      <span aria-hidden="true">{it.nombre}</span>
                    </span>
                  </span>
                </span>
              </span>
              {it.nota && <span class="menu-nota">{it.nota}</span>}
            </a>
          </li>
        ))
      }
    </ol>

    <div class="menu-foot" style={`--i:${items.length}`}>
      <a class="pill pill--accent menu-cta" href="/ceo-de-tu-vida" data-preview={ctaPreview} data-magnetic>
        <span class="pill-label" data-roll>CEO DE TU VIDA</span>
        <Fragment set:html={arrow} />
      </a>
    </div>
  </nav>

  <!-- Preview que sigue al cursor (sólo puntero fino + hover). -->
  <div class="menu-preview" aria-hidden="true">
    <div class="menu-preview-frame u-crop">
      {[...items.map((it) => it.preview), ctaPreview].map((src) => <img data-src={src} alt="" decoding="async" />)}
    </div>
  </div>
</div>

<style>
  /* ============ ribbon ============ */
  a.ribbon {
    position: relative;
    z-index: 101;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    text-decoration: none;
    transition: filter var(--dur-sm) var(--ease-out);
  }
  a.ribbon:hover {
    filter: brightness(1.06);
  }
  .ribbon-brand {
    font-weight: 700;
  }
  .ribbon-label {
    /* Sin opacidad: blanco al 85% sobre el dorado cae a 4.09:1. La
       jerarquía la hace el peso, no la transparencia. */
    font-weight: 500;
  }
  /* Sin caja: una hairline separa el aviso de la cuenta. Mono: es un dato. */
  .ribbon-count {
    display: inline-flex;
    align-items: center;
    margin-left: 4px;
    padding-left: 14px;
    border-left: 1px solid rgba(255, 255, 255, 0.32);
    font-family: var(--font-mono);
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .ribbon-arrow {
    margin-left: 2px;
    transition: transform var(--dur-sm) var(--ease-out);
  }
  a.ribbon:hover .ribbon-arrow {
    transform: translateX(3px);
  }
  @media (max-width: 640px) {
    .ribbon-label {
      display: none;
    }
  }

  /* ============ barra ============ */
  /* Sticky (ocupa su alto en el flujo: los héroes de las páginas descuentan
     --nav-h). Transparente arriba de todo; al scrollear pasa a vidrio.
     Se esconde al bajar y vuelve al subir (clases que pone el script). */
  header.nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background: transparent;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    border-bottom: 1px solid transparent;
    transition:
      transform 600ms var(--ease-expo),
      background-color var(--dur-md) var(--ease-out),
      border-color var(--dur-md) var(--ease-out);
  }
  header.nav.is-scrolled {
    background: rgb(12 10 6 / 0.62);
    backdrop-filter: blur(16px) saturate(1.3);
    -webkit-backdrop-filter: blur(16px) saturate(1.3);
    border-bottom-color: var(--line);
  }
  header.nav.is-hidden {
    transform: translateY(-101%);
  }
  .nav-inner {
    height: var(--nav-h);
    max-width: none;
    padding: 0 clamp(16px, 2.2vw, 32px);
  }
  .nav-right {
    gap: clamp(10px, 1.4vw, 18px);
  }

  /* marca */
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 17px;
    letter-spacing: -0.02em;
    line-height: 1;
    text-transform: none;
    white-space: nowrap;
  }
  /* Trébol: máscara CSS, el color sale de background-color (sigue al tema). */
  .wordmark-trebol {
    width: 1.3em;
    height: 1.3em;
    flex: 0 0 auto;
    background-color: currentColor;
    -webkit-mask: url('/media/marca/trebol.png') no-repeat center / contain;
    mask: url('/media/marca/trebol.png') no-repeat center / contain;
    transition:
      background-color var(--dur-sm) var(--ease-out),
      transform 700ms var(--ease-expo);
  }
  .wordmark:hover .wordmark-trebol {
    background-color: var(--accent);
    transform: rotate(90deg);
  }
  @media (max-width: 480px) {
    .wordmark-trebol {
      width: 1.5em;
      height: 1.5em;
    }
    /* En pantallas muy angostas manda la marca. */
    .wordmark-text {
      display: none;
    }
  }

  /* búsqueda: botón redondo con hairline */
  .nav-search {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    opacity: 1;
    color: var(--ink-hi);
    box-shadow: inset 0 0 0 1px var(--line-strong);
    transition:
      background-color var(--dur-sm) var(--ease-out),
      color var(--dur-sm) var(--ease-out),
      box-shadow var(--dur-sm) var(--ease-out);
  }
  .nav-search:hover {
    background: var(--color-white);
    color: var(--color-black);
    box-shadow: inset 0 0 0 1px var(--color-white);
  }

  .nav-cta {
    min-height: 44px;
    height: 44px;
    padding: 0 20px;
  }

  /* botón de menú */
  .nav-burger {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    height: 44px;
    padding: 0 8px 0 18px;
    border-radius: 999px;
    background: var(--color-white);
    color: var(--color-black);
    cursor: pointer;
    transition: background-color var(--dur-sm) var(--ease-out);
  }
  .nav-burger:hover {
    background: var(--accent);
  }
  .nav-burger-label {
    font-weight: 600;
    letter-spacing: 0.1em;
  }
  .nav-burger-icon {
    position: relative;
    display: inline-block;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--color-black);
  }
  .nav-burger-icon i {
    position: absolute;
    left: 9px;
    right: 9px;
    height: 1.5px;
    background: var(--color-white);
    transition:
      transform 500ms var(--ease-expo),
      top 500ms var(--ease-expo);
  }
  .nav-burger-icon i:first-child {
    top: 12px;
  }
  .nav-burger-icon i:last-child {
    top: 17px;
  }
  .nav-burger:hover .nav-burger-icon i:first-child {
    transform: scaleX(0.6);
    transform-origin: left;
  }
  .nav-burger.is-close .nav-burger-icon i:first-child,
  .nav-burger.is-close:hover .nav-burger-icon i:first-child {
    top: 14.5px;
    transform: rotate(45deg);
  }
  .nav-burger.is-close .nav-burger-icon i:last-child {
    top: 14.5px;
    transform: rotate(-45deg);
  }

  @media (max-width: 720px) {
    .nav-search {
      display: inline-grid; /* components.css la oculta en móvil; acá vuelve: es la búsqueda */
      width: 40px;
      height: 40px;
    }
    .nav-cta {
      min-height: 40px;
      height: 40px;
      padding: 0 14px;
      font-size: 13px;
    }
    .nav-cta :global(svg) {
      display: none;
    }
    .nav-burger {
      height: 40px;
      padding: 0 5px 0 14px;
      gap: 8px;
    }
  }
  @media (max-width: 380px) {
    .nav-burger-label {
      display: none;
    }
    .nav-burger {
      padding: 0 5px;
    }
  }

  /* ============ menú overlay ============ */
  /* Cerrado / abierto con la MISMA forma de selector (ver LEEME: si una va
     suelta y la otra anidada, Astro scopea una sola y la cerrada gana). */
  .menu {
    position: fixed;
    inset: 0;
    z-index: 500;
    display: grid;
    grid-template-rows: auto 1fr;
    color: var(--color-white);
    visibility: hidden;
    pointer-events: none;
    transition: visibility 0s linear 900ms;
  }
  .menu.is-open,
  .menu:target {
    visibility: visible;
    pointer-events: auto;
    transition: visibility 0s linear 0s;
  }
  .menu-bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(70% 60% at 85% 10%, rgb(var(--accent-rgb) / 0.12), transparent 60%),
      var(--color-black);
    clip-path: inset(0 0 100% 0);
    transition: clip-path 800ms var(--ease-quart) 80ms;
  }
  .menu.is-open .menu-bg,
  .menu:target .menu-bg {
    clip-path: inset(0 0 0 0);
    transition-delay: 0ms;
  }
  .menu-grid {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0;
    transition: opacity 500ms var(--ease-out);
    background-image: linear-gradient(to right, var(--line) 1px, transparent 1px);
    background-size: calc(100% / 6) 100%;
    background-position: clamp(16px, 2.2vw, 32px) 0;
  }
  .menu.is-open .menu-grid,
  .menu:target .menu-grid {
    opacity: 1;
    transition-delay: 450ms;
  }

  .menu-top {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--nav-h);
    padding: 0 clamp(16px, 2.2vw, 32px);
    opacity: 0;
    transition: opacity 300ms var(--ease-out);
  }
  .menu.is-open .menu-top,
  .menu:target .menu-top {
    opacity: 1;
    transition-delay: 350ms;
  }

  .menu-body {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 40px;
    padding: clamp(24px, 6vh, 72px) clamp(16px, 2.2vw, 32px) clamp(28px, 5vh, 56px);
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .menu-list {
    display: grid;
    gap: clamp(4px, 1vh, 12px);
    counter-reset: none;
  }
  .menu-item {
    position: relative;
  }
  .menu-grupo {
    display: block;
    margin: clamp(10px, 2vh, 22px) 0 6px;
    padding-left: clamp(44px, 5vw, 76px);
    color: var(--accent);
    opacity: 0;
    transition: opacity 400ms var(--ease-out);
  }
  .menu.is-open .menu-grupo,
  .menu:target .menu-grupo {
    opacity: 1;
    transition-delay: calc(420ms + var(--i) * 70ms);
  }
  .menu-link {
    display: grid;
    grid-template-columns: clamp(44px, 5vw, 76px) auto 1fr;
    align-items: start;
    column-gap: 0;
    color: var(--ink-hi);
    transition: color var(--dur-sm) var(--ease-out);
    width: max-content;
    max-width: 100%;
  }
  .menu-idx {
    color: var(--ink-low);
    padding-top: 1.1em;
    transition: color var(--dur-sm) var(--ease-out);
  }
  .menu-word {
    font-size: clamp(2.5rem, 1rem + 5.6vw, 7.25rem);
    line-height: 1;
    letter-spacing: -0.045em;
    font-weight: 520;
  }
  .menu-mask {
    display: block;
    overflow: hidden;
    padding-bottom: 0.08em;
  }
  .menu-mask > .roll {
    display: block;
    transform: translateY(110%);
    transition: transform 900ms var(--ease-expo);
    transition-delay: 0ms;
  }
  .menu.is-open .menu-mask > .roll,
  .menu:target .menu-mask > .roll {
    transform: translateY(0);
    transition-delay: calc(300ms + var(--i) * 70ms);
  }
  .menu-nota {
    align-self: center;
    margin-left: clamp(14px, 2vw, 28px);
    max-width: 22ch;
    font-size: 14px;
    line-height: 1.35;
    color: var(--ink-low);
    opacity: 0;
    transition:
      opacity 400ms var(--ease-out),
      color var(--dur-sm) var(--ease-out);
  }
  .menu.is-open .menu-nota,
  .menu:target .menu-nota {
    opacity: 1;
    transition-delay: calc(550ms + var(--i) * 70ms), 0ms;
  }
  .menu-link:hover,
  .menu-link:focus-visible,
  .menu-link.is-current {
    color: var(--accent);
  }
  .menu-link:hover .menu-idx,
  .menu-link:focus-visible .menu-idx {
    color: var(--accent);
  }
  .menu-link:hover .menu-nota {
    color: var(--ink-mid);
  }
  /* Al pasar por un item, los otros se apagan (foco de atención). */
  .menu-list:hover .menu-link:not(:hover) {
    color: rgb(255 255 255 / 0.32);
  }

  .menu-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
    padding-top: 24px;
    border-top: 1px solid var(--line);
    opacity: 0;
    transform: translateY(16px);
    transition:
      opacity 400ms var(--ease-out),
      transform 600ms var(--ease-expo);
  }
  .menu.is-open .menu-foot,
  .menu:target .menu-foot {
    opacity: 1;
    transform: none;
    transition-delay: calc(450ms + var(--i) * 70ms);
  }
  .menu-cta {
    height: 52px;
    padding: 0 26px;
    font-size: 15px;
  }

  /* preview que sigue al cursor */
  .menu-preview {
    position: fixed;
    left: 0;
    top: 0;
    z-index: 2;
    width: clamp(220px, 20vw, 320px);
    aspect-ratio: 4 / 5;
    pointer-events: none;
    display: none;
    will-change: transform;
  }
  @media (hover: hover) and (pointer: fine) and (min-width: 1024px) {
    .menu-preview {
      display: block;
    }
  }
  .menu-preview-frame {
    position: absolute;
    inset: 0;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--color-black-2);
    clip-path: inset(50% 50% 50% 50% round var(--radius-lg));
    transition: clip-path 700ms var(--ease-expo);
    --crop-inset: 12px;
  }
  .menu-preview.is-on .menu-preview-frame {
    clip-path: inset(0 0 0 0 round var(--radius-lg));
  }
  .menu-preview img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transform: scale(1.15);
    transition:
      opacity 450ms var(--ease-out),
      transform 900ms var(--ease-expo);
  }
  .menu-preview img.is-active {
    opacity: 1;
    transform: scale(1);
  }

  @media (max-width: 720px) {
    .menu-link {
      grid-template-columns: 36px 1fr;
      width: auto;
    }
    .menu-idx {
      padding-top: 0.55em;
    }
    .menu-grupo {
      padding-left: 36px;
    }
    .menu-word {
      font-size: clamp(2.25rem, 11vw, 4rem);
    }
    .menu-nota {
      grid-column: 2;
      margin: 8px 0 4px;
      max-width: none;
      font-size: 13px;
    }
    .menu-grid {
      background-size: 25% 100%;
    }
    .menu-cta {
      width: 100%;
      justify-content: center;
    }
  }

  /* reduced motion: sin transforms ni cortina — un fundido corto. */
  @media (prefers-reduced-motion: reduce) {
    header.nav,
    header.nav.is-hidden {
      transform: none;
      transition: background-color 150ms linear;
    }
    .menu-bg,
    .menu.is-open .menu-bg,
    .menu:target .menu-bg {
      clip-path: none;
    }
    .menu {
      opacity: 0;
      transition:
        opacity 180ms linear,
        visibility 0s linear 180ms;
    }
    .menu.is-open,
    .menu:target {
      opacity: 1;
      transition:
        opacity 180ms linear,
        visibility 0s;
    }
    .menu-mask > .roll,
    .menu.is-open .menu-mask > .roll,
    .menu:target .menu-mask > .roll,
    .menu-foot,
    .menu.is-open .menu-foot,
    .menu:target .menu-foot {
      transform: none;
      transition: none;
    }
    .menu-preview {
      display: none !important;
    }
    .wordmark:hover .wordmark-trebol {
      transform: none;
    }
  }
</style>

<script>
  // ---------- Cuenta regresiva (sin cambios de lógica) ----------
  // Lee la fecha de data-countdown; queda oculta si es inválida o ya pasó.
  // Sólo días; con días alcanza revisar una vez por minuto.
  const count = document.querySelector<HTMLElement>('.ribbon-count');
  if (count) {
    const target = new Date(count.dataset.countdown || '').getTime();
    const tick = () => {
      const left = target - Date.now();
      if (left <= 0) {
        count.hidden = true;
        return;
      }
      const dias = Math.ceil(left / 86400000);
      count.textContent =
        dias === 1 ? 'Falta 1 día' : dias <= 0 ? 'Es hoy' : `Faltan ${dias} días`;
    };
    if (!Number.isNaN(target) && target > Date.now()) {
      tick();
      count.hidden = false;
      setInterval(tick, 60000);
    }
  }

  const reduce = matchMedia('(prefers-reduced-motion: reduce)');
  type LenisLike = { stop?: () => void; start?: () => void; scrollTo?: (t: number | string | HTMLElement, o?: object) => void };
  const lenis = () => (window as unknown as { __lenis?: LenisLike }).__lenis;

  // ---------- Barra: vidrio al scrollear, se esconde al bajar ----------
  const nav = document.querySelector<HTMLElement>('[data-nav]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  if (nav) {
    let lastY = window.scrollY;
    let ticking = false;
    const update = () => {
      ticking = false;
      const y = window.scrollY;
      const dy = y - lastY;
      nav.classList.toggle('is-scrolled', y > 8);
      const menuOpen = menu?.classList.contains('is-open');
      if (menuOpen || nav.matches(':focus-within') || y < 240) {
        nav.classList.remove('is-hidden');
      } else if (dy > 6) {
        nav.classList.add('is-hidden');
      } else if (dy < -6) {
        nav.classList.remove('is-hidden');
      }
      if (Math.abs(dy) > 6) lastY = y;
    };
    addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true }
    );
    nav.addEventListener('focusin', () => nav.classList.remove('is-hidden'));
    update();
  }

  // ---------- Menú overlay ----------
  const openers = document.querySelectorAll<HTMLElement>('[data-menu-open]');
  const closer = menu?.querySelector<HTMLElement>('[data-menu-close]');
  if (menu && openers.length) {
    // Con JS el overlay deja de depender de :target.
    if (location.hash === '#menu-sitio') history.replaceState(null, '', location.pathname + location.search);
    const opener = openers[0];
    const focusables = () =>
      Array.from(menu.querySelectorAll<HTMLElement>('a[href]:not([tabindex="-1"]), button:not([disabled])')).filter(
        (el) => el.offsetParent !== null || el === closer
      );
    let lastFocus: HTMLElement | null = null;
    let loaded = false;

    // Item de la página actual (por ruta) → estado activo.
    menu.querySelectorAll<HTMLAnchorElement>('.menu-link').forEach((a) => {
      const u = new URL(a.href, location.href);
      if (u.pathname === location.pathname && !u.hash && u.pathname !== '/') {
        a.classList.add('is-current');
        a.setAttribute('aria-current', 'page');
      }
    });

    const setInert = (closed: boolean) => {
      if (closed) menu.setAttribute('inert', '');
      else menu.removeAttribute('inert');
      menu.setAttribute('aria-hidden', String(closed));
    };
    setInert(true);

    const open = () => {
      if (menu.classList.contains('is-open')) return;
      if (!loaded) {
        menu.querySelectorAll<HTMLImageElement>('img[data-src]').forEach((img) => (img.src = img.dataset.src!));
        loaded = true;
      }
      lastFocus = document.activeElement as HTMLElement;
      setInert(false);
      menu.classList.add('is-open');
      openers.forEach((o) => o.setAttribute('aria-expanded', 'true'));
      document.documentElement.classList.add('menu-abierto');
      document.documentElement.style.overflow = 'hidden';
      lenis()?.stop?.();
      // foco al primer link cuando la cortina ya bajó lo suficiente
      setTimeout(() => menu.querySelector<HTMLElement>('.menu-link')?.focus({ preventScroll: true }), reduce.matches ? 0 : 280);
    };
    const close = (restore = true) => {
      if (!menu.classList.contains('is-open')) return;
      menu.classList.remove('is-open');
      setInert(true);
      openers.forEach((o) => o.setAttribute('aria-expanded', 'false'));
      document.documentElement.classList.remove('menu-abierto');
      document.documentElement.style.overflow = '';
      lenis()?.start?.();
      preview?.classList.remove('is-on');
      if (restore) (lastFocus && document.contains(lastFocus) ? lastFocus : opener).focus({ preventScroll: true });
    };

    openers.forEach((o) => {
      o.addEventListener('click', (e) => {
        e.preventDefault();
        open();
      });
      // role="button" sobre <a>: Espacio también activa.
      o.addEventListener('keydown', (e) => {
        if (e.key === ' ') {
          e.preventDefault();
          open();
        }
      });
    });
    closer?.addEventListener('click', (e) => {
      e.preventDefault();
      close();
    });
    closer?.addEventListener('keydown', (e) => {
      if (e.key === ' ') {
        e.preventDefault();
        close();
      }
    });
    document.addEventListener('keydown', (e) => {
      if (!menu.classList.contains('is-open')) return;
      if (e.key === 'Escape') {
        e.preventDefault();
        close();
        return;
      }
      if (e.key === 'Tab') {
        const f = focusables();
        if (!f.length) return;
        const first = f[0];
        const last = f[f.length - 1];
        const act = document.activeElement as HTMLElement;
        if (e.shiftKey && (act === first || !menu.contains(act))) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && (act === last || !menu.contains(act))) {
          e.preventDefault();
          first.focus();
        }
      }
    });
    // Navegar: cerrar sin devolver el foco (la página cambia o salta a un ancla).
    menu.querySelectorAll<HTMLAnchorElement>('.menu-body a[href], .menu-top .wordmark').forEach((a) =>
      a.addEventListener('click', () => close(false))
    );

    // ---- preview que sigue al cursor ----
    const preview = menu.querySelector<HTMLElement>('.menu-preview');
    const imgs = preview ? Array.from(preview.querySelectorAll<HTMLImageElement>('img')) : [];
    const fine = matchMedia('(hover: hover) and (pointer: fine) and (min-width: 1024px)');
    if (preview && imgs.length) {
      let tx = innerWidth * 0.7,
        ty = innerHeight * 0.4,
        x = tx,
        y = ty,
        raf = 0;
      const w = () => preview.offsetWidth;
      const h = () => preview.offsetHeight;
      const loop = () => {
        x += (tx - x) * 0.14;
        y += (ty - y) * 0.14;
        const rot = Math.max(-8, Math.min(8, (tx - x) * 0.04));
        preview.style.transform = `translate3d(${x - w() / 2}px, ${y - h() / 2}px, 0) rotate(${rot}deg)`;
        raf = Math.abs(tx - x) + Math.abs(ty - y) > 0.3 && menu.classList.contains('is-open') ? requestAnimationFrame(loop) : 0;
      };
      const kick = () => {
        if (!raf) raf = requestAnimationFrame(loop);
      };
      menu.addEventListener('pointermove', (e) => {
        if (!fine.matches || reduce.matches) return;
        // Sigue al cursor, pero vive en la mitad derecha: así nunca tapa la
        // palabra ni la nota del item que se está leyendo.
        const half = w() / 2;
        tx = Math.min(Math.max(e.clientX + half + 140, innerWidth * 0.66), innerWidth - half - 40);
        ty = Math.min(Math.max(e.clientY, h() / 2 + 24), innerHeight - h() / 2 - 24);
        kick();
      });
      menu.querySelectorAll<HTMLElement>('[data-preview]').forEach((link) => {
        const src = link.dataset.preview;
        const show = () => {
          if (!fine.matches || reduce.matches) return;
          imgs.forEach((img) => img.classList.toggle('is-active', img.dataset.src === src));
          preview.classList.add('is-on');
        };
        link.addEventListener('pointerenter', show);
        link.addEventListener('pointerleave', () => preview.classList.remove('is-on'));
      });
    }
  }

  // ---------- Pills: el relleno crece desde el punto de entrada ----------
  // Delegado en document: cubre también los .pill escritos a mano en las
  // páginas. Sólo escribe --px/--py; el resto es CSS (system/refresh.css).
  const setOrigin = (e: PointerEvent) => {
    const el = (e.target as Element | null)?.closest?.<HTMLElement>('.pill');
    if (!el) return;
    const related = e.relatedTarget as Node | null;
    if (related && el.contains(related)) return;
    const r = el.getBoundingClientRect();
    el.style.setProperty('--px', `${e.clientX - r.left}px`);
    el.style.setProperty('--py', `${e.clientY - r.top}px`);
  };
  document.addEventListener('pointerover', setOrigin, { passive: true });
  document.addEventListener('pointerout', setOrigin, { passive: true });
</script>
