---
/**
 * CascoEnPista.astro — apertura de /deportista «como landonorris.com/on-track»
 * (pedido del cliente, 26/10/2026).
 *
 * El casco GR empieza de perfil a un lado, con el titular «En pista» /
 * «Toyota Gazoo Racing Drift Pilot». Al scrollear, la sección queda fija y el
 * casco da un giro completo de 360°, viene al centro y se aleja mientras entra
 * el video del drift: así se pasa a la sección de videos.
 *
 * El giro es una secuencia de 72 fotogramas (cada 5°) pre-renderizada desde un
 * modelo 3D (Higgsfield) con el trébol de Capital de Vida aplicado como
 * calcomanía en ambos laterales: es el logo exacto. Fotogramas en
 * /media/casco-gr360/c{800|480}-NN.webp. Sin JS se ve el fotograma inicial.
 */
interface Props {
  titulo: string;
  bajada: string;
  frase: string;
  ficha: string[];
}
const { titulo, bajada, frase, ficha } = Astro.props;
---

<section class="ep" data-ep data-frames="/media/casco-gr360/" aria-labelledby="ep-titulo">
  <div class="ep-pin">
    <div class="ep-stage">
      <span class="ep-scrim" aria-hidden="true"></span>
      <span class="ep-grid" aria-hidden="true"></span>

      <div class="ep-casco" data-ep-casco aria-hidden="true">
        <img class="ep-fallback" src="/media/casco-gr360/c800-00.webp" alt="" />
        <canvas class="ep-canvas" data-ep-canvas></canvas>
      </div>

      <div class="ep-copy wrap" data-ep-copy>
        <p class="pa-kick"><span class="pa-idx">[ 01 ]</span>Deportista</p>
        <h1 id="ep-titulo" class="ep-title">{titulo}</h1>
        <p class="ep-bajada">{bajada}</p>
      </div>


      <div class="ep-scroll" style="display:none" aria-hidden="true" data-ep-hint><span></span>Scroll</div>
    </div>
  </div>
</section>

<style>
  .ep {
    --ep-p: 0;
    position: relative;
    height: 320svh;
    background: var(--pa-bg, #0c0a06);
    color: #f4f1ea;
  }
  .ep-pin {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
  }
  .ep-stage {
    position: absolute;
    inset: 0;
  }
  .ep-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: calc(clamp(0, (var(--ep-p) - 0.56) / 0.2, 1) * 0.85);
    transform: scale(calc(1.12 - clamp(0, (var(--ep-p) - 0.55) / 0.45, 1) * 0.12));
  }
  .ep-scrim {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(70% 60% at 50% 50%, transparent 0%, rgb(12 10 6 / 0.55) 100%),
      linear-gradient(180deg, rgb(12 10 6 / 0.35), rgb(12 10 6 / 0.15) 40%, rgb(12 10 6 / 0.85));
  }
  .ep-grid {
    position: absolute;
    inset: 0;
    background-image: linear-gradient(90deg, rgb(255 255 255 / 0.06) 1px, transparent 1px);
    background-size: calc((100% - 1px) / 12) 100%;
    mask-image: linear-gradient(180deg, transparent, #000 25%, #000 75%, transparent);
    opacity: calc(1 - clamp(0, (var(--ep-p) - 0.5) / 0.3, 1));
  }
  /* El casco: un cuadrado centrado; JS lo mueve, escala y elige el fotograma. */
  .ep-casco {
    position: absolute;
    left: 50%;
    top: 50%;
    width: min(80svh, 50vw);
    aspect-ratio: 1;
    transform: translate(-50%, -50%) translate(calc(-25vw), 2svh);
    pointer-events: none;
    will-change: transform;
  }
  .ep-canvas,
  .ep-fallback {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .ep-canvas {
    opacity: 0;
  }
  :global(html.ep-on) .ep-canvas {
    opacity: 1;
  }
  :global(html.ep-on) .ep-fallback {
    visibility: hidden;
  }

  .ep-copy {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-end;
    text-align: right;
    /* sube el bloque para que no se pise con el velocímetro fijo (abajo a la derecha) */
    padding-bottom: clamp(140px, 24svh, 260px);
    pointer-events: none;
    opacity: calc(1 - clamp(0, (var(--ep-p) - 0.06) / 0.14, 1));
    transform: translateY(calc(clamp(0, (var(--ep-p) - 0.06) / 0.14, 1) * -6vh));
  }
  .ep-copy .pa-kick {
    margin-bottom: 18px;
  }
  .ep-title {
    margin: 0;
    font-family: var(--font-display, 'Geist Variable', system-ui, sans-serif);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: -0.045em;
    line-height: 0.86;
    font-size: min(15vw, 26svh);
  }
  .ep-bajada {
    margin: 0.5em 0 0;
    font-family: var(--font-mono, 'JetBrains Mono Variable', ui-monospace, monospace);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: clamp(12px, 0.7rem + 0.5vw, 18px);
    color: var(--pa-accent, #e8c874);
  }

  .ep-copy2 {
    position: absolute;
    left: 0;
    right: 0;
    bottom: clamp(48px, 10svh, 120px);
    pointer-events: none;
    opacity: clamp(0, (var(--ep-p) - 0.66) / 0.14, 1);
    transform: translateY(calc((1 - clamp(0, (var(--ep-p) - 0.66) / 0.14, 1)) * 4vh));
  }
  .ep-frase {
    margin: 0;
    max-width: 14ch;
    font-family: var(--font-display, 'Geist Variable', system-ui, sans-serif);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 0.98;
    font-size: clamp(2.4rem, 1rem + 5vw, 6rem);
  }
  .ep-ficha {
    margin: 1.1em 0 0;
    font-family: var(--font-mono, 'JetBrains Mono Variable', ui-monospace, monospace);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 12px;
    color: rgb(244 241 234 / 0.75);
  }

  .ep-scroll {
    position: absolute;
    left: 50%;
    bottom: 22px;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgb(244 241 234 / 0.7);
    opacity: calc(1 - clamp(0, var(--ep-p) / 0.08, 1));
  }
  .ep-scroll span {
    width: 1px;
    height: 34px;
    background: linear-gradient(var(--pa-accent, #e8c874), transparent);
  }

  @media (max-width: 720px) {
    .ep {
      height: 260svh;
    }
    .ep-copy {
      justify-content: flex-start;
      align-items: flex-start;
      text-align: left;
      padding-top: 16svh;
      padding-bottom: 0;
    }
    .ep-title {
      font-size: 19vw;
    }
    .ep-casco {
      width: 96vw;
      transform: translate(-50%, -50%) translate(0, 14svh);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ep {
      height: auto;
    }
    .ep-pin {
      position: relative;
      height: 100svh;
    }
    .ep-copy2 {
      opacity: 1;
      transform: none;
    }
    .ep-video {
      display: none;
    }
  }
</style>

<script>
  /* Secuencia de 72 fotogramas (giro de 360° cada 5°) pre-renderizada desde
     el modelo 3D con el trébol aplicado. El scroll elige el fotograma: el
     giro es fluido, liviano y no depende de WebGL en el navegador. */
  const root = document.querySelector<HTMLElement>('[data-ep]');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (root) {
    const casco = root.querySelector<HTMLElement>('[data-ep-casco]')!;
    const canvas = root.querySelector<HTMLCanvasElement>('[data-ep-canvas]')!;
    const ctx = canvas.getContext('2d')!;
    const video = root.querySelector<HTMLVideoElement>('[data-ep-video]');
    const N = 72;
    const base = root.dataset.frames || '/media/casco-gr360/';
    const lado = innerWidth <= 720 || (devicePixelRatio || 1) < 1.5 && innerWidth < 1200 ? 480 : 800;
    const frames: HTMLImageElement[] = [];
    const listo: boolean[] = [];
    const src = (i: number) => `${base}c${lado}-${String(i).padStart(2, '0')}.webp`;

    let p = 0, ps = 0, visible = true, actual = -1;
    let mx = 0, my = 0, tmx = 0, tmy = 0;

    const cargar = (i: number) => {
      if (frames[i]) return;
      const im = new Image();
      im.decoding = 'async';
      im.onload = () => { listo[i] = true; if (i === 0) document.documentElement.classList.add('ep-on'); pedir(); };
      im.src = src(i);
      frames[i] = im;
    };
    // Primero el fotograma inicial, después cada 6.º (vista previa del giro) y el resto.
    cargar(0);
    const orden: number[] = [];
    for (let i = 0; i < N; i += 6) orden.push(i);
    for (let i = 0; i < N; i++) if (i % 6) orden.push(i);
    let k = 0;
    const goteo = () => { for (let j = 0; j < 6 && k < orden.length; j++, k++) cargar(orden[k]); if (k < orden.length) setTimeout(goteo, 60); };
    setTimeout(goteo, 200);

    const smooth = (a: number, b: number, x: number) => {
      const t = Math.min(1, Math.max(0, (x - a) / (b - a)));
      return t * t * (3 - 2 * t);
    };
    const dibujar = (i: number) => {
      // usar el fotograma cargado más cercano
      let j = i;
      for (let d = 0; d < N && !listo[j]; d++) j = (i + (d % 2 ? -1 : 1) * Math.ceil(d / 2) + N) % N;
      if (!listo[j] || j === actual) return;
      actual = j;
      const w = canvas.clientWidth, h = canvas.clientHeight;
      const dpr = Math.min(devicePixelRatio || 1, 2);
      if (canvas.width !== Math.round(w * dpr)) { canvas.width = Math.round(w * dpr); canvas.height = Math.round(h * dpr); }
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      ctx.drawImage(frames[j], 0, 0, canvas.width, canvas.height);
    };

    const medir = () => {
      const b = root.getBoundingClientRect();
      const recorrido = b.height - innerHeight;
      p = recorrido > 0 ? Math.min(1, Math.max(0, -b.top / recorrido)) : 0;
      visible = b.bottom > 0 && b.top < innerHeight;
      root.style.setProperty('--ep-p', p.toFixed(4));
      if (video && !reduce) {
        const quiero = visible && p > 0.5;
        if (quiero && video.paused) video.play().catch(() => {});
        else if (!quiero && !video.paused) video.pause();
      }
      pedir();
    };

    let raf = 0;
    function pedir() { if (!raf) raf = requestAnimationFrame(cuadro); }
    function cuadro(t: number) {
      raf = 0;
      if (!visible) return;
      ps += (p - ps) * (reduce ? 1 : 0.14);
      mx += (tmx - mx) * 0.08;
      my += (tmy - my) * 0.08;
      const movil = innerWidth <= 720;
      // Giro completo de 360° a lo largo del pin.
      const giro = reduce ? 0 : smooth(0.02, 0.5, ps);
      dibujar(Math.round(giro * N) % N);
      // Recorrido: de un lado → centro → sube y se aleja mientras entra el video.
      const a = smooth(0.06, 0.4, ps);
      const b = smooth(0.42, 0.58, ps);
      const xIni = movil ? 0 : -26; // vw
      const x = xIni * (1 - a) + mx * 1.2;
      const y = (movil ? 14 : 2) * (1 - a) - b * 34 + Math.sin(t / 900) * 0.6 + my * 1; // svh
      const sIni = movil ? 1 : 1.06;
      const sc = (sIni + (0.9 - sIni) * a) * (1 - b * 0.55);
      const rz = Math.sin(ps * Math.PI) * 6 + mx * 2;
      casco.style.transform = `translate(-50%, -50%) translate(${x.toFixed(2)}vw, ${y.toFixed(2)}svh) scale(${sc.toFixed(4)}) rotate(${rz.toFixed(2)}deg)`;
      // Se desvanece ANTES de que entre el video (pedido 26/10).
      casco.style.opacity = String(1 - smooth(0.44, 0.56, ps));
      if (Math.abs(p - ps) > 0.0005 || Math.abs(tmx - mx) > 0.002 || Math.abs(tmy - my) > 0.002 || !reduce) {
        // mantener vivo mientras se acomoda (y el leve flote)
        if (Math.abs(p - ps) > 0.0005 || Math.abs(tmx - mx) > 0.002 || Math.abs(tmy - my) > 0.002) pedir();
      }
    }

    addEventListener('pointermove', (e) => {
      tmx = (e.clientX / innerWidth - 0.5) * 2;
      tmy = (e.clientY / innerHeight - 0.5) * 2;
      pedir();
    }, { passive: true });
    addEventListener('scroll', medir, { passive: true });
    addEventListener('resize', () => { actual = -1; medir(); });
    medir();
  }
</script>
