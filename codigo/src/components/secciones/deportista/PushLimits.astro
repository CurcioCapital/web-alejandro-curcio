---
/**
 * PushLimits.astro — «PUSHING THE LIMITS FOR BETTER», réplica del módulo de
 * cita de charlesleclerc.com (pedido 26/10/2026). Estudiado en su código:
 *
 *  · posterEnter: la imagen entra desde abajo (y: alto de pantalla → 0) y
 *    escala 1.2 → 1, con easing sine.inOut; el velo negro pasa 0 → 0.4.
 *  · quoteParallax: el texto va linealmente de x = ancho de pantalla a
 *    x = −ancho del texto (entra por la derecha, sale entero por la izq.).
 *  · El «tambaleo»: skewX del texto = velocidad del scroll suavizada,
 *    clamp(−vel, −15°, 15°), con vel = (destino − actual) × 0.05 y un
 *    seguimiento de dt × 10 por cuadro. Al frenar vuelve a 0.
 *  · Tipografía: condensada (Coign 87 en la referencia, de pago) a
 *    clamp(190px, 27.778vw, 500px). Acá: League Gothic al 75 % de ancho.
 *
 * Se monta encima del final de «En pista» (margen negativo + pin propio):
 * cuando el casco ya se desvaneció, el video del drift sube desde abajo —un
 * solo video, sin duplicados— y la frase cruza la pantalla.
 */
import '@fontsource-variable/league-gothic/wdth.css';

interface Props {
  texto: string;
}
const { texto } = Astro.props;
---

<section class="pl" data-pl aria-label={texto}>
  <div class="pl-pin">
    <!-- 11/11/2026: único sonido de Deportista: audio de TOYOTA DRIFT PARK2.MP4, arranca cuando entra este video (sonido.js). -->
    <div class="pl-poster" data-pl-poster data-ambient="/media/audio/drift-park-audio.m4a" data-ambient-vol="0.45" data-ambient-sticky>
      <video
        class="pl-video"
        src="/media/video/deportista-plate-loop.mp4"
        poster="/media/video/deportista-plate-poster.jpg"
        muted
        loop
        playsinline
        preload="metadata"
        aria-hidden="true"
        data-pl-video
      ></video>
      <span class="pl-overlay" data-pl-overlay aria-hidden="true"></span>
    </div>
    <div class="pl-track" aria-hidden="true">
      <p class="pl-text" data-pl-text>{texto}</p>
    </div>
  </div>
</section>

<style>
  .pl {
    position: relative;
    z-index: 1;
    /* Se superpone a los últimos tramos de «En pista» (ver JS). */
    margin-top: -220svh;
    height: 600svh; /* JS lo ajusta al largo real de la frase */
    pointer-events: none;
  }
  .pl-pin {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
  }
  .pl-poster {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: #0c0a06;
    transform: translate3d(0, 100%, 0);
    will-change: transform;
  }
  .pl-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform-origin: top left;
    transform: scale(1.2);
    filter: saturate(0.7) contrast(1.06);
    will-change: transform;
  }
  .pl-overlay {
    position: absolute;
    inset: 0;
    background: #000;
    opacity: 0;
  }
  .pl-track {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
  }
  .pl-text {
    margin: 0;
    white-space: nowrap;
    font-family: 'League Gothic Variable', 'League Gothic', 'Arial Narrow', sans-serif;
    font-stretch: 75%;
    font-weight: 400;
    font-size: clamp(190px, 27.778vw, 500px);
    line-height: 1.5;
    text-transform: uppercase;
    color: #f1f1f1;
    will-change: transform;
    transform: translate3d(100vw, 0, 0);
  }

  /* «En pista» mide 260svh en teléfono: el casco se va a los ~75svh. */
  @media (max-width: 720px) {
    .pl {
      margin-top: -185svh;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pl {
      margin-top: 0;
      height: auto;
    }
    .pl-pin {
      position: relative;
    }
    .pl-poster,
    .pl-video {
      transform: none;
    }
    .pl-overlay {
      opacity: 0.4;
    }
    .pl-text {
      white-space: normal;
      font-size: clamp(72px, 14vw, 220px);
      line-height: 0.95;
      transform: none;
      padding: 0 24px;
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-pl]');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (root && !reduce) {
    const text = root.querySelector<HTMLElement>('[data-pl-text]')!;
    const poster = root.querySelector<HTMLElement>('[data-pl-poster]')!;
    const video = root.querySelector<HTMLVideoElement>('[data-pl-video]')!;
    const overlay = root.querySelector<HTMLElement>('[data-pl-overlay]')!;

    let enterLen = 0, textLen = 0, textW = 0;
    let target = 0, current = 0, skew = 0, last = 0, raf = 0, running = false;

    const sine = (x: number) => -(Math.cos(Math.PI * Math.min(1, Math.max(0, x))) - 1) / 2;

    const layout = () => {
      const vh = innerHeight;
      textW = text.scrollWidth;
      enterLen = vh * 0.75;                 // el video sube desde abajo
      textLen = textW + innerWidth;        // 1 px de scroll = 1 px de texto
      const total = enterLen * 0.5 + textLen;
      root.style.height = `${Math.round(total + vh)}px`;
      leer();
    };
    // Cuánto se scrolleó desde que el pin quedó fijo (puede ser negativo).
    const leer = () => {
      target = -root.getBoundingClientRect().top;
      if (!running) { running = true; last = performance.now(); raf = requestAnimationFrame(frame); }
    };
    function frame(now: number) {
      const dt = Math.min((now - last) / 1000, 1 / 30);
      last = now;
      const diff = target - current;
      current += Math.abs(diff) > 0.05 ? diff * Math.min(1, dt * 9) : diff;
      // tambaleo: velocidad del scroll → skewX, como la referencia
      const vel = diff * 0.05;
      const sk = Math.max(-15, Math.min(15, -vel));
      skew += (sk - skew) * dt * 10;

      const s = current;
      const vh = innerHeight;
      // entrada del video (sine.inOut): de abajo, 1.2 → 1, velo 0 → 0.4
      const e = sine(s / enterLen);
      poster.style.transform = `translate3d(0, ${((1 - e) * vh).toFixed(1)}px, 0)`;
      video.style.transform = `scale(${(1.2 - 0.2 * e).toFixed(4)})`;
      overlay.style.opacity = (0.4 * e).toFixed(3);
      // la frase: arranca a mitad de la entrada del video
      const t = Math.min(1, Math.max(0, (s - enterLen * 0.5) / textLen));
      const x = innerWidth - t * textLen;
      text.style.transform = `translate3d(${x.toFixed(1)}px,0,0) skewX(${skew.toFixed(3)}deg)`;

      const vis = s > -vh && s < root.offsetHeight;
      if (vis && e > 0.01) { if (video.paused) video.play().catch(() => {}); }
      else if (!video.paused) video.pause();

      if (Math.abs(target - current) > 0.05 || Math.abs(skew) > 0.01 || Math.abs(sk - skew) > 0.01) {
        raf = requestAnimationFrame(frame);
      } else running = false;
    }
    addEventListener('scroll', leer, { passive: true });
    addEventListener('resize', layout);
    document.fonts?.ready.then(layout);
    layout();
  }
</script>
