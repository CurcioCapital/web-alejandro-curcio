---
/**
 * QuienEs.astro — bloque de presentación, entre las facetas y los libros.
 *
 * Pedido de Dolores (27/09/2026): «después de las facetas, algo como quién
 * es Alejandro Curcio, una breve descripción, y después lo de los libros».
 *
 * Todo el texto sale de 05 — Hechos verificados.md. Nada acá se estima.
 *
 * Tratamiento 21/10/2026: la lámina pasa de negro a hueso al entrar (el
 * color se interpola con el scroll), el nombre va en display gigante y el
 * texto se ilumina palabra por palabra a medida que se lo recorre. El
 * retrato entra con máscara y tiene parallax. Sin JS (o con reduced motion)
 * se ve la lámina hueso con todo el texto encendido.
 */
import BlurImage from '../../BlurImage.astro';
---

<section id="quien-es" class="qe" data-qe>
  <div class="wrap">
    <div class="qe-top">
      <span class="qe-kicker">Quién es</span>
      <span class="qe-rule" aria-hidden="true"></span>
      <span class="qe-num" aria-hidden="true">[ 02 ]</span>
    </div>
    <h2 class="qe-title" data-split="chars">Alejandro Curcio</h2>

    <div class="qe-grid">
      <div class="qe-media u-crop" data-reveal="mask">
        <div class="qe-media-in" data-qe-par>
          <BlurImage id="retrato-estudio" kind="img" alt="Retrato de estudio de Alejandro Curcio" />
        </div>
      </div>

      <div class="qe-copy">
        <p class="qe-lead" data-qe-words>
          Presidente de <strong>Ayax S.A.</strong> —importador oficial de Toyota y Suzuki en Uruguay,
          la empresa familiar que su padre fundó en enero de 1945— y de <strong>Curcio Capital</strong>,
          su firma de inversión en tecnología, biotecnología y real estate.
        </p>
        <p class="qe-p" data-qe-words>
Escribió tres libros. Ganó un Cannes Lions con The HY Project. Es piloto de drift y jefe de equipo de Toyota Gazoo Racing en el Superturismo. Y pone la misma energía en lo que devuelve a la comunidad: un récord Guinness a beneficio de Centro Horizonte, tres récords consecutivos de recaudación para la Teletón y 20 casas en un día junto a TECHO.
</p> <p class="qe-p qe-family" data-qe-words>
Y, antes que todo, es el padre de Lucca, Camila y Paulina.
</p>
      </div>
    </div>
  </div>
</section>

<style>
  .qe {
    /* --qe-t: 0 = negro (sale de las facetas), 1 = hueso. Sin JS vale 1. */
    --qe-t: 1;
    --qe-bone: var(--color-off, #f4f1ea);
    --qe-dark: var(--color-cap-2, #0a0805);
    --qe-ink: var(--color-ink, #0b0e17);
    --qe-mono: var(--font-mono, 'JetBrains Mono Variable', ui-monospace, Menlo, monospace);
    --qe-display: var(--font-display, 'Geist Variable', system-ui, sans-serif);
    position: relative;
    padding: clamp(72px, 10vw, 160px) 0 clamp(96px, 12vw, 200px);
    background-color: color-mix(in srgb, var(--qe-bone) calc(var(--qe-t) * 100%), var(--qe-dark));
    color: color-mix(in srgb, var(--qe-ink) calc(var(--qe-t) * 100%), var(--qe-bone));
    background-image:
      linear-gradient(90deg, rgb(11 14 23 / calc(var(--qe-t) * 0.06)) 1px, transparent 1px);
    background-size: calc((100% - 1px) / 12) 100%;
  }

  .qe-top {
    display: flex;
    align-items: center;
    gap: 16px;
    font-family: var(--qe-mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .qe-kicker {
    color: color-mix(in srgb, var(--accent-ink, #7a5c10) calc(var(--qe-t) * 100%), var(--accent, #e8c874));
  }
  .qe-rule {
    flex: 1;
    height: 1px;
    background: currentColor;
    opacity: 0.18;
  }
  .qe-num {
    opacity: 0.6;
  }
  .qe-title {
    font-family: var(--qe-display);
    font-weight: 600;
    font-size: clamp(3rem, 0.6rem + 10vw, 11rem);
    letter-spacing: -0.045em;
    line-height: 0.95;
    margin: clamp(18px, 2vw, 32px) 0 clamp(40px, 5vw, 80px);
    color: inherit;
  }

  .qe-grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(32px, 5vw, 96px);
    align-items: start;
  }
  .qe-media {
    position: relative;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-lg, 28px);
    overflow: hidden;
    background: #d9d4c8;
  }
  .qe-media-in {
    position: absolute;
    inset: -8% 0;
    will-change: transform;
  }
  .qe-media :global(picture) {
    position: absolute;
    inset: 0;
  }
  .qe-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 22%;
  }

  .qe-lead {
    font-size: clamp(1.45rem, 1rem + 1.6vw, 2.6rem);
    font-weight: 500;
    line-height: 1.18;
    letter-spacing: -0.02em;
    margin: 0;
    max-width: 26ch;
    text-wrap: pretty;
  }
  .qe-lead strong {
    font-weight: 750;
  }
  .qe-p {
    font-size: clamp(1.05rem, 0.95rem + 0.4vw, 1.3rem);
    line-height: 1.5;
    margin: clamp(24px, 3vw, 40px) 0 0;
    max-width: 44ch;
  }

  /* Palabras: apagadas hasta que el scroll las enciende. Sólo con JS. */
  :global(html.qe-on) .qe :global(.qe-w) {
    opacity: 0.16;
    transition: opacity 220ms linear;
  }
  :global(html.qe-on) .qe :global(.qe-w.is-on) {
    opacity: 1;
  }

  .qe-pill {
    margin-top: clamp(32px, 4vw, 56px);
    background: var(--qe-ink);
    color: var(--qe-bone);
  }
  .qe-pill:hover {
    background: var(--color-cobalt, #7a5c10);
    color: #fff;
  }

  @media (max-width: 860px) {
    .qe-grid {
      grid-template-columns: 1fr;
    }
    .qe-media {
      aspect-ratio: 4 / 4.4;
    }
  }
</style>

<script>
  const raiz = document.querySelector<HTMLElement>('[data-qe]');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (raiz && !reduce) {
    // Envolver cada palabra en un span, sin tocar el texto. Un elemento con
    // data-counter cuenta como una sola palabra (su texto lo reescribe otro).
    const palabras: HTMLElement[] = [];
    const envolver = (nodo: Node) => {
      Array.from(nodo.childNodes).forEach((n) => {
        if (n.nodeType === 3) {
          const partes = (n.textContent || '').split(/(\s+)/);
          const frag = document.createDocumentFragment();
          partes.forEach((t) => {
            if (!t) return;
            if (/^\s+$/.test(t)) frag.appendChild(document.createTextNode(t));
            else {
              const s = document.createElement('span');
              s.className = 'qe-w';
              s.textContent = t;
              frag.appendChild(s);
              palabras.push(s);
            }
          });
          n.parentNode!.replaceChild(frag, n);
        } else if (n.nodeType === 1) {
          const el = n as HTMLElement;
          if (el.hasAttribute('data-counter')) {
            el.classList.add('qe-w');
            palabras.push(el);
          } else envolver(el);
        }
      });
    };
    const bloques = Array.from(raiz.querySelectorAll<HTMLElement>('[data-qe-words]'));
    bloques.forEach(envolver);
    document.documentElement.classList.add('qe-on');

    const par = raiz.querySelector<HTMLElement>('[data-qe-par]');
    const primero = bloques[0];
    const ultimo = bloques[bloques.length - 1];

    let raf = 0;
    const pintar = () => {
      raf = 0;
      const vh = innerHeight;
      const r = raiz.getBoundingClientRect();
      if (r.bottom < -100 || r.top > vh + 100) return;

      // Fondo: negro → hueso en la primera parte de la entrada.
      const t = Math.min(1, Math.max(0, (vh - r.top) / (vh * 0.55)));
      raiz.style.setProperty('--qe-t', t.toFixed(3));

      // Palabras: se encienden entre que el texto entra a 85% y su fin a 55%.
      if (primero && ultimo) {
        const a = primero.getBoundingClientRect().top;
        const b = ultimo.getBoundingClientRect().bottom;
        const ini = vh * 0.85;
        const fin = vh * 0.5;
        const total = b - a + (ini - fin);
        const p = Math.min(1, Math.max(0, (ini - a) / (total || 1)));
        const n = Math.round(p * palabras.length);
        palabras.forEach((w, i) => w.classList.toggle('is-on', i < n));
      }

      if (par) {
        const c = (r.top + r.height / 2 - vh / 2) / vh;
        par.style.transform = `translate3d(0, ${(c * -60).toFixed(1)}px, 0)`;
      }
    };
    const pedir = () => {
      if (!raf) raf = requestAnimationFrame(pintar);
    };
    addEventListener('scroll', pedir, { passive: true });
    addEventListener('resize', pedir);
    pintar();
  }
</script>
