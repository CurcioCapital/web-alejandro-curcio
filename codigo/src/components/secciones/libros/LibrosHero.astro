---
/**
 * LibrosHero.astro — sólo para /libros. Hero tipográfico: no existe un
 * asset propio de la sección, así que el titular ES la pieza.
 *
 * Rediseño 21/10/2026 (dirección landonorris): display condensado enorme,
 * una palabra por línea, etiquetas mono, grilla técnica y los tres pasos
 * como tabla de datos al pie. Mismo texto, mismo orden que antes:
 * kicker → título → bajada → CTA → los tres pasos.
 *
 * Historia de la versión anterior (31/08/2026): el contenido va en FLUJO
 * normal, no absoluto —así nada se corta—, el fondo sale de los tokens
 * cálidos y no hay palabras fantasma de fondo.
 */
interface Props {
  ctaHref?: string;
  ctaLabel?: string;
}

const { ctaHref = '#arco', ctaLabel = 'Ver el arco' } = Astro.props;

const pasos = [
  { n: '2018', paso: 'Adentro', libro: 'Capital de Vida' },
  { n: '2023', paso: 'Afuera', libro: 'Toolbook' },
  { n: '2026', paso: 'Método', libro: 'CEO DE TU VIDA' },
];
---

<section class="lh ed-grid">
  <div class="lh-glow" aria-hidden="true"></div>
  <!-- 12/11/2026: abre con el video de la faceta Pensador (mismo fragmento de Toolbook, con sonido). -->
  <div class="lh-vid"><video data-audio="auto" src="/media/video/toolbook-pensador-card.mp4" poster="/media/video/toolbook-pensador-card-poster.jpg" muted loop autoplay playsinline preload="metadata" aria-label="Alejandro Curcio en la presentación de Toolbook"></video></div>
  <div class="ed-wrap lh-inner">
    <div class="lh-top ed-mono">
      <span class="lh-kicker">{'— '}Pensador</span>
      <span class="lh-idx" aria-hidden="true">[ 00 ]</span>
    </div>

    <!-- 12/11/2026: sin bajada, botón ni los tres pasos (se repetían con el arco de abajo); titular propio de la sección. -->
    <div class="lh-main lh-main--solo">
      <h1 class="ed-display lh-title lh-title--solo" data-split="lines">Ideas que van<br />más lejos.</h1>
      <!-- 13/11/2026: discurso completo de Toolbook en ventana (pedido de Emi). -->
      <button type="button" class="vp-open lh-full" data-vp-open data-src="/media/video/toolbook-discurso.mp4" data-src-m="/media/video/toolbook-discurso-m.mp4" data-poster="/media/video/toolbook-discurso-poster.jpg" data-ratio="9/16" data-title="Toolbook · discurso completo"><span class="vp-play-ico" aria-hidden="true"><svg viewBox="0 0 24 24" width="12" height="12"><path d="M7 5v14l12-7z" fill="currentColor"/></svg></span><span>Ver el discurso completo</span></button>
      <link rel="stylesheet" href="/estilos/reproductor.css?v=1" is:inline />
      <style is:inline>.lh-full{margin-top:clamp(22px,3.4vh,40px);pointer-events:auto;justify-self:start;width:fit-content}</style>
      <script is:inline src="/scripts/reproductor.js?v=1" defer></script>
    </div>
  </div>
</section>

<style>
  .lh {
    position: relative;
    isolation: isolate;
    overflow: clip;
    background: var(--ed-bg);
    color: rgb(255 255 255 / 0.94);
    min-height: min(100svh, 1000px);
    display: flex;
  }
  .lh-glow {
    position: absolute;
    inset: -20% -10% auto auto;
    width: 70vw;
    height: 70vw;
    z-index: -1;
    background: radial-gradient(closest-side, rgb(232 200 116 / 0.14), transparent 70%);
    pointer-events: none;
  }
  .lh-inner {
    width: 100%;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: clamp(28px, 4vw, 56px);
    padding-top: clamp(120px, 16vh, 180px);
    padding-bottom: clamp(40px, 6vh, 72px);
  }
  .lh-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--ed-line-strong);
    padding-bottom: 14px;
  }
  .lh-kicker {
    color: var(--ed-accent);
    font: inherit;
    letter-spacing: inherit;
    margin: 0;
  }
  .lh-idx {
    color: rgb(255 255 255 / 0.4);
  }
  .lh-main {
    display: grid;
    grid-template-columns: auto minmax(300px, 1fr);
    gap: clamp(28px, 4vw, 72px);
    align-items: end;
  }
  .lh-title {
    font-size: clamp(3.5rem, min(11.5vw, 19svh), 13rem);
    line-height: 0.94;
    letter-spacing: -0.05em;
    font-weight: 540;
    max-width: 9ch;
  }
  .lh-foot {
    display: flex;
    flex-direction: column;
    gap: clamp(28px, 4vw, 48px);
    padding-bottom: 0.4em;
  }
  .lh-lead {
    font-size: clamp(1.125rem, 1rem + 0.55vw, 1.5rem);
    line-height: 1.45;
    color: rgb(255 255 255 / 0.72);
    margin: 0 0 28px;
    max-width: 30ch;
  }
  .lh-pasos {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--ed-line-strong);
  }
  .lh-pasos li {
    position: relative;
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 6px 18px;
    padding: 14px 0;
    border-bottom: 1px solid var(--ed-line-strong);
    transition-delay: calc(var(--i, 0) * 90ms);
  }
  .lh-pasos li::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 1px;
    background: var(--ed-accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.8s var(--ed-expo);
  }
  .lh-pasos li:hover::before {
    transform: scaleX(1);
  }
  .lh-n {
    color: var(--ed-accent);
  }
  .lh-paso {
    font-family: var(--ed-display);
    font-weight: 560;
    font-size: clamp(1.375rem, 1.1rem + 0.9vw, 2rem);
    line-height: 1;
    letter-spacing: -0.03em;
  }
  .lh-libro {
    color: rgb(255 255 255 / 0.55);
    text-align: right;
  }
  .lh-scroll {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: rgb(255 255 255 / 0.45);
  }
  .lh-scroll i {
    display: block;
    width: 1px;
    height: 28px;
    background: linear-gradient(var(--ed-accent), transparent);
    animation: lh-drip 2.2s var(--ed-quart) infinite;
    transform-origin: top;
  }
  @keyframes lh-drip {
    0% { transform: scaleY(0); }
    50% { transform: scaleY(1); }
    100% { transform: scaleY(1); opacity: 0; }
  }
  @media (min-width: 1101px) and (max-width: 1500px) {
    .lh-pasos li {
      grid-template-columns: 52px minmax(0, 1fr);
    }
    .lh-libro {
      grid-column: 2;
      text-align: left;
    }
  }
  @media (max-width: 1100px) {
    .lh-main {
      grid-template-columns: 1fr;
    }
    .lh-title {
      font-size: clamp(3.25rem, 15vw, 13rem);
    }
  }
  @media (max-width: 860px) {
    .lh-pasos li {
      grid-template-columns: 56px minmax(0, 1fr);
    }
    .lh-libro {
      grid-column: 2;
      text-align: left;
    }
    .lh-scroll {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .lh-scroll i {
      animation: none;
    }
    .lh-pasos li::before {
      transition: none;
    }
  }
  /* 12/11/2026: video de apertura */
  .lh-main--solo{grid-template-columns:1fr!important}.lh-title--solo{max-width:none!important}@media (min-width:861px){.lh-title--solo{font-size:clamp(3.5rem,min(7vw,14svh),9.5rem)!important;line-height:.96!important}.lh-title--solo{white-space:nowrap}.lh:has(.lh-main--solo) .lh-top{max-width:min(46%,760px)}.lh:has(.lh-main--solo) .lh-idx{display:none}.lh:has(.lh-main--solo) .lh-inner{justify-content:center;padding-top:clamp(40px,6vh,72px)}.lh:has(.lh-main--solo) .lh-scroll{position:absolute;left:clamp(20px,4vw,56px);bottom:clamp(24px,4vh,48px)}}@media (max-width:860px){.lh:has(.lh-main--solo){min-height:calc(100svh - 110px)!important}.lh-title--solo{font-size:clamp(2.75rem,12.5vw,6rem)!important}}.lh-vid{position:absolute;z-index:-1;top:0;bottom:0;right:clamp(0px,8vw,160px);height:100%;aspect-ratio:9/16;max-width:62vw;pointer-events:none}.lh-vid video{display:block;width:100%;height:100%;object-fit:cover}.lh-vid::after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,var(--ed-bg,#0c0a06) 0%,rgba(12,10,6,0) 24%,rgba(12,10,6,0) 76%,var(--ed-bg,#0c0a06) 100%),linear-gradient(0deg,var(--ed-bg,#0c0a06) 0%,rgba(12,10,6,.55) 22%,rgba(12,10,6,0) 48%),linear-gradient(180deg,rgba(12,10,6,.6) 0%,rgba(12,10,6,0) 22%)}@media (max-width:860px){.lh-vid{right:0;left:0;transform:none;width:100%;max-width:none;aspect-ratio:auto}.lh-vid::after{background:linear-gradient(0deg,var(--ed-bg,#0c0a06) 0%,rgba(12,10,6,.72) 40%,rgba(12,10,6,.25) 70%,rgba(12,10,6,.55) 100%)}}
  /* 12/11/2026: menos negro entre el hero y el arco */
  :global(#arco.libros-arco){padding-top:clamp(12px,1.5vw,24px)!important}
  :global(#arco .arco){margin-top:0!important}
</style>
