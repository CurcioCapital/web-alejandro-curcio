---
/** 17/11/2026: página 404 propia (SEO, pedido de Emi). Vercel la sirve con estado 404 para cualquier URL inexistente. */
import Base from '../layouts/Base.astro';
---
<Base title="Página no encontrada — Alejandro Curcio" description="Esta página no existe. Volvé al inicio del sitio oficial de Alejandro Curcio.">
<!-- El marcado y los estilos son los mismos que web/404.html (bloque .nf). -->
<section class="nf" aria-labelledby="nf-t"><style is:inline>.nf{min-height:calc(100svh - 112px);display:grid;place-items:center;padding:clamp(40px,8vh,96px) 20px;background:#0c0a06;text-align:center}.nf-in{display:flex;flex-direction:column;align-items:center;gap:clamp(18px,3vh,28px)}.nf-k{font-family:var(--font-mono,ui-monospace,monospace);font-size:12px;letter-spacing:.16em;text-transform:uppercase;color:#e8c874}.nf h1{margin:0;font-family:var(--font-display,inherit);font-weight:var(--display-wght,560);font-size:clamp(48px,8vw,140px);line-height:.92;letter-spacing:-.05em;color:#fff}.nf p{margin:0;max-width:34ch;color:rgb(244 241 234/.72);font-size:clamp(16px,1.3vw,19px);line-height:1.5}.nf-btn{display:inline-flex;align-items:center;gap:10px;min-height:44px;padding:0 22px;border-radius:999px;background:#e8c874;color:#0c0a06;font-weight:600;text-decoration:none;transition:transform .3s cubic-bezier(.2,.7,.2,1)}.nf-btn:hover{transform:translateY(-2px)}.nf-links{display:flex;flex-wrap:wrap;justify-content:center;gap:8px 22px;font-family:var(--font-mono,ui-monospace,monospace);font-size:12px;letter-spacing:.12em;text-transform:uppercase}.nf-links a{color:rgb(244 241 234/.8);text-decoration:none;min-height:44px;display:inline-flex;align-items:center}.nf-links a:hover{color:#e8c874}</style><div class="nf-in"><span class="nf-k">Error 404</span><h1 id="nf-t">Esta página no existe.</h1><p>Puede que el enlace esté mal escrito o que la página se haya movido.</p><a class="nf-btn" href="/">Volver al inicio <span aria-hidden="true">→</span></a><nav class="nf-links" aria-label="Secciones"><a href="/libros/">Libros</a><a href="/ceo-de-tu-vida/">CEO DE TU VIDA</a><a href="/prensa/">Prensa</a><a href="/preguntale/">Preguntale a Ale</a></nav></div></section>
</Base>
