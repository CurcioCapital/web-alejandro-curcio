---
/**
 * aventura.astro — Aventurero: sólo la subida al Monte Fuji (ruta Gotemba).
 * El récord Guinness se migró tal cual a /solidario. Copy: sitio-copy/
 * aventura.md (bloque Fuji y cita Pilar "El Negocio").
 */
import Base from '../layouts/Base.astro';
import BlurImage from '../components/BlurImage.astro';


import AventuraQuote from '../components/secciones/aventura/AventuraQuote.astro';
import '../components/secciones/historia/pa-kit.css';

---

<Base
	title="Aventura — Alejandro Curcio"
	description="Monte Fuji, Japón: una subida compartida entre generaciones. La montaña y los negocios tienen mucho en común."
>
<div class="pa pa--av">
	<!-- HERO: composición editorial. La foto propia de la subida (vertical)
	     va entera en un marco a la derecha — sin degradés sobre las caras — y
	     la copia a la izquierda, sobre un «FUJI» en contorno de fondo. -->
	<section class="avf">
		<video class="avf-vid" data-audio="auto" autoplay muted loop playsinline preload="auto" poster="/media/video/fuji-hero-poster.jpg" aria-hidden="true" tabindex="-1"><source src="/media/video/fuji-hero-720.mp4" type="video/mp4" media="(max-width: 860px)"><source src="/media/video/fuji-hero.mp4" type="video/mp4"></video><span class="avf-veil" aria-hidden="true"></span>
		<span class="avf-word" aria-hidden="true" data-parallax="-0.12">FUJI</span>
		<span class="avf-glow" aria-hidden="true"></span>
		<div class="wrap avf-grid">
			<div class="avf-copy">
				<p class="pa-kick"><span class="pa-idx">[ 01 ]</span>Aventurero</p>
				<h1 class="avf-title pa-display" data-split="lines">La montaña y los negocios tienen mucho en común.</h1>
				<p class="avf-ficha pa-mono" data-reveal>
					Monte Fuji <span aria-hidden="true">·</span> Japón
					<span aria-hidden="true">·</span> Ruta Gotemba
				</p>
			</div>
			<figure class="avf-photo">
				<div class="avf-frame" data-reveal="mask">
					<div class="avf-frame-in" data-parallax="0.08">
						<BlurImage id="fuji-referencia" alt="Selfie grupal al pie del torii de la ruta Gotemba del Monte Fuji: Alejandro Curcio con sombrero de cuero y Lucca Curcio, durante la subida compartida" width={1280} sizes="(max-width: 760px) 92vw, 34vw" eager style="object-position:50% 78%" />
					</div>
				</div>
				<figcaption class="avf-cap pa-mono"><span>Entrada Gotemba, 御殿場口</span><span>La subida compartida</span></figcaption>
			</figure>
		</div>
	</section>

	<div class="section-gap"></div>

	<!-- MONTE FUJI -->
	<section id="fuji" class="pa-cap pa-cap--bone pa-grid">
		<div class="wrap">
			<header class="pa-cap-head">
				<p class="pa-kick"><span class="pa-idx">[ 02 ]</span>Monte Fuji · Japón</p>
				<h2 class="pa-display pa-cap-title" data-split="lines">Subir con los que importan.</h2>
			</header>

			<div class="kite-body">
				<p class="aventura-para aventura-para--big" data-reveal>
					Una subida compartida entre generaciones y entre un vínculo solidario que trasciende lo
					deportivo. La misma ruta que conecta a Alejandro con Japón y con el Kaizen — la filosofía
					de mejora continua que AYAX heredó de casi seis décadas de relación con Toyota.
				</p>

				<AventuraQuote
					quote="La montaña y los negocios tienen mucho en común: ambos exigen planificación, resiliencia y la humildad de saber que siempre hay variables fuera de tu control. El liderazgo se forja en la incertidumbre."
					attribution={'Alejandro Curcio — Pilar "El Negocio"'}
				/>
			</div>
		</div>
	</section>

<!-- 12/11/2026: Japón a pie, galería sin textos (pedido de Emi). Video a = edición de «WhatsApp Video 12.09.17» (estabilizado, color, 3 tramos en cámara lenta, sin audio). Video c = «WhatsApp Video 12.09.21» (peregrinación, con audio). -->
<section id="japon-a-pie" class="ajp" aria-label="Fotos y videos del viaje a Japón">
<style is:inline>#fuji .kite-body{max-width:none!important;margin:0!important;grid-template-columns:minmax(0,1fr) minmax(0,1.25fr);gap:clamp(32px,5vw,88px)!important;align-items:start}#fuji .kite-body>*{margin-top:0!important}#fuji .kite-body .aventura-para{font-size:clamp(19px,1rem + .55vw,26px)!important;line-height:1.5!important;max-width:none!important}.ajp{background:#0c0a06;padding:clamp(56px,7vw,110px) clamp(12px,3vw,40px) clamp(72px,8vw,130px)}.ajp-bento{list-style:none;margin:0 auto;padding:0;max-width:1680px;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));grid-template-rows:1fr 1fr;grid-template-areas:"a b c d" "a e c d";gap:clamp(8px,1vw,16px)}.ajp-it{position:relative;margin:0;border-radius:clamp(14px,1.4vw,22px);overflow:hidden;background:#1a160f;min-height:0}.ajp-it--a{grid-area:a;aspect-ratio:9/16}.ajp-it--b{grid-area:b}.ajp-it--c{grid-area:c}.ajp-it--d{grid-area:d}.ajp-it--e{grid-area:e}.ajp-it video,.ajp-it picture,.ajp-it img{position:absolute;inset:0;display:block;width:100%;height:100%;object-fit:cover;transition:transform 1.2s cubic-bezier(.16,1,.3,1)}.ajp-it:hover video,.ajp-it:hover img{transform:scale(1.035)}@media (max-width:860px){#fuji .kite-body{grid-template-columns:1fr}.ajp-bento{grid-template-columns:repeat(2,minmax(0,1fr));grid-template-rows:1fr 1fr auto;grid-template-areas:"a b" "a e" "c d"}.ajp-it--c,.ajp-it--d{aspect-ratio:9/16}}</style>
<ul class="ajp-bento">
<li class="ajp-it ajp-it--a"><video src="/media/video/fuji-subida.mp4" poster="/media/video/fuji-subida-poster.jpg" muted loop autoplay playsinline preload="metadata" aria-label="Subida por la arena volcánica del Monte Fuji, entre nubes"></video></li>
<li class="ajp-it ajp-it--b"><picture><source type="image/webp" srcset="/media/img/fuji-subida/noche-900.webp"><img src="/media/img/fuji-subida/noche-900.jpg" style="object-position:50% 62%" loading="lazy" decoding="async" alt="Alejandro Curcio y su compañero descansan de noche en la ladera del Monte Fuji, con las luces del valle abajo"></picture></li>
<li class="ajp-it ajp-it--c"><video data-audio="auto" src="/media/video/japon-peregrinacion.mp4" poster="/media/video/japon-peregrinacion-poster.jpg" muted loop autoplay playsinline preload="metadata" aria-label="Alejandro Curcio recorre un camino de peregrinación milenario en Japón"></video></li>
<li class="ajp-it ajp-it--d"><picture><source type="image/webp" srcset="/media/img/fuji-subida/peregrino-900.webp"><img src="/media/img/fuji-subida/peregrino-900.jpg" loading="lazy" decoding="async" alt="Alejandro Curcio sonriente junto a un guía japonés con sombrero de paja, en una ruta de montaña"></picture></li>
<li class="ajp-it ajp-it--e"><picture><source type="image/webp" srcset="/media/img/fuji-subida/niebla-900.webp"><img src="/media/img/fuji-subida/niebla-900.jpg" style="object-position:55% 70%" loading="lazy" decoding="async" alt="Alejandro Curcio de sombrero frente a dos compañeros en la arena negra del Fuji cubierta de niebla"></picture></li>
</ul>
</section>

</div>
</Base>

<style is:inline>.avf{background:#05070b!important}.avf-vid{position:absolute;inset:0;z-index:-2;width:100%;height:100%;object-fit:cover;object-position:62% 50%}.avf-veil{position:absolute;inset:0;z-index:-1;pointer-events:none;background:linear-gradient(90deg,rgb(5 7 11/.72) 0%,rgb(5 7 11/.38) 38%,rgb(5 7 11/0) 62%),linear-gradient(0deg,rgb(5 7 11/.55) 0%,rgb(5 7 11/0) 30%)}.avf .avf-word,.avf .avf-glow,.avf .avf-photo{display:none!important}.avf .avf-grid{grid-template-columns:1fr!important;align-items:end}.avf{min-height:calc(100svh - 115px)!important;align-items:flex-end!important;padding-bottom:clamp(40px,7vh,80px)!important}@media (max-width:860px){.avf{min-height:88svh!important;padding:0 0 48px!important}.avf-vid{object-position:58% 50%}.avf-veil{background:linear-gradient(0deg,rgb(5 7 11/.8) 0%,rgb(5 7 11/.25) 55%,rgb(5 7 11/.1) 100%)}}</style>
<style>
	/* ---- hero ---- */
	.av-plate {
		--p: 0;
		position: relative;
		margin: 0;
		min-height: var(--pa-hero-h);
		display: flex;
		align-items: flex-end;
		overflow: hidden;
		background: var(--pa-bg-2);
		isolation: isolate;
	}
	.av-plate-media {
		position: absolute;
		inset: -8% 0;
		z-index: -2;
	}
	.av-plate-video {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 50% 42%;
	}
	.av-plate-scrim {
		position: absolute;
		inset: 0;
		z-index: -1;
		background:
			linear-gradient(0deg, rgba(8, 7, 5, 0.95) 0%, rgba(8, 7, 5, 0.5) 38%, rgba(8, 7, 5, 0.05) 70%, rgba(8, 7, 5, 0.35) 100%),
			linear-gradient(90deg, rgba(8, 7, 5, 0.6) 0%, transparent 58%);
	}
	.av-plate-copy {
		width: 100%;
		padding-bottom: clamp(48px, 7vh, 88px);
		display: grid;
		gap: clamp(18px, 2.4vw, 30px);
	}
	.av-plate-title {
		font-size: clamp(42px, min(7.8vw, 14vh), 156px);
		line-height: 0.98;
		letter-spacing: -0.045em;
		color: #fff;
	}
	.av-plate-ficha {
		margin: 0;
		color: rgba(255, 255, 255, 0.78);
	}
	.av-plate-ficha span {
		color: var(--pa-accent);
		margin: 0 10px;
	}
	.av-cue {
		position: absolute;
		right: var(--pa-pad-x);
		bottom: clamp(48px, 7vh, 88px);
		color: rgb(255 255 255 / 0.6);
	}

	/* ---- hero Fuji (editorial) ---- */
	.avf {
		position: relative;
		overflow: hidden;
		isolation: isolate;
		background: var(--pa-bg-2);
		min-height: var(--pa-hero-h);
		display: flex;
		align-items: center;
		padding: clamp(40px, 7vh, 80px) 0;
	}
	.avf-word {
		position: absolute;
		z-index: -1;
		left: -1vw;
		top: 50%;
		transform: translateY(-50%);
		font-family: var(--font-display, inherit);
		font-weight: 700;
		font-size: clamp(160px, 31vw, 560px);
		line-height: 0.8;
		letter-spacing: -0.05em;
		color: transparent;
		-webkit-text-stroke: 1px rgb(244 241 234 / 0.09);
		white-space: nowrap;
		pointer-events: none;
		user-select: none;
	}
	.avf-glow {
		position: absolute;
		z-index: -1;
		right: 8%;
		top: 10%;
		width: 50vw;
		height: 50vw;
		border-radius: 50%;
		background: radial-gradient(closest-side, rgb(232 200 116 / 0.16), transparent);
		pointer-events: none;
	}
	.avf-grid {
		width: 100%;
		display: grid;
		grid-template-columns: minmax(0, 1.35fr) minmax(0, 0.65fr);
		gap: clamp(32px, 6vw, 110px);
		align-items: end;
	}
	.avf-copy {
		display: grid;
		gap: clamp(18px, 2.4vw, 30px);
		padding-bottom: clamp(8px, 3vh, 40px);
	}
	.avf-title {
		margin: 0;
		font-size: clamp(42px, min(5.6vw, 11vh), 112px);
		line-height: 0.98;
		letter-spacing: -0.045em;
		color: #fff;
		max-width: 11em;
	}
	.avf-ficha {
		margin: 0;
		color: rgb(255 255 255 / 0.7);
	}
	.avf-ficha span {
		color: var(--pa-accent);
		margin: 0 10px;
	}
	.avf-photo {
		margin: 0;
		justify-self: end;
		width: min(100%, calc((var(--pa-hero-h) - 160px) * 0.8));
	}
	.avf-frame {
		position: relative;
		aspect-ratio: 4 / 5;
		border-radius: var(--pa-r-lg, 20px);
		overflow: hidden;
		background: #000;
		box-shadow: 0 40px 80px -30px rgb(0 0 0 / 0.7);
	}
	.avf-frame::after {
		content: '';
		position: absolute;
		inset: 0;
		border-radius: inherit;
		box-shadow: inset 0 0 0 1px rgb(244 241 234 / 0.12);
		pointer-events: none;
	}
	.avf-frame-in {
		position: absolute;
		inset: -6% 0;
	}
	.avf-frame-in :global(picture),
	.avf-frame-in :global(img) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.avf-cap {
		display: flex;
		justify-content: space-between;
		gap: 16px;
		margin-top: 14px;
		color: rgb(255 255 255 / 0.5);
	}
	.avf-cue {
		position: absolute;
		left: 50%;
		bottom: clamp(20px, 3vh, 36px);
		color: rgb(255 255 255 / 0.5);
	}
	@media (max-width: 860px) {
		.avf {
			min-height: auto;
			padding: 28px 0 56px;
		}
		.avf-grid {
			grid-template-columns: 1fr;
			gap: 32px;
		}
		.avf-photo {
			order: -1;
			justify-self: stretch;
			width: 100%;
		}
		.avf-word {
			top: auto;
			bottom: 4%;
			transform: none;
			font-size: 46vw;
		}
		.avf-cue,
		.avf-cap span:last-child {
			display: none;
		}
	}

	/* ---- capítulos ---- */
	.av-cap {
		background: var(--pa-bg);
	}
	.aventura-para {
		max-width: 62ch;
		font-size: 17px;
		line-height: 1.7;
		color: rgba(11, 14, 23, 0.72);
		margin: 0;
	}
	.aventura-para--big {
		font-size: clamp(19px, 1rem + 0.6vw, 24px);
		line-height: 1.5;
		color: var(--pa-ink);
	}
	.kite-body {
		display: grid;
		gap: 22px;
		max-width: 900px;
		margin-left: auto;
	}
	.aventura-para--closing {
		max-width: none;
		margin-top: 48px;
		padding-top: 40px;
		border-top: 1px solid var(--pa-line-light);
		font-size: clamp(30px, 3vw, 54px);
		line-height: 1.04;
		color: var(--pa-ink);
	}

	/* ---- galería Guinness ---- */
	.guinness-gal {
		overflow: hidden;
	}
	.guinness-slide {
		position: relative;
		width: clamp(260px, 26vw, 380px);
		aspect-ratio: 3 / 4;
		border-radius: var(--pa-r-lg);
		overflow: hidden;
		background: #111;
		flex: 0 0 auto;
	}
	.guinness-slide :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 900ms var(--pa-ease);
	}
	.guinness-slide:hover :global(img) {
		transform: scale(1.05);
	}
	.guinness-slide__scrim {
		position: absolute;
		inset: 0;
		background: linear-gradient(to top, rgba(0, 0, 0, 0.8), transparent 55%);
	}
	.guinness-slide__idx {
		position: absolute;
		top: 18px;
		left: 20px;
		color: rgb(255 255 255 / 0.85);
	}
	.guinness-slide__caption {
		position: absolute;
		left: 20px;
		right: 20px;
		bottom: 20px;
		color: #fff;
		font-size: 14px;
		font-weight: 600;
		line-height: 1.3;
	}

	.guinness-pie {
		margin-top: clamp(56px, 7vw, 110px);
		display: grid;
		gap: clamp(48px, 6vw, 88px);
	}
	.guinness-pie__texto {
		font-size: clamp(19px, 1rem + 0.6vw, 24px);
		line-height: 1.5;
		max-width: 40ch;
		color: var(--ink-mid);
	}
	.guinness-pie__texto strong {
		font-weight: 600;
		color: var(--pa-accent);
	}

	/* ---- Fuji ---- */
	.fuji-media {
		--pa-crop-o: -10px;
	}
	.fuji-media :global(img),
	.fuji-media :global(.media-card) {
		border-radius: var(--pa-r-lg);
	}
	.fuji-caption {
		display: block;
		margin-top: 18px;
		color: rgba(11, 14, 23, 0.6);
		max-width: 320px;
	}

	@media (max-width: 760px) {
		.av-cue {
			display: none;
		}
	}
	@media (max-width: 560px) {
		.guinness-slide {
			width: 76vw;
		}
	}
	/* Áreas táctiles ≥44px en la galería (el carrusel es del kit: se agranda
	   sólo el área de toque, no el dibujo). */
	.pa :global(.kit-carousel__dot),
	.pa :global(.kit-carousel__arrow) {
		position: relative;
	}
	.pa :global(.kit-carousel__dot)::after {
		content: '';
		position: absolute;
		inset: -18px -4px;
	}
	.pa :global(.kit-carousel__arrow)::after {
		content: '';
		position: absolute;
		inset: -2px;
		border-radius: 999px;
	}
</style>
