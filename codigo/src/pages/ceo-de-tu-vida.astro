<style>
	/* ================= cabeceras ================= */
	.ceo-head {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 3fr);
		grid-template-areas:
			'n t'
			'k t'
			'. l';
		grid-template-rows: auto 1fr auto;
		column-gap: var(--ed-gutter);
		row-gap: 8px;
		padding-top: 22px;
		border-top: 1px solid var(--ed-line-strong);
	}
	.ed-sec--light .ceo-head {
		border-top-color: rgb(12 10 6 / 0.2);
	}
	.ceo-head-n {
		grid-area: n;
		color: rgb(255 255 255 / 0.45);
	}
	.ed-sec--light .ceo-head-n {
		color: rgb(12 10 6 / 0.5);
	}
	.ceo-k {
		grid-area: k;
		margin: 0;
		font: 500 11.5px/1.4 var(--ed-mono);
		letter-spacing: 0.08em;
		color: var(--ed-accent);
	}
	.ed-sec--light .ceo-k {
		color: var(--ed-accent-ink);
	}
	.ceo-h2 {
		grid-area: t;
		font-size: clamp(2.6rem, 1.2rem + 5.6vw, 7.5rem);
		color: inherit;
		max-width: none;
	}
	.ceo-lead2 {
		grid-area: l;
		margin: 16px 0 0;
		max-width: 56ch;
		font-size: clamp(1.0625rem, 1rem + 0.3vw, 1.3125rem);
		line-height: 1.55;
		color: rgb(255 255 255 / 0.68);
	}
	.ed-sec--light .ceo-lead2 {
		color: rgb(12 10 6 / 0.7);
	}
	.ceo-lead2 a {
		color: inherit;
		text-decoration: underline;
		text-decoration-color: var(--ed-accent);
		text-underline-offset: 4px;
	}
	/* sección partida: cabecera a la izquierda, cuerpo a la derecha */
	.ceo-split {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		gap: clamp(40px, 6vw, 112px);
		align-items: start;
	}
	.ceo-split .ceo-head {
		grid-template-columns: 1fr;
