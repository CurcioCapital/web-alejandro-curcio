</style>

<script>
	// «El origen»: el texto se pinta palabra por palabra con el scroll, con la
	// misma mecánica que «Quién es» en el home.
	{
		const caja = document.querySelector<HTMLElement>('[data-pinta]');
		const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
		if (caja && !reduce) {
			const palabras: HTMLElement[] = [];
			const envolver = (nodo: Node) => {
				Array.from(nodo.childNodes).forEach((n) => {
					if (n.nodeType === 3) {
						const frag = document.createDocumentFragment();
						(n.textContent || '').split(/(\s+)/).forEach((t) => {
							if (!t) return;
							if (/^\s+$/.test(t)) frag.appendChild(document.createTextNode(t));
							else {
								const sp = document.createElement('span');
								sp.className = 'pw';
								sp.textContent = t;
								frag.appendChild(sp);
								palabras.push(sp);
							}
						});
						n.parentNode!.replaceChild(frag, n);
					} else if (n.nodeType === 1) envolver(n);
				});
			};
			const bloques = Array.from(caja.querySelectorAll<HTMLElement>('[data-pinta-words]'));
			bloques.forEach(envolver);
			document.documentElement.classList.add('pinta-on');
			const primero = bloques[0], ultimo = bloques[bloques.length - 1];
			let raf = 0;
			const pintar = () => {
				raf = 0;
				const vh = innerHeight;
				const a = primero.getBoundingClientRect().top;
				const b = ultimo.getBoundingClientRect().bottom;
				const ini = vh * 0.85, fin = vh * 0.5;
				const p = Math.min(1, Math.max(0, (ini - a) / ((b - a + (ini - fin)) || 1)));
				const n = Math.round(p * palabras.length);
				palabras.forEach((w, i) => w.classList.toggle('is-on', i < n));
			};
			addEventListener('scroll', () => { if (!raf) raf = requestAnimationFrame(pintar); }, { passive: true });
			addEventListener('resize', () => { if (!raf) raf = requestAnimationFrame(pintar); });
			pintar();
		}
	}

	import { odoSet } from '../components/secciones/libros/ed';

	// ---------- cuenta regresiva, sólo días ----------
	// Mismo texto que antes («Faltan N días» / «Falta 1 día»); el número va
	// en un odómetro (odoSet) salvo con reduced-motion.
	const faltan = document.querySelector<HTMLElement>('.ceo-faltan[data-countdown]');
	if (faltan) {
		const target = new Date(faltan.dataset.countdown || '').getTime();
		const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		let num: HTMLElement | null = null;
		let pre: Text | null = null;
		let post: Text | null = null;
		const tick = () => {
			const left = target - Date.now();
			if (left <= 0) {
				faltan.hidden = true;
				return;
			}
			const dias = Math.ceil(left / 86400000);
			if (reduce) {
				faltan.textContent = dias === 1 ? 'Falta 1 día' : `Faltan ${dias} días`;
				return;
			}
			if (!num) {
				faltan.textContent = '';
				pre = document.createTextNode('');
				num = document.createElement('span');
				post = document.createTextNode('');
				faltan.append(pre, num, post);
			}
			pre!.nodeValue = dias === 1 ? 'Falta ' : 'Faltan ';
			post!.nodeValue = dias === 1 ? ' día' : ' días';
			odoSet(num, String(dias), !num.dataset.odoValue);
			if (num.dataset.odoRun !== '1') {
				num.dataset.odoRun = '1';
				requestAnimationFrame(() =>
					requestAnimationFrame(() => {
						num!.querySelectorAll<HTMLElement>('.ed-odo__col').forEach((c, i) => {
							c.style.transitionDelay = `${300 + i * 120}ms`;
							c.style.setProperty('--d', String(dias).replace(/\D/g, '')[i] ?? '0');
						});
					})
				);
			}
		};
		if (!Number.isNaN(target) && target > Date.now()) {
			tick();
			faltan.hidden = false;
			setInterval(tick, 60000);
		}
	}

	// ---------- aviso de lanzamiento ----------
	// Sin endpoint el formulario se deshabilita y lo dice. Es preferible a un
	// botón que parece funcionar y tira los mails a la basura.
	document.querySelectorAll<HTMLFormElement>('[data-aviso]').forEach((form) => {
		const endpoint = form.dataset.endpoint?.trim();
		const nota = form.querySelector<HTMLElement>('[data-nota]')!;
		const btn = form.querySelector('button')!;
		const input = form.querySelector('input')!;

		if (!endpoint) {
			btn.disabled = true;
			input.disabled = true;
			nota.textContent = 'Todavía sin conectar: falta elegir el servicio que recibe los mails.';
			return;
		}

		form.addEventListener('submit', async (e) => {
			e.preventDefault();
			btn.disabled = true;
			nota.textContent = 'Enviando…';
			try {
				const res = await fetch(endpoint, {
					method: 'POST',
					headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
					body: JSON.stringify({ email: input.value }),
				});
				if (!res.ok) throw new Error(String(res.status));
				form.reset();
				nota.textContent = 'Listo. Te avisamos cuando haya fecha.';
			} catch {
				nota.textContent = 'No se pudo enviar. Probá de nuevo en un rato.';
				btn.disabled = false;
			}
		});
	});

	// ---------- ema ----------
	// Se guarda en el navegador de quien escribe y en ningún otro lado. El
	// acceso va en try/catch porque en ventana privada localStorage tira.
	document.querySelectorAll<HTMLElement>('[data-ema]').forEach((box) => {
		const input = box.querySelector<HTMLTextAreaElement>('[data-ema-input]')!;
		const count = box.querySelector<HTMLElement>('[data-ema-count]')!;
		const CLAVE = 'ac:ema';
		const max = Number(input.getAttribute('maxlength')) || 180;

		const pintar = () => {
			count.textContent = `${input.value.length} / ${max}`;
		};

		try {
			const guardado = localStorage.getItem(CLAVE);
			if (guardado) input.value = guardado;
		} catch {
			/* ventana privada o storage bloqueado: se sigue sin guardar */
		}
		pintar();

		input.addEventListener('input', () => {
			pintar();
			try {
				localStorage.setItem(CLAVE, input.value);
			} catch {
				/* idem */
			}
		});
	});
</script>
