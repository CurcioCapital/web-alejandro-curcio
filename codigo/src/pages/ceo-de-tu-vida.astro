---
/**
 * ceo-de-tu-vida.astro — landing dedicada al lanzamiento del tercer libro.
 *
 * Distinta de /libros: allá conviven los tres libros como catálogo; acá hay
 * uno solo y la página tiene un trabajo concreto — que alguien deje su mail
 * y llegue al lanzamiento sabiendo de qué se trata.
 *
 * TODO el contenido sale de «05 — Hechos verificados.md», sección «Material
 * de CEO DE TU VIDA», que a su vez viene del PDF de 70 páginas que mandó
 * Mariana Zabala (editorial) el 27/08/2026. Las tres reglas que se muestran
 * son de las 7 que la editorial envió como material promocional.
 *
 * DOS COSAS NO ESTÁN Y SE NOTA A PROPÓSITO:
 * 1. El video del evento. El evento es en noviembre de 2026 — todavía no
 *    ocurrió. El bloque existe con su hueco reservado y un aviso; cuando haya
 *    material se cambia el `data-pendiente` por el video y listo.
 * 2. El formulario NO tiene servicio conectado. Sin `data-endpoint` el botón
 *    queda deshabilitado a propósito: es preferible que no se pueda enviar
 *    antes que tragarse mails en silencio.
 *
 * La mecánica japonesa del evento (torii, omikuji, taiko) NO se publica: el
 * concepto todavía no lo aprobó Alejandro, y además arruinaría la sorpresa.
 * El ema sí, pero reinterpretado como pieza web — ver la sección «Tu ema».
 */
import Base from '../layouts/Base.astro';
import '../components/secciones/libros/ed.css';
import MediaCard from '../components/MediaCard.astro';
import CeoClimax from '../components/secciones/libros/CeoClimax.astro';

// Las seis secciones del libro, con las preguntas que abren cada una.
const secciones = [
	{ n: 'I', titulo: 'Identidad y fundamentos', preguntas: '¿Quién sos? ¿Qué te define? ¿Desde dónde construís?' },
	{ n: 'II', titulo: 'Mente, emociones y decisión', preguntas: '¿Cómo pensás? ¿Cómo reaccionás? ¿Cómo decidís?' },
	{ n: 'III', titulo: 'Energía, tiempo y vida', preguntas: '¿Cómo vivís? ¿Cómo sostenés? ¿Cómo rendís?' },
	{ n: 'IV', titulo: 'Acción y ejecución', preguntas: '¿Cómo avanzás? ¿Cómo hacés que pase?' },
	{ n: 'V', titulo: 'Negocio, dinero y liderazgo', preguntas: '¿Cómo construís? ¿Cómo escalás? ¿Cómo liderás?' },
	{ n: 'VI', titulo: 'Entorno, relaciones y sistema', preguntas: '¿Con quién vivís? ¿Qué sistema te sostiene?' },
];

// Los once interludios. El kanji es el ancla visual; el romaji, el nombre.
const palabras = [
	{ kanji: '和', romaji: 'Wa', linea: 'La armonía como principio de liderazgo' },
	{ kanji: 'おもてなし', romaji: 'Omotenashi', linea: 'El arte de anticipar al otro' },
	{ kanji: '侘寂', romaji: 'Wabi-sabi', linea: 'La belleza de lo imperfecto' },
	{ kanji: '改善', romaji: 'Kaizen', linea: 'El poder de mejorar todos los días' },
	{ kanji: '生き甲斐', romaji: 'Ikigai', linea: 'La razón por la que te levantás cada mañana' },
	{ kanji: '職人', romaji: 'Shokunin', linea: 'El espíritu del maestro artesano' },
	{ kanji: '現地現物', romaji: 'Genchi genbutsu', linea: 'Ir y ver con tus propios ojos' },
	{ kanji: 'こだわり', romaji: 'Kodawari', linea: 'La obsesión silenciosa por la excelencia' },
	{ kanji: '現場', romaji: 'Gemba', linea: 'El lugar donde ocurre la verdad' },
	{ kanji: '武士道', romaji: 'Bushidō', linea: 'El código del honor' },
	{ kanji: '無駄', romaji: 'Muda', linea: 'El enemigo invisible de la eficiencia' },
];

// Orden de la grilla: Kaizen al centro (5 · Kaizen · 5) para que quede
// simétrica. La numeración (decorativa) sigue el orden en pantalla.
const kaizen = palabras.findIndex((p) => p.romaji === 'Kaizen');
const resto = palabras.map((p, i) => ({ p, i })).filter(({ i }) => i !== kaizen);
const orden = [...resto.slice(0, 5), { p: palabras[kaizen], i: kaizen }, ...resto.slice(5)];

// Tres de las siete reglas que mandó la editorial como material promocional.
const reglas = [
	'Construí primero lo que nadie puede quitarte: tu conocimiento y tu capacidad de aplicarlo.',
	'No trabajes para demostrar tu valor. Trabajá para construir valor.',
	'No te define lo que aspirás a lograr. Te define lo que dejás de tolerar.',
];
---

<Base
	title="CEO DE TU VIDA — Alejandro Curcio"
	description="51 reglas para decidir mejor, liderar con claridad y construir una vida con intención. El tercer libro de Alejandro Curcio, por Grijalbo. Noviembre de 2026."
>
	<!-- ============ 1 · APERTURA ============ -->
	<section class="ed-sec ed-grid ceo-hero">
		<div class="ceo-hero-glow" aria-hidden="true"></div>
		<div class="ed-wrap">
			<div class="ceo-top ed-mono">
				<span class="ceo-kicker">Grijalbo · Noviembre 2026</span>
				<span class="ceo-idx" aria-hidden="true">[ 00 ]</span>
			</div>
			<div class="ceo-hero-grid">
				<div class="ceo-hero-copy">
					<h1 class="ceo-title ed-display" data-split="lines">CEO DE TU VIDA</h1>
					<p class="ceo-sub ed-serif" data-split="lines">
						51 reglas para decidir mejor, liderar con claridad y construir una vida con intención.
					</p>
					<p class="ceo-lead" data-reveal>
						El tercer libro de Alejandro Curcio. Después de mirar hacia adentro
						(<a href="/libros" data-cursor="link">Capital de Vida</a>) y de entender lo que viene
						(<a href="/libros" data-cursor="link">Toolbook</a>), este es el de hacerse cargo.
					</p>

					<!-- Cuenta regresiva en días. Sin segundos: ver el criterio en
					     Header.astro — el tictac al segundo es urgencia fabricada.
					     Los dígitos giran como odómetro (odoSet de ed.ts). -->
					<p class="ceo-faltan ed-mono" data-countdown="2026-11-17T00:00:00-03:00" hidden></p>

					<!-- Sin servicio conectado el botón queda deshabilitado: mejor que
					     no se pueda enviar a que se traguen mails en silencio. -->
					<form class="ceo-form" data-aviso data-endpoint="">
						<label class="ceo-form-label ed-mono" for="ceo-mail">Enterate del lanzamiento</label>
						<div class="ceo-form-row">
							<span class="ceo-form-prompt ed-mono" aria-hidden="true">&gt;</span>
							<input
								id="ceo-mail"
								type="email"
								name="email"
								required
								autocomplete="email"
								placeholder="tu@correo.com"
								aria-describedby="ceo-form-nota"
							/>
							<button type="submit">Avisame</button>
						</div>
						<p class="ceo-form-nota ed-mono" id="ceo-form-nota" data-nota></p>
					</form>
				</div>

				<figure class="ceo-cover" data-ed-tilt="10">
					<div class="ceo-cover-obj ed-tilt__obj" data-reveal="mask">
						<MediaCard
							src="/media/covers/ceo-de-tu-vida-mockup.jpg"
							class="media-card--natural"
							alt="El libro CEO DE TU VIDA, de Alejandro Curcio (Grijalbo, noviembre 2026)"
						/>
					</div>
				</figure>
			</div>
		</div>
	</section>

	<!-- ============ 2 · EL ORIGEN ============
	     La estética japonesa del libro no es una decisión de diseño: es de
	     dónde salió el material. Por eso este bloque va antes que el índice. -->
	<section id="origen" class="ed-sec ed-sec--light ed-sec--sheet ed-grid ceo-origen">
		<div class="ed-wrap ceo-split">
			<div class="ceo-head">
				<span class="ed-mono ceo-head-n" aria-hidden="true">[ 01 ]</span>
				<span class="kicker ed-mono ceo-k">El origen</span>
				<h2 class="section-title ed-display ceo-h2" data-split="lines">El libro empezó en una playa de Okinawa.</h2>
			</div>
			<div class="origen-cuerpo" data-pinta>
				<p data-pinta-words>
					Alejandro entró a la empresa familiar siendo casi adolescente. <strong>A los 25 ya dirigía
					la compañía</strong>, con un padre que le llevaba más de cincuenta años.
				</p>
				<p data-pinta-words>
					En 2023 viajó a Japón con su hijo Lucca. Toyota Motor Corporation había organizado un
					encuentro de presidentes de distintos países <strong>junto a las segundas y terceras
					generaciones</strong> de sus familias empresarias. El tema declarado era el negocio. El
					tema real era el legado.
				</p>
				<p data-pinta-words>
					Después de Tokio fueron a Okinawa. Una mañana caminó solo por la playa, con el mar calmo
					y en silencio. De ahí salieron las preguntas que originaron este libro.
				</p>
			</div>
		</div>
	</section>

	<!-- ============ 3 · LAS SEIS PREGUNTAS ============ -->
	<section id="secciones" class="ed-sec ed-sec--sheet ed-grid ceo-secciones">
		<div class="ed-wrap">
			<div class="ceo-head ceo-head--row">
				<span class="ed-mono ceo-head-n" aria-hidden="true">[ 02 ]</span>
				<span class="kicker ed-mono ceo-k">Seis secciones</span>
				<h2 class="section-title ed-display ceo-h2" data-split="lines">El libro está ordenado como preguntas.</h2>
				<p class="section-lead ceo-lead2" data-reveal>
					Cada sección abre con las suyas. Las <span data-counter>51</span> reglas son las respuestas.
				</p>
			</div>

			<ol class="secciones">
				{
					secciones.map((s) => (
						<li class="seccion" data-scrub="enter">
							<span class="seccion-n">{s.n}</span>
							<div class="seccion-txt">
								<h3 class="seccion-titulo">{s.titulo}</h3>
								<p class="seccion-preguntas">{s.preguntas}</p>
							</div>
						</li>
					))
				}
			</ol>
		</div>
	</section>

	<!-- ============ 3 · CUENTA REGRESIVA (la misma de /libros) ============ -->
	<CeoClimax id="lanzamiento" kicker="Lanzamiento · 17 de noviembre de 2026" n="03" />
</Base>

<style>
	/* ================= cabeceras ================= */
	.ceo-head {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 3fr);
		grid-template-areas:
			'n t'
			'k t'
			'. l';
		grid-template-rows: auto 1fr auto;
		column-gap: var(--ed-gutter);
		row-gap: 8px;
		padding-top: 22px;
		border-top: 1px solid var(--ed-line-strong);
	}
	.ed-sec--light .ceo-head {
		border-top-color: rgb(12 10 6 / 0.2);
	}
	.ceo-head-n {
		grid-area: n;
		color: rgb(255 255 255 / 0.45);
	}
	.ed-sec--light .ceo-head-n {
		color: rgb(12 10 6 / 0.5);
	}
	.ceo-k {
		grid-area: k;
		margin: 0;
		font: 500 11.5px/1.4 var(--ed-mono);
		letter-spacing: 0.08em;
		color: var(--ed-accent);
	}
	.ed-sec--light .ceo-k {
		color: var(--ed-accent-ink);
	}
	.ceo-h2 {
		grid-area: t;
		font-size: clamp(2.6rem, 1.2rem + 5.6vw, 7.5rem);
		color: inherit;
		max-width: none;
	}
	.ceo-lead2 {
		grid-area: l;
		margin: 16px 0 0;
		max-width: 56ch;
		font-size: clamp(1.0625rem, 1rem + 0.3vw, 1.3125rem);
		line-height: 1.55;
		color: rgb(255 255 255 / 0.68);
	}
	.ed-sec--light .ceo-lead2 {
		color: rgb(12 10 6 / 0.7);
	}
	.ceo-lead2 a {
		color: inherit;
		text-decoration: underline;
		text-decoration-color: var(--ed-accent);
		text-underline-offset: 4px;
	}
	/* sección partida: cabecera a la izquierda, cuerpo a la derecha */
	.ceo-split {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		gap: clamp(40px, 6vw, 112px);
		align-items: start;
	}
	.ceo-split .ceo-head {
		grid-template-columns: 1fr;
		grid-template-areas: 'n' 'k' 't' 'l';
		grid-template-rows: auto;
	}
	.ceo-split .ceo-h2 {
		font-size: clamp(2.6rem, 1rem + 4.6vw, 6.25rem);
		margin-top: 18px;
	}

	/* ================= apertura ================= */
	.ceo-hero {
		min-height: min(100svh, 1080px);
		padding-top: clamp(120px, 15vh, 180px);
		padding-bottom: clamp(56px, 8vh, 96px);
	}
	.ceo-hero-glow {
		position: absolute;
		inset: auto -10% -30% 30%;
		height: 90%;
		z-index: -1;
		background: radial-gradient(closest-side, rgb(232 200 116 / 0.16), transparent 70%);
		pointer-events: none;
	}
	.ceo-top {
		display: flex;
		justify-content: space-between;
		padding-bottom: 14px;
		border-bottom: 1px solid var(--ed-line-strong);
		margin-bottom: clamp(32px, 5vw, 64px);
	}
	.ceo-kicker {
		color: var(--ed-accent);
	}
	.ceo-idx {
		color: rgb(255 255 255 / 0.45);
	}
	.ceo-hero-grid {
		display: grid;
		grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
		gap: clamp(36px, 5vw, 88px);
		align-items: center;
	}
	.ceo-title {
		text-transform: uppercase;
		font-size: clamp(4.5rem, 13.5vw, 14rem);
		line-height: 0.8;
		letter-spacing: -0.025em;
		color: #fff;
		max-width: 7ch;
	}
	.ceo-sub {
		font-size: clamp(1.6rem, 1rem + 2vw, 3rem);
		line-height: 1.05;
		color: var(--ed-accent);
		margin: clamp(24px, 3vw, 40px) 0 0;
		max-width: 18em;
		text-wrap: balance;
	}
	.ceo-lead {
		font-size: var(--text-body, 1.0625rem);
		line-height: 1.68;
		color: rgb(255 255 255 / 0.7);
		margin: 22px 0 0;
		max-width: 46ch;
	}
	.ceo-lead a {
		color: #fff;
		text-decoration: none;
		border-bottom: 1px solid rgb(255 255 255 / 0.3);
		transition: border-color 0.3s var(--ed-expo), color 0.3s var(--ed-expo);
	}
	.ceo-lead a:hover {
		border-bottom-color: var(--ed-accent);
		color: var(--ed-accent);
	}
	.ceo-faltan {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		margin: 28px 0 0;
		padding: 10px 14px;
		border: 1px solid var(--ed-line-strong);
		border-radius: 999px;
		font-size: 12px;
		color: rgb(255 255 255 / 0.75);
	}
	.ceo-faltan[hidden] {
		display: none;
	}
	.ceo-faltan::before {
		content: '';
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: var(--ed-accent);
		box-shadow: 0 0 0 4px rgb(232 200 116 / 0.18);
	}
	.ceo-faltan :global(.ed-odo) {
		color: var(--ed-accent);
		font-weight: 600;
	}
	.ceo-cover {
		margin: 0;
		perspective: 1200px;
	}
	.ceo-cover :global(.media-card--natural) {
		--card-ar: 1280 / 1220;
		border-radius: var(--ed-r-lg);
	}

	/* ---------- formulario (DESACTIVADO a propósito sin endpoint) ---------- */
	.ceo-form {
		margin: 30px 0 0;
		max-width: 500px;
	}
	.ceo-form-label {
		display: block;
		color: rgb(255 255 255 / 0.55);
		margin-bottom: 12px;
	}
	.ceo-form-row {
		position: relative;
		display: flex;
		gap: 8px;
		padding: 6px;
		border: 1px solid rgb(255 255 255 / 0.18);
		border-radius: 999px;
		background: rgb(255 255 255 / 0.04);
	}
	.ceo-form-prompt {
		align-self: center;
		padding-left: 14px;
		color: var(--ed-accent);
		font-size: 14px;
	}
	.ceo-form input {
		flex: 1 1 auto;
		min-width: 0;
		background: transparent;
		border: 0;
		padding: 12px 8px;
		color: #fff;
		font-family: var(--ed-mono);
		font-size: 14px;
		outline: none;
	}
	.ceo-form-row:focus-within {
		border-color: var(--ed-accent);
	}
	.ceo-form input::placeholder {
		color: rgb(255 255 255 / 0.4);
	}
	.ceo-form button {
		min-height: 44px;
		flex: 0 0 auto;
		border: 0;
		border-radius: 999px;
		padding: 12px 22px;
		background: var(--ed-accent);
		color: var(--ed-ink);
		font-family: var(--ed-mono);
		font-size: 12px;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		cursor: pointer;
		transition: background 0.3s var(--ed-expo), opacity 0.3s var(--ed-expo);
	}
	.ceo-form button:hover:not(:disabled) {
		background: #fff;
	}
	.ceo-form button:disabled {
		opacity: 0.4;
		cursor: not-allowed;
	}
	.ceo-form-nota {
		margin: 12px 0 0;
		color: rgb(255 255 255 / 0.5);
		min-height: 1.2em;
		text-transform: none;
		letter-spacing: 0.02em;
	}

	/* ================= origen ================= */
	/* Texto que se pinta palabra por palabra con el scroll (igual que «Quién es»
	   en el home). El estado apagado cuelga de html.pinta-on (sin JS: todo visible). */
	:global(html.pinta-on) .origen-cuerpo :global(.pw) {
		opacity: 0.16;
		transition: opacity 0.35s ease;
	}
	:global(html.pinta-on) .origen-cuerpo :global(.pw.is-on) {
		opacity: 1;
	}
	.origen-cuerpo {
		display: flex;
		flex-direction: column;
		gap: 26px;
		padding-top: 22px;
		border-top: 1px solid rgb(12 10 6 / 0.2);
	}
	.origen-cuerpo p {
		margin: 0;
		font-size: clamp(1.125rem, 1rem + 0.5vw, 1.5rem);
		line-height: 1.55;
		color: rgb(12 10 6 / 0.72);
	}
	.origen-cuerpo strong {
		color: var(--ed-ink);
		font-weight: 650;
		background: linear-gradient(transparent 62%, rgb(232 200 116 / 0.5) 62%);
	}

	/* ================= seis secciones ================= */
	.secciones {
		list-style: none;
		margin: clamp(48px, 6vw, 96px) 0 0;
		padding: 0;
		border-top: 1px solid var(--ed-line-strong);
	}
	.seccion {
		position: relative;
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 3fr);
		gap: var(--ed-gutter);
		align-items: baseline;
		padding: clamp(24px, 3vw, 40px) 0;
		border-bottom: 1px solid var(--ed-line-strong);
	}
	.seccion::after {
		content: '';
		position: absolute;
		left: 0;
		right: 0;
		bottom: -1px;
		height: 1px;
		background: var(--ed-accent);
		transform-origin: left;
		transform: scaleX(min(1, calc(var(--p, 1) * 1.6)));
	}
	.seccion-n {
		font-family: var(--ed-display);
		font-weight: 500;
		font-size: clamp(3rem, 2rem + 4vw, 6.5rem);
		letter-spacing: -0.06em;
		line-height: 0.95;
		color: transparent;
		-webkit-text-stroke: 1px var(--ed-accent);
	}
	.seccion-titulo {
		font-family: var(--ed-display);
		font-weight: 560;
		font-size: clamp(1.75rem, 1rem + 2.2vw, 3.25rem);
		letter-spacing: -0.04em;
		line-height: 1.02;
		color: #fff;
		margin: 0;
		transition: color 0.4s var(--ed-expo);
	}
	.seccion:hover .seccion-titulo {
		color: var(--ed-accent);
	}
	.seccion-preguntas {
		margin: 14px 0 0;
		font-family: var(--ed-serif);
		font-style: italic;
		font-size: clamp(1.25rem, 1rem + 0.9vw, 2rem);
		line-height: 1.2;
		color: rgb(255 255 255 / 0.68);
	}

	/* ================= once palabras ================= */
	.palabras {
		list-style: none;
		margin: clamp(48px, 6vw, 88px) 0 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(5, minmax(0, 1fr));
		gap: 0;
		/* las líneas las dibuja cada celda (box-shadow): así la fila
		   incompleta del final no deja un hueco gris. */
		background: var(--ed-bg-2);
		border: 1px solid var(--ed-line-strong);
		border-radius: var(--ed-r-lg);
		overflow: hidden;
	}
	.palabra {
		position: relative;
		background: var(--ed-bg-2);
		box-shadow: 1px 0 0 var(--ed-line-strong), 0 1px 0 var(--ed-line-strong);
		padding: 22px 22px 26px;
		min-height: 240px;
		display: flex;
		flex-direction: column;
		transition-delay: calc(var(--i, 0) * 70ms);
		isolation: isolate;
	}
	.palabra::before {
		content: '';
		position: absolute;
		inset: 0;
		z-index: -1;
		background: radial-gradient(260px circle at var(--mx, 50%) var(--my, 50%), rgb(232 200 116 / 0.16), transparent 70%);
		opacity: 0;
		transition: opacity 0.5s var(--ed-expo);
	}
	.palabra:hover::before {
		opacity: 1;
	}
	.palabra-i {
		color: rgb(255 255 255 / 0.35);
		margin-bottom: auto;
