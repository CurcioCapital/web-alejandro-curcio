---
/**
 * libros.astro — Libros section. Built from the shared design-system
 * components in src/components/ (SectionWhite, MediaCard, Reveal — see
 * src/pages/index.astro, the reference for how these compose) + the kit
 * in src/components/kit/ (Accordion for both books' chapter indexes,
 * VideoModal for the Toolbook aftermovie and the chispa close) + a set
 * of Libros-only section builders under
 * src/components/secciones/libros/ for the pieces neither the shared
 * kit nor the shared components cover (the typographic hero, the "El
 * arco" three-column concept, book pull-quotes, the chapter-index
 * wrapper, the CEO DE TU VIDA climax card with its live countdown, and
 * the closing chispa quote).
 *
 * Copy source: sitio-copy/libros.md (hero/subline/body + the verified
 * quotes_used list — every blockquote below traces to that list).
 * Depth source: Alejandro/Libros/Capital de Vida.md, Toolbook.md, CEO de
 * tu Vida.md, and both books' "00 — Índice y Estructura.md" files — the
 * two chapter indexes are the real tables of contents from those files;
 * Toolbook's one-line chapter descriptors are the book's own page
 * headers (índice table, column "Página del libro"), not invented copy.
 * Media: src/data/books.json + public/media/covers/ (capital-de-vida-
 * front, toolbook-front) + public/media/video/ (toolbook-aftermovie.mp4,
 * chispa.mp4 — its close is transcribed verbatim in chispa.vtt).
 * D8: forjado, no heredado — CEO DE TU VIDA's climax card says it
 * directly; nothing else here touches inheritance.
 */
import Base from '../layouts/Base.astro';
import '../components/secciones/libros/ed.css';
import EdSection from '../components/secciones/libros/EdSection.astro';

import LibrosHero from '../components/secciones/libros/LibrosHero.astro';
import ArcoColumns from '../components/secciones/libros/ArcoColumns.astro';
import CeoClimax from '../components/secciones/libros/CeoClimax.astro';
import BookFeature from '../components/secciones/libros/BookFeature.astro';

const arcoSteps = [
  {
    index: '01',
    label: 'Adentro',
    year: '2018',
    book: 'Capital de Vida',
    line: 'Legado de valores en la cultura empresarial y familiar.',
    anchor: 'capital-de-vida',
  },
  {
    index: '02',
    label: 'Afuera',
    year: '2023',
    book: 'Toolbook',
    line: 'Herramientas para comprender el mundo que viene.',
    anchor: 'toolbook',
  },
  {
    index: '03',
    label: 'Método',
    year: '2026',
    book: 'CEO DE TU VIDA',
    line: 'Reglas con historias para dirigir tu propia vida.',
    anchor: 'ceo-de-tu-vida',
  },
];

const capitalDeVidaIndex = [
  { q: 'I — Mi padre y el viento', a: 'El capítulo que abre el libro: el vínculo con su padre, Emilio J. Curcio, y el momento que lo hizo escribir esta historia.' },
  { q: 'II — La familia Toyoda', a: 'Veinticinco años de relación con la familia fundadora de Toyota — el espejo que atraviesa todo el libro.' },
  { q: 'III — Usted parece japonés', a: 'Cómo la cultura de Toyota se filtró, sin planearlo, en la cultura de AYAX.' },
  { q: 'IV — El ejemplo y la inspiración', a: 'El legado no se hereda: se observa, se imita, se practica.' },
  { q: 'V — Transmitir valores', a: 'La tesis central del libro: un mismo set de valores para la empresa y para la familia, sin excepciones.' },
  { q: 'VI — Razón y emoción', a: 'Arranca la segunda mitad del libro: un modelo propio de gestión emocional, inspirado en el Toyota Way.' },
  { q: 'VII — Tomar nota', a: 'La disciplina de registrar lo que se vive, como método de aprendizaje.' },
  { q: 'VIII — El cordón Andon', a: 'El corazón del modelo: la herramienta de Toyota para detener la línea ante un problema, llevada a la vida personal.' },
  { q: 'IX — Del coma emocional al mapa de mi persona', a: 'Una herramienta propia para mapear el estado emocional, nacida de los años más duros de la familia.' },
  { q: 'X — Permitirme ser feliz', a: 'Un capítulo sobre el permiso, no sobre la técnica.' },
  { q: 'XI — Amor, compasión y unas gotas de alegría', a: 'Los vínculos como parte del capital de vida, no como un capítulo aparte de él.' },
  { q: 'XII — Nada más poderoso que un propósito en la vida', a: 'El cierre: la felicidad y el propósito como los verdaderos objetivos del capital de vida.' },
];

const toolbookParteI = [
  { q: '01 — Bienvenidos a la Cuarta Revolución Industrial', a: 'Bienvenidos a la Cuarta Revolución industrial. El futuro es ahora.' },
  { q: '02 — Inteligencia Artificial', a: 'Inteligencia artificial.' },
  { q: '03 — La Nanotecnología', a: 'La nanotecnología: el mundo desde otra perspectiva.' },
  { q: '04 — La Realidad Virtual y Mixta', a: 'La realidad virtual y mixta: cambiando la forma en que trabajamos y nos comunicamos.' },
  { q: '05 — El Metaverso', a: 'El metaverso.' },
  { q: '06 — Biotecnología', a: 'Biotecnología: entre oportunidades y dilemas.' },
];

const toolbookParteII = [
  { q: '07 — El Trabajo y el Empleo del Futuro', a: 'El trabajo y el empleo del futuro.' },
  { q: '08 — La Salud y el Bienestar', a: 'La salud y el bienestar en la era de la cuarta revolución industrial.' },
  { q: '09 — Seguridad y Ciberseguridad', a: 'Seguridad y ciberseguridad.' },
  { q: '10 — Comunicaciones', a: 'Comunicaciones: se aproxima una revolución en la forma de conectarnos… ¿estamos preparados?' },
  { q: '11 — Educación', a: 'El impacto de la revolución digital en la educación.' },
  { q: '12 — Nuestro Ambiente', a: 'Nuestro ambiente.' },
];
---

<Base
	title="Libros — Alejandro Curcio"
	description="Tres libros. Un solo arco: de adentro hacia afuera, y después el método. Capital de Vida, Toolbook y CEO DE TU VIDA — noviembre 2026."
>
	<!-- HERO -->
	<LibrosHero />

	<!-- EL ARCO — recorrido pineado con las tapas en 3D -->
	<EdSection
		id="arco"
		n="01"
		kicker="El arco"
		title="Adentro, afuera, método."
		hideHead
		class="libros-arco"
	>
		<ArcoColumns steps={arcoSteps} />
	</EdSection>

	<!-- CAPITAL DE VIDA -->
	<BookFeature
		id="capital-de-vida"
		n="02"
		sheet
		kicker="Capital de Vida · 2018 · Editorial Conecta"
		title="Legado de valores en la cultura empresarial y familiar."
		lead="Con prólogo de Hugo Burel. No nace de una posición cómoda: nace después de que la empresa casi muere dos veces —1982, el año bisagra 2001— y después de que Alejandro sobreviviera a un accidente grave de kitesurf en 2016."
		cover="capital-de-vida-front"
		ratio="2048 / 3216"
		alt="Tapa del libro Capital de Vida, de Alejandro Curcio"
		year="2018"
	>
		<p>
			El título no habla de plata heredada. Habla del único patrimonio que se transfiere sin
			gastarse: la conducta observada, los valores practicados, el propósito compartido. El
			libro combina esas experiencias límite con aprendizajes de la cultura japonesa y Toyota
			—los capítulos finales desarrollan un modelo propio de gestión emocional inspirado en el
			cordón Andon— y cierra con una pregunta que trae la propia contratapa: ¿dónde radica
			nuestro verdadero capital de vida? No en el banco. En lo que dejamos pasar a la
			siguiente generación como ejemplo vivo.
		</p>
	</BookFeature>

	<!-- TOOLBOOK -->
	<BookFeature
		id="toolbook"
		n="03"
		kicker="Toolbook · 2023 · Editorial Conecta, Serie Capital de Vida"
		title="Herramientas para comprender el mundo que viene."
		lead="Si Capital de Vida mira hacia adentro, Toolbook gira la cabeza hacia afuera: Inteligencia Artificial, Realidad Virtual, Nanotecnología, Biotecnología — explicadas desde la trinchera del inversor, no desde la torre del teórico."
		cover="toolbook-front"
		ratio="2048 / 3008"
		alt="Tapa del libro Toolbook, de Alejandro Curcio"
		year="2023"
	>
		<p>
			No hay catastrofismo en estas páginas. Sobre el futuro del trabajo, Alejandro es
			explícito: dice estar "totalmente convencido de que la cuarta revolución industrial
			consolidará millones de nuevos empleos y alcanzará una cifra muy superior a los que
			destruirá" (Cap. 7 — El Trabajo y el Empleo del Futuro). La tesis del libro es
			convicción, no alarma.
		</p>
	</BookFeature>

	<!-- CEO DE TU VIDA — el clímax -->
	<CeoClimax />

</Base>

<style>
	.libros-arco {
		padding-bottom: clamp(40px, 6vw, 96px);
	}
	.libros-toolbook {
		padding-top: clamp(24px, 4vw, 64px);
	}
	.book-detail-grid {
		display: grid;
		grid-template-columns: minmax(0, 0.8fr) minmax(0, 2fr);
		gap: clamp(32px, 6vw, 112px);
		margin-top: clamp(48px, 6vw, 96px);
		align-items: start;
	}
	.book-detail-cover {
		position: sticky;
		top: 110px;
		perspective: 1200px;
	}
	.book-detail-obj {
		position: relative;
	}
	.book-detail-obj :global(.media-card) {
		box-shadow: 0 40px 80px rgb(12 10 6 / 0.28), 0 10px 20px rgb(12 10 6 / 0.12);
	}
	.book-detail-sheen {
		position: absolute;
		inset: 0;
		border-radius: inherit;
		pointer-events: none;
		background: linear-gradient(105deg, rgb(255 255 255 / 0.28), transparent 18%, transparent 70%, rgb(255 255 255 / 0.1));
		mix-blend-mode: soft-light;
	}
	.book-detail-tag {
		display: block;
		margin-top: 22px;
		color: var(--ed-accent-ink);
	}
	.book-detail-text {
		min-width: 0;
	}
	.book-detail-para {
		max-width: 60ch;
		font-size: clamp(1.0625rem, 1rem + 0.25vw, 1.25rem);
		line-height: 1.65;
		color: rgb(12 10 6 / 0.74);
		margin: 0 0 8px;
	}
	.toolbook-video {
		max-width: 560px;
		margin: 48px 0 0;
	}
	.toolbook-video :global(.kit-video-modal__trigger) {
		border-radius: 18px;
	}
	/* tap target ≥44px para el cierre del modal (el kit lo dibuja a 36) */
	:global(.kit-video-modal__close) {
		min-width: 44px;
		min-height: 44px;
	}
	.toolbook-video-caption {
		display: block;
		margin: 16px 0 8px;
		color: rgb(12 10 6 / 0.6);
		max-width: 560px;
	}
	@media (max-width: 900px) {
		.book-detail-grid {
			grid-template-columns: 1fr;
			gap: 40px;
		}
		.book-detail-cover {
			position: static;
			max-width: 240px;
			margin: 0 auto;
		}
		.book-detail-tag {
			text-align: center;
		}
	}
</style>
