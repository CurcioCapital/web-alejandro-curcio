---
/**
 * libros.astro — Libros section. Built from the shared design-system
 * components in src/components/ (SectionWhite, MediaCard, Reveal — see
 * src/pages/index.astro, the reference for how these compose) + the kit
 * in src/components/kit/ (Accordion for both books' chapter indexes,
 * VideoModal for the Toolbook aftermovie and the chispa close) + a set
 * of Libros-only section builders under
 * src/components/secciones/libros/ for the pieces neither the shared
 * kit nor the shared components cover (the typographic hero, the "El
 * arco" three-column concept, book pull-quotes, the chapter-index
 * wrapper, the CEO DE TU VIDA climax card with its live countdown, and
 * the closing chispa quote).
 *
 * Copy source: sitio-copy/libros.md (hero/subline/body + the verified
 * quotes_used list — every blockquote below traces to that list).
 * Depth source: Alejandro/Libros/Capital de Vida.md, Toolbook.md, CEO de
 * tu Vida.md, and both books' "00 — Índice y Estructura.md" files — the
 * two chapter indexes are the real tables of contents from those files;
 * Toolbook's one-line chapter descriptors are the book's own page
 * headers (índice table, column "Página del libro"), not invented copy.
 * Media: src/data/books.json + public/media/covers/ (capital-de-vida-
 * front, toolbook-front) + public/media/video/ (toolbook-aftermovie.mp4,
 * chispa.mp4 — its close is transcribed verbatim in chispa.vtt).
 * D8: forjado, no heredado — CEO DE TU VIDA's climax card says it
 * directly; nothing else here touches inheritance.
 */
import Base from '../layouts/Base.astro';
import '../components/secciones/libros/ed.css';
import EdSection from '../components/secciones/libros/EdSection.astro';

import LibrosHero from '../components/secciones/libros/LibrosHero.astro';
import ArcoColumns from '../components/secciones/libros/ArcoColumns.astro';
import CeoClimax from '../components/secciones/libros/CeoClimax.astro';
import BookFeature from '../components/secciones/libros/BookFeature.astro';

const arcoSteps = [
  {
    index: '01',
    label: 'Adentro',
    year: '2018',
    book: 'Capital de Vida',
    line: 'Legado de valores en la cultura empresarial y familiar.',
    anchor: 'capital-de-vida',
  },
  {
    index: '02',
    label: 'Afuera',
    year: '2023',
    book: 'Toolbook',
    line: 'Herramientas para comprender el mundo que viene.',
    anchor: 'toolbook',
  },
  {
    index: '03',
    label: 'Método',
    year: '2026',
    book: 'CEO DE TU VIDA',
    line: 'Reglas con historias para dirigir tu propia vida.',
    anchor: 'ceo-de-tu-vida',
  },
];

const capitalDeVidaIndex = [
  { q: 'I — Mi padre y el viento', a: 'El capítulo que abre el libro: el vínculo con su padre, Emilio J. Curcio, y el momento que lo hizo escribir esta historia.' },
  { q: 'II — La familia Toyoda', a: 'Veinticinco años de relación con la familia fundadora de Toyota — el espejo que atraviesa todo el libro.' },
  { q: 'III — Usted parece japonés', a: 'Cómo la cultura de Toyota se filtró, sin planearlo, en la cultura de AYAX.' },
  { q: 'IV — El ejemplo y la inspiración', a: 'El legado no se hereda: se observa, se imita, se practica.' },
  { q: 'V — Transmitir valores', a: 'La tesis central del libro: un mismo set de valores para la empresa y para la familia, sin excepciones.' },
  { q: 'VI — Razón y emoción', a: 'Arranca la segunda mitad del libro: un modelo propio de gestión emocional, inspirado en el Toyota Way.' },
  { q: 'VII — Tomar nota', a: 'La disciplina de registrar lo que se vive, como método de aprendizaje.' },
  { q: 'VIII — El cordón Andon', a: 'El corazón del modelo: la herramienta de Toyota para detener la línea ante un problema, llevada a la vida personal.' },
  { q: 'IX — Del coma emocional al mapa de mi persona', a: 'Una herramienta propia para mapear el estado emocional, nacida de los años más duros de la familia.' },
  { q: 'X — Permitirme ser feliz', a: 'Un capítulo sobre el permiso, no sobre la técnica.' },
  { q: 'XI — Amor, compasión y unas gotas de alegría', a: 'Los vínculos como parte del capital de vida, no como un capítulo aparte de él.' },
  { q: 'XII — Nada más poderoso que un propósito en la vida', a: 'El cierre: la felicidad y el propósito como los verdaderos objetivos del capital de vida.' },
];

const toolbookParteI = [
  { q: '01 — Bienvenidos a la Cuarta Revolución Industrial', a: 'Bienvenidos a la Cuarta Revolución industrial. El futuro es ahora.' },
  { q: '02 — Inteligencia Artificial', a: 'Inteligencia artificial.' },
  { q: '03 — La Nanotecnología', a: 'La nanotecnología: el mundo desde otra perspectiva.' },
  { q: '04 — La Realidad Virtual y Mixta', a: 'La realidad virtual y mixta: cambiando la forma en que trabajamos y nos comunicamos.' },
  { q: '05 — El Metaverso', a: 'El metaverso.' },
  { q: '06 — Biotecnología', a: 'Biotecnología: entre oportunidades y dilemas.' },
];

const toolbookParteII = [
  { q: '07 — El Trabajo y el Empleo del Futuro', a: 'El trabajo y el empleo del futuro.' },
  { q: '08 — La Salud y el Bienestar', a: 'La salud y el bienestar en la era de la cuarta revolución industrial.' },
  { q: '09 — Seguridad y Ciberseguridad', a: 'Seguridad y ciberseguridad.' },
  { q: '10 — Comunicaciones', a: 'Comunicaciones: se aproxima una revolución en la forma de conectarnos… ¿estamos preparados?' },
  { q: '11 — Educación', a: 'El impacto de la revolución digital en la educación.' },
  { q: '12 — Nuestro Ambiente', a: 'Nuestro ambiente.' },
];
---

<Base
	title="Libros — Alejandro Curcio"
	description="Tres libros. Un solo arco: de adentro hacia afuera, y después el método. Capital de Vida, Toolbook y CEO DE TU VIDA — noviembre 2026."
>
	<!-- HERO -->
	<LibrosHero />

	<!-- EL ARCO — recorrido pineado con las tapas en 3D -->
	<EdSection
		id="arco"
		n="01"
		kicker="El arco"
		title="Adentro, afuera, método."
		hideHead
		class="libros-arco"
	>
		<ArcoColumns steps={arcoSteps} />
	</EdSection>

	<!-- CAPITAL DE VIDA -->
	<BookFeature
		id="capital-de-vida"
		n="02"
		sheet
		kicker="Capital de Vida · 2018 · Editorial Conecta"
		title="Legado de valores en la cultura empresarial y familiar."
		lead="Todos tenemos un proyecto que construimos día a día, en el ámbito empresarial y también en el familiar. Soñamos con él, transpiramos por él, siempre jugando de titular. Pero ¿qué sucederá cuando ya no ocupemos ese lugar?"
		cover="capital-de-vida-front"
		ratio="2048 / 3216"
		alt="Tapa del libro Capital de Vida, de Alejandro Curcio"
		year="2018"
	>
		<p>Alejandro Curcio, director de AYAX, empresa que representa a la marca Toyota en Uruguay, debió asumir prematuramente la conducción de la empresa familiar y vivió en carne propia la necesidad de dejar asentados los trazos principales de la cultura empresarial y en definitiva el conjunto de valores que defendemos a lo largo de la vida y transmitiremos a los que vendrán.</p><p>La construcción de un legado de valores conlleva introspección y preguntas incómodas que el autor vuelca en este libro como pocas veces lo hacen los líderes empresariales.</p>
	</BookFeature>

	<!-- TOOLBOOK -->
	<BookFeature
		id="toolbook"
		n="03"
		kicker="Toolbook · 2023 · Editorial Conecta, Serie Capital de Vida"
		title="Herramientas para comprender el mundo que viene."
		lead="La tecnología avanza como nunca y está redefiniendo la forma en que vivimos, trabajamos y nos comunicamos. La inteligencia artificial, la nanotecnología, la realidad virtual y mixta y la biotecnología son algunas de las áreas que impulsan estos cambios."
		cover="toolbook-front"
		ratio="2048 / 3008"
		alt="Tapa del libro Toolbook, de Alejandro Curcio"
		year="2023"
	>
		<p>Pero ¿de qué se trata todo esto y cómo funciona? ¿Cómo es que ya está repercutiendo en nuestro día a día? ¿Cómo podemos aprovecharlo a nuestro favor? ¿Qué oportunidades y qué retos se presentan? ¿Cuáles son los desafíos para las personas y las organizaciones?</p><p>Este libro tiene vocación de manual para leer en clave sencilla el alud de innovación que se presenta ante nuestras narices. El autor, Alejandro Curcio, inquieto emprendedor con una pulsión hacia la innovación, apuesta a compartir con los lectores de manera práctica las principales tendencias, sus alcances y también consecuencias.</p><p>El mercado laboral y la forma en que trabajamos, los adelantos médicos, la ciberseguridad, la comunicación y la producción de contenidos, los límites de la realidad…</p><p>Explorarlos es una forma de prepararse para ese futuro que empieza hoy.</p>
	</BookFeature>

<!-- 11/11/2026: MeetUps FIUM 2024 (Dropbox TOYOTA 2024/Ale - Meetup UM; texto: InfoNegocios, 20/11/2024). -->
<section id="meetup-fium" class="mu" aria-labelledby="mu-sec-t">
<!-- 12/11/2026: titular que separa los libros de las charlas y otros proyectos. -->
<header class="mu-sec"><p class="pa-mono mu-kick">Charlas, encuentros y otros proyectos</p><h2 id="mu-sec-t" class="mu-sec-title">Más allá de los libros.</h2></header>
<div class="mu-in">
<div class="mu-media"><video class="mu-video" data-audio="auto" src="/media/video/meetup-fium.mp4" poster="/media/video/meetup-fium-poster.jpg" muted loop autoplay playsinline preload="metadata" aria-label="Video del MeetUp de la Facultad de Ingeniería de la Universidad de Montevideo con Alejandro Curcio, noviembre de 2024"></video></div>
<div class="mu-copy">
<p class="pa-mono mu-kick">MeetUps FIUM · Universidad de Montevideo · Noviembre 2024</p>
<h3 id="mu-t" class="mu-title">Ingeniería, propósito y futuro.</h3>
<p>La Facultad de Ingeniería de la Universidad de Montevideo cerró su ciclo 2024 de MeetUps con una charla de Alejandro Curcio ante estudiantes, docentes y egresados.</p>
<p>Habló de la revolución industrial en curso, donde convergen inteligencia artificial, biotecnología, nanotecnología y sostenibilidad, y propuso repensar la movilidad: en lugar de prometer cero emisiones, apuntar a emisiones netas negativas, con el hidrógeno verde como una de las alternativas con más potencial.</p>
<p>También invitó a los futuros ingenieros a trabajar su inteligencia emocional:</p>
<blockquote class="mu-quote">&ldquo;Detrás de cada innovación está el propósito humano.&rdquo;</blockquote>
<p>En los jardines de la universidad, AYAX exhibió tres vehículos, entre ellos un Toyota Mirai a hidrógeno, y participó Fernando «Monti» Montero, piloto de Toyota Gazoo Racing.</p>
</div>
</div>

</section>

	<!-- CEO DE TU VIDA — el clímax -->
	<CeoClimax />

</Base>

<style>
	.libros-arco {
		padding-bottom: clamp(40px, 6vw, 96px);
	}
	.libros-toolbook {
		padding-top: clamp(24px, 4vw, 64px);
	}
	.book-detail-grid {
		display: grid;
		grid-template-columns: minmax(0, 0.8fr) minmax(0, 2fr);
		gap: clamp(32px, 6vw, 112px);
		margin-top: clamp(48px, 6vw, 96px);
		align-items: start;
	}
	.book-detail-cover {
		position: sticky;
		top: 110px;
		perspective: 1200px;
	}
	.book-detail-obj {
		position: relative;
	}
	.book-detail-obj :global(.media-card) {
		box-shadow: 0 40px 80px rgb(12 10 6 / 0.28), 0 10px 20px rgb(12 10 6 / 0.12);
	}
	.book-detail-sheen {
		position: absolute;
		inset: 0;
		border-radius: inherit;
		pointer-events: none;
		background: linear-gradient(105deg, rgb(255 255 255 / 0.28), transparent 18%, transparent 70%, rgb(255 255 255 / 0.1));
		mix-blend-mode: soft-light;
	}
	.book-detail-tag {
		display: block;
		margin-top: 22px;
		color: var(--ed-accent-ink);
	}
	.book-detail-text {
		min-width: 0;
	}
	.book-detail-para {
		max-width: 60ch;
		font-size: clamp(1.0625rem, 1rem + 0.25vw, 1.25rem);
		line-height: 1.65;
		color: rgb(12 10 6 / 0.74);
		margin: 0 0 8px;
	}
	.toolbook-video {
		max-width: 560px;
		margin: 48px 0 0;
	}
	.toolbook-video :global(.kit-video-modal__trigger) {
		border-radius: 18px;
	}
	/* tap target ≥44px para el cierre del modal (el kit lo dibuja a 36) */
	:global(.kit-video-modal__close) {
		min-width: 44px;
		min-height: 44px;
	}
	.toolbook-video-caption {
		display: block;
		margin: 16px 0 8px;
		color: rgb(12 10 6 / 0.6);
		max-width: 560px;
	}
	@media (max-width: 900px) {
		.book-detail-grid {
			grid-template-columns: 1fr;
			gap: 40px;
		}
		.book-detail-cover {
			position: static;
			max-width: 240px;
			margin: 0 auto;
		}
		.book-detail-tag {
			text-align: center;
		}
	}
</style>

<style is:inline>.mu{background:#0c0a06;color:#f3ead6;padding:clamp(72px,9vw,140px) clamp(20px,5vw,72px)}
.mu-sec{max-width:1240px;margin:0 auto clamp(48px,6vw,96px);padding-bottom:clamp(24px,3vw,40px);border-bottom:1px solid rgba(243,234,214,.16);position:relative}.mu-sec::after{content:"";position:absolute;left:0;bottom:-1px;width:56px;height:1px;background:linear-gradient(90deg,#b8892a,#e8c874)}.mu-sec-title{font-family:var(--font-display,inherit);font-weight:var(--display-wght,560);font-size:clamp(44px,7vw,120px);line-height:.94;letter-spacing:-.05em;margin:0;color:#f3ead6}.mu-title{margin-top:0}
.mu-in{max-width:1240px;margin:0 auto;display:grid;grid-template-columns:minmax(0,4fr) minmax(0,6fr);gap:clamp(28px,5vw,88px);align-items:center}
.mu-media{border-radius:20px;overflow:hidden;aspect-ratio:9/16;max-height:82vh;background:#000}
.mu-video{display:block;width:100%;height:100%;object-fit:cover}
.mu-kick{font-size:11.5px;letter-spacing:.1em;text-transform:uppercase;color:#e8c874;margin:0 0 18px}
.mu-title{font-family:var(--font-display,inherit);font-weight:var(--display-wght,560);font-size:clamp(38px,5.2vw,84px);line-height:.95;letter-spacing:-.04em;margin:0 0 28px;color:#fff}
.mu-copy p{font-size:clamp(16px,.95rem + .25vw,19px);line-height:1.6;color:rgba(243,234,214,.78);margin:0 0 16px;max-width:60ch}
.mu-quote{margin:8px 0 22px;padding-left:22px;border-left:2px solid #e8c874;font-family:var(--font-serif,"Instrument Serif",Georgia,serif);font-style:italic;font-size:clamp(26px,1rem + 1.8vw,40px);line-height:1.15;color:#fff}
.mu-copy p.mu-src{font-size:10.5px;letter-spacing:.08em;color:rgba(243,234,214,.5);margin-top:20px}
.mu-foto{max-width:1240px;margin:clamp(40px,5vw,72px) auto 0;border-radius:20px;overflow:hidden}
.mu-foto img{display:block;width:100%;height:auto}
@media (max-width:860px){.mu-in{grid-template-columns:1fr}.mu-media{max-width:420px}}
</style>
