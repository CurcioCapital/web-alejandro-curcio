<style>
	/* ================= HERO — plancha a sangre ================= */
	.neg-hero {
		--p: 0;
		position: relative;
	}
	.plate {
		position: relative;
		margin: 0;
		min-height: var(--pa-hero-h);
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
		overflow: hidden;
		background: var(--pa-bg-2);
		isolation: isolate;
	}
	.plate-media {
		position: absolute;
		inset: -6% 0;
		z-index: -2;
	}
	.plate-video {
		width: 100%;
		height: 100%;
		object-fit: cover;
		/* El sujeto vive en el 45–68% del ancho y su cabeza en el tercio
		   superior: se encuadra a la derecha y arriba. */
		object-position: 68% 20%;
	}
	.plate-scrim {
		position: absolute;
		inset: 0;
		z-index: -1;
		background:
			linear-gradient(90deg, rgba(10, 8, 5, 0.9) 0%, rgba(10, 8, 5, 0.62) 34%, rgba(10, 8, 5, 0.1) 62%, transparent 80%),
			linear-gradient(0deg, rgba(10, 8, 5, 0.96) 0%, rgba(10, 8, 5, 0.55) 30%, transparent 58%);
		transition: opacity var(--dur-md, 500ms) var(--pa-ease);
	}
	.plate-copy {
		width: 100%;
		display: grid;
		gap: clamp(18px, 2.4vw, 30px);
		padding-top: var(--pa-hero-pad);
		padding-bottom: clamp(100px, 12vh, 140px);
		transition: opacity var(--dur-md, 500ms) var(--pa-ease);
	}
	.plate-title {
		font-size: clamp(42px, min(6.6vw, 12.5vh), 128px);
		line-height: 0.98;
		letter-spacing: -0.045em;
		color: #fff;
		max-width: 17ch;
	}
	.plate-row {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-end;
		gap: 24px 40px;
	}
	.plate-sub {
		max-width: 36ch;
	}

	.plate-foot {
		position: absolute;
		inset: auto 0 0 0;
		border-top: 1px solid var(--pa-line-strong);
		background: linear-gradient(0deg, rgba(10, 8, 5, 0.5), transparent);
	}
	.plate-foot-in {
		display: flex;
		align-items: center;
		gap: 20px;
		padding-top: 16px;
		padding-bottom: 16px;
	}
	.plate-sound {
		min-height: 44px;
		display: inline-flex;
		align-items: center;
		gap: 9px;
		padding: 9px 16px 9px 12px;
		border: 1px solid rgba(233, 237, 255, 0.3);
		border-radius: 999px;
		background: rgba(11, 14, 23, 0.5);
		backdrop-filter: blur(10px);
		color: var(--ink-hi);
		font-family: var(--pa-mono);
		font-size: 11.5px;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		font-weight: 500;
		cursor: pointer;
		transition:
			background 250ms var(--pa-ease),
			border-color 250ms var(--pa-ease),
			color 250ms var(--pa-ease);
	}
	.plate-sound:hover {
		background: var(--pa-accent);
		border-color: var(--pa-accent);
		color: var(--pa-ink);
	}
	.plate-sound:focus-visible {
		outline: 2px solid var(--pa-accent);
		outline-offset: 3px;
	}
	.plate-sound-ico {
		display: grid;
		place-items: center;
		width: 15px;
		height: 15px;
	}
	[data-wave] {
		opacity: 0.35;
		transition: opacity 250ms;
	}
	.plate.is-loud [data-wave] {
		opacity: 1;
	}
	/* ecualizador decorativo: se mueve sólo con sonido */
	.plate-eq {
		display: inline-flex;
		align-items: flex-end;
		gap: 3px;
		height: 14px;
	}
	.plate-eq i {
		width: 2px;
		height: 100%;
		background: var(--pa-accent);
		transform-origin: 50% 100%;
		transform: scaleY(0.25);
	}
	.plate.is-loud .plate-eq i {
		animation: eq 900ms ease-in-out infinite alternate;
	}
	.plate.is-loud .plate-eq i:nth-child(2) { animation-delay: -200ms; }
	.plate.is-loud .plate-eq i:nth-child(3) { animation-delay: -500ms; }
	.plate.is-loud .plate-eq i:nth-child(4) { animation-delay: -100ms; }
	.plate.is-loud .plate-eq i:nth-child(5) { animation-delay: -700ms; }
	@keyframes eq {
		to {
			transform: scaleY(1);
		}
	}
	.plate-credit {
		margin-left: auto;
		color: var(--ink-low);
		text-align: right;
	}
	/* Con sonido: aparecen los controles nativos y la copia se corre. */
	.plate.is-loud .plate-scrim,
	.plate.is-loud .plate-copy {
		opacity: 0;
		pointer-events: none;
	}
	.plate.is-loud .plate-foot {
		inset: 0 0 auto 0;
		border-top: 0;
		background: none;
	}
	.plate.is-loud .plate-credit {
		display: none;
	}

	/* ================= AYAX ================= */
	.neg-ayax {
		background: var(--color-cap-2, #0a0805);
		padding: clamp(40px, 6vw, 80px) 0 clamp(96px, 12vw, 168px);
	}
	.ayax-body {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		gap: clamp(30px, 5vw, 88px);
		align-items: start;
		margin-top: clamp(80px, 10vw, 150px);
	}
	.ayax-col {
		display: flex;
		flex-direction: column;
		gap: 48px;
	}
	.ayax-media {
		margin: 0;
	}
	.ayax-video-box {
		aspect-ratio: 16 / 9;
		--pa-crop-o: -10px;
	}
	.ayax-video {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		border-radius: var(--pa-r-lg);
	}

	/* ================= cifras (data-counter) ================= */
	.stat-strip {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 0;
		margin: 0;
		border-top: 1px solid var(--pa-line-strong);
		border-bottom: 1px solid var(--pa-line-strong);
	}
	.stat {
		padding: clamp(26px, 3vw, 44px) clamp(16px, 2vw, 32px);
		margin: 0;
		--pa-crop-o: -1px;
		--pa-crop-c: rgb(232 200 116 / 0.55);
		--pa-crop-s: 10px;
	}
	.stat + .stat {
		border-left: 1px solid var(--pa-line);
	}
	.stat-value {
		font-size: clamp(52px, 6vw, 112px);
		line-height: 0.9;
		letter-spacing: -0.05em;
		color: #fff;
		font-variant-numeric: tabular-nums;
		margin: 0;
	}
	.stat:nth-child(2) .stat-value {
		color: var(--pa-accent);
	}
	.stat-label {
		color: var(--ink-low);
		margin: 18px 0 0;
		max-width: 22ch;
	}

	/* ================= citas ================= */
	.q {
		margin: 0;
		padding-left: 24px;
		border-left: 1px solid var(--pa-accent);
	}
	.q.pa-quote blockquote {
		font-size: clamp(24px, 1.1rem + 1.4vw, 40px);
		line-height: 1.16;
	}
	.q--sm.pa-quote blockquote {
		font-size: clamp(20px, 1rem + 0.8vw, 28px);
		line-height: 1.24;
	}
	.row-panel .q,
	.subfrente .q {
		margin-top: 34px;
	}
	.body-text {
		font-size: var(--text-body, 17px);
		line-height: 1.68;
