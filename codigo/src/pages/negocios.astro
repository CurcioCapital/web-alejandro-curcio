	}
	.neg-cierre .wrap {
		display: grid;
		gap: 28px;
	}
	.neg-cierre-title {
		font-size: clamp(46px, 9vw, 176px);
		color: #fff;
	}
	.neg-cierre-foot {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-end;
		justify-content: space-between;
		gap: 28px;
		padding-top: 28px;
		border-top: 1px solid var(--pa-line-strong);
