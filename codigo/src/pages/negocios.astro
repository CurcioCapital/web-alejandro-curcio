		transition: background 300ms var(--pa-ease), transform 500ms var(--pa-ease);
	}
	.pillar:hover {
		background: var(--pa-ink);
		transform: translateY(-4px);
	}
	.pillar:hover .pillar-title {
		color: var(--pa-accent);
	}
	.pillar:hover .pillar-body {
		color: rgb(255 255 255 / 0.7);
	}
	.pillar-title {
		font-family: var(--pa-display);
		font-weight: var(--display-wght, 560);
		letter-spacing: -0.03em;
		font-size: 24px;
		line-height: 1.05;
		color: var(--pa-ink);
