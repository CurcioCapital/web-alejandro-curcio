		margin: 26px 0 0;
	}
	.body-text b {
		color: var(--ink-hi);
		font-weight: 600;
	}
	.media-caption {
		font-size: 13.5px;
		line-height: 1.55;
		color: var(--ink-low);
		margin: 16px 0 0;
		max-width: 58ch;
	}

	/* ================= sub-frente bZ4X ================= */
	.subfrente {
		display: grid;
		grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
		gap: clamp(24px, 5vw, 88px);
		margin: clamp(80px, 10vw, 140px) 0 0;
		padding: 36px 0 0;
		border-top: 1px solid var(--pa-line-strong);
	}
	.subfrente-tag {
		display: block;
		color: var(--pa-accent);
	}
	.subfrente-title {
		font-size: clamp(44px, 6vw, 108px);
		color: #fff;
		margin: 16px 0 0;
	}
	/* barra de carga decorativa: se llena con el scroll (data-scrub en Base) */
	.subfrente-gauge {
		display: block;
		position: relative;
		height: 2px;
		margin-top: 28px;
		max-width: 280px;
		background: rgb(255 255 255 / 0.14);
		overflow: hidden;
	}
	.subfrente-gauge i {
		position: absolute;
		inset: 0;
		background: var(--pa-accent);
		transform-origin: 0 50%;
		animation: gauge 3.2s var(--pa-ease) infinite;
	}
	@keyframes gauge {
		0% { transform: scaleX(0); }
		70%, 100% { transform: scaleX(1); opacity: 0.2; }
	}
	.subfrente-body .body-text:first-child {
		margin-top: 0;
	}

	/* ================= ticker de medios ================= */
	.neg-ticker {
		background: var(--pa-bg);
		border-top: 1px solid var(--pa-line);
		padding: clamp(22px, 3vw, 40px) 0;
	}
	.neg-ticker-item {
		display: inline-flex;
		align-items: center;
		gap: clamp(28px, 4vw, 64px);
		padding-right: clamp(28px, 4vw, 64px);
		font-size: clamp(44px, 7vw, 128px);
		color: transparent;
		-webkit-text-stroke: 1px rgb(255 255 255 / 0.4);
		line-height: 1;
	}
	.neg-ticker-item:nth-child(even) {
		color: #fff;
		-webkit-text-stroke: 0;
	}
	.neg-ticker-item i {
		font-style: normal;
		font-size: 0.3em;
		color: var(--pa-accent);
		-webkit-text-stroke: 0;
	}

	/* ================= filas / tarjetas ================= */
	.neg-mas .pa-cap-head {
		max-width: 1100px;
	}
	.rows {
		display: grid;
		gap: 14px;
	}
	.row {
		border-radius: var(--pa-r-lg);
		background: #fff;
		box-shadow: inset 0 0 0 1px var(--pa-line-light);
		transition: box-shadow 400ms var(--pa-ease), background 400ms var(--pa-ease);
	}
	.row:hover,
	.row[open] {
		box-shadow: inset 0 0 0 1px rgb(11 14 23 / 0.22);
	}
	.row-head {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto auto auto;
		align-items: center;
		gap: clamp(16px, 2.4vw, 36px);
		padding: clamp(22px, 2.6vw, 34px) clamp(20px, 2.6vw, 40px);
		cursor: pointer;
		list-style: none;
		color: var(--pa-ink);
	}
	.row-head::-webkit-details-marker {
		display: none;
	}
	.row-head:focus-visible {
		outline: 2px solid var(--pa-accent-ink);
		outline-offset: 3px;
		border-radius: var(--pa-r-lg);
	}
	.row-text {
		display: flex;
		flex-direction: column;
		gap: 12px;
		min-width: 0;
	}
	.row-name {
		font-size: clamp(36px, 5vw, 92px);
		color: var(--pa-ink);
		transition: color 300ms var(--pa-ease), transform 600ms var(--pa-ease);
		transform-origin: 0 50%;
	}
	.row-head:hover .row-name {
		transform: translateX(10px);
	}
	.row[open] .row-name {
		color: var(--pa-accent-ink);
	}
	.row-hook {
		font-size: 15px;
		line-height: 1.45;
		color: rgb(11 14 23 / 0.62);
	}
	.row-tag {
		color: rgb(11 14 23 / 0.6);
		white-space: nowrap;
	}
	/* Preview de medio: crece en hover; el de HY Project reproduce video. */
	.row-thumb {
		position: relative;
		display: block;
		width: clamp(140px, 16vw, 260px);
		aspect-ratio: 16 / 10;
		border-radius: 18px;
		overflow: hidden;
		background: var(--pa-ink);
		transform: scale(0.92) rotate(-2deg);
		transition: transform 700ms var(--pa-ease);
	}
	.row-head:hover .row-thumb,
	.row[open] .row-thumb {
		transform: scale(1) rotate(0deg);
	}
	.row-thumb img,
	.row-thumb video {
		position: absolute;
		inset: 0;
		width: 100%;
