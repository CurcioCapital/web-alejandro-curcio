</style>

<script>
	// Video de surf de El Nido: corre sólo con la fila abierta y en pantalla.
	document.querySelectorAll<HTMLVideoElement>('[data-nido-video]').forEach((nido) => {
	const fila = nido.closest('details');
	if (fila) {
		const prm = matchMedia('(prefers-reduced-motion: reduce)');
		let raf = 0;
		const check = () => {
			raf = 0;
			const r = nido.getBoundingClientRect();
			const ver = fila.open && r.bottom > 0 && r.top < innerHeight && !prm.matches;
			if (ver && nido.paused) nido.play().catch(() => {});
			else if (!ver && !nido.paused) nido.pause();
		};
		const pedir = () => { if (!raf) raf = requestAnimationFrame(check); };
		fila.addEventListener('toggle', () => setTimeout(check, 350));
		addEventListener('scroll', pedir, { passive: true });
		addEventListener('resize', pedir, { passive: true });
	}
	});
</script>

<script>
	// Hero: el loop entra mudo (autoplay sólo funciona así). El botón lo
	// reinicia con sonido, muestra los controles nativos y enciende los
	// subtítulos; volver a tocarlo lo devuelve a loop ambiente.
	document.querySelectorAll<HTMLElement>('[data-hero-video]').forEach((card) => {
		const video = card.querySelector('video');
		const btn = card.querySelector<HTMLButtonElement>('[data-sound-toggle]');
		const label = card.querySelector<HTMLElement>('[data-sound-label]');
		if (!video || !btn || !label) return;

		const setCaptions = (on: boolean) => {
			const tracks = video.textTracks;
			for (let i = 0; i < tracks.length; i++) tracks[i].mode = on ? 'showing' : 'disabled';
		};
		setCaptions(false);

		// Dos fuentes: el loop corto de ambiente y el clip completo con audio.
		// `data-full` guarda el segundo; el primero es el src inicial.
		const loopSrc = video.getAttribute('src')!;
		const fullSrc = video.dataset.full || loopSrc;

		const aAmbiente = () => {
			card.classList.remove('is-loud');
			video.controls = false;
			video.muted = true;
			video.loop = true;
			setCaptions(false);
			label.textContent = 'Escuchar el discurso';
			if (video.getAttribute('src') !== loopSrc) {
				video.setAttribute('src', loopSrc);
				video.load();
			}
			video.play().catch(() => {});
		};

		btn.addEventListener('click', () => {
			const vaConSonido = video.muted;
			if (!vaConSonido) {
				aAmbiente();
				return;
			}
			card.classList.add('is-loud');
			video.setAttribute('src', fullSrc);
			video.load();
			video.muted = false;
			video.controls = true;
			video.loop = false;
			label.textContent = 'Volver';
			// Los subtítulos hay que re-armarlos después de cambiar la fuente.
			video.addEventListener('loadeddata', () => setCaptions(true), { once: true });
			video.play().catch(() => {
				/* si el navegador lo rechaza quedan los controles nativos */
			});
		});

		// Al terminar el discurso vuelve solo al loop ambiente.
		video.addEventListener('ended', aAmbiente);
	});

	// Los videos decorativos no cargan hasta acercarse al viewport: con
	// autoplay puro el navegador se baja el archivo aunque esté a tres
	// pantallas de distancia.
	// Se resuelve midiendo la caja en scroll (rAF-throttled) y no con
	// IntersectionObserver: es una comprobación trivial, sin dependencias, y
	// funciona igual en entornos donde el observer no se dispara.
	const lazyVideos = [...document.querySelectorAll<HTMLVideoElement>('[data-lazy-video]')];
	if (lazyVideos.length) {
		const MARGEN = 300; // px antes de entrar en pantalla
		let rafLazy = 0;
		const revisar = () => {
			rafLazy = 0;
			for (const v of lazyVideos) {
				const r = v.getBoundingClientRect();
				const cerca = r.top < window.innerHeight + MARGEN && r.bottom > -MARGEN;
				if (cerca) {
					if (!v.getAttribute('src')) v.setAttribute('src', v.dataset.lazyVideo!);
					if (v.paused) v.play().catch(() => {});
				} else if (!v.paused) {
					v.pause();
				}
			}
		};
		const agendar = () => {
			if (!rafLazy) rafLazy = requestAnimationFrame(revisar);
		};
		addEventListener('scroll', agendar, { passive: true });
		addEventListener('resize', agendar, { passive: true });
		agendar();
	}

	// El iframe de Vimeo se inserta cuando se ABRE la fila que lo contiene:
	// ni al cargar la página (sería un embed de terceros que quizá nadie mire)
	// ni pidiendo un segundo clic (desplegar «El Nido» ya es intención). Mudo,
	// porque es la única forma de que el navegador permita el autoplay.
	function montarVimeo(box: HTMLElement) {
		if (box.classList.contains('is-playing')) return;
		const id = box.dataset.vimeo!;
		const params = new URLSearchParams({
			autoplay: '1',
			muted: '1',
			dnt: '1',
			title: '0',
			byline: '0',
			portrait: '0',
		});
		if (box.dataset.vimeoHash) params.set('h', box.dataset.vimeoHash);
		const iframe = document.createElement('iframe');
		// El salto al minuto va en el fragmento (#t=), no en la query.
		iframe.src = `https://player.vimeo.com/video/${id}?${params}#t=${box.dataset.vimeoStart || '0'}s`;
		iframe.allow = 'autoplay; fullscreen; picture-in-picture';
		iframe.setAttribute('allowfullscreen', '');
		iframe.title = 'Video de El Nido';
		box.classList.add('is-playing');
		box.appendChild(iframe);
	}

	// Abrir la fila que pide el hash (#curcio-capital, #el-nido, #hy-project)
	// y pausar el video de una fila al cerrarla.
	document.querySelectorAll<HTMLDetailsElement>('.row').forEach((row) => {
		const vimeoBox = row.querySelector<HTMLElement>('[data-vimeo]');
		if (location.hash === `#${row.id}`) row.open = true;
		if (row.open && vimeoBox) montarVimeo(vimeoBox);
		row.addEventListener('toggle', () => {
			if (row.open) {
				if (vimeoBox) montarVimeo(vimeoBox);
			} else {
				row.querySelectorAll('video').forEach((v) => v.pause());
			}
		});
	});
	window.addEventListener('hashchange', () => {
		// location.hash trae el '#', así que getElementById con el slice es más
		// seguro que armar un selector (los ids con guiones no necesitan escape,
		// pero un selector `.row#...` concatenado se rompe fácil).
		const el = document.getElementById(decodeURIComponent(location.hash.slice(1)));
		if (el instanceof HTMLDetailsElement && el.classList.contains('row')) el.open = true;
	});

	// Preview de video en la tarjeta de HY Project: carga y reproduce en
	// hover (o foco de teclado), pausa al salir. Nada se baja hasta el hover.
	// Con reduced-motion queda el póster.
	const prmThumb = matchMedia('(prefers-reduced-motion: reduce)');
	document.querySelectorAll<HTMLElement>('[data-thumb-video]').forEach((thumb) => {
		const v = thumb.querySelector('video');
		const head = thumb.closest('summary');
		if (!v || !head) return;
		const on = () => {
			if (prmThumb.matches) return;
			if (!v.getAttribute('src') && v.dataset.src) v.setAttribute('src', v.dataset.src);
			v.play().then(() => thumb.classList.add('is-playing')).catch(() => {});
		};
		const off = () => {
			v.pause();
			thumb.classList.remove('is-playing');
		};
		head.addEventListener('pointerenter', on);
		head.addEventListener('pointerleave', off);
		head.addEventListener('focus', on);
		head.addEventListener('blur', off);
	});
</script>
