---
/**
 * preguntale.astro — el chat, ya conectado.
 *
 * Hasta el 14/10/2026 esto era una maqueta: un form que hacía GET a sí
 * mismo. El corpus (319 fragmentos embebidos), el prompt del sistema y los
 * ayudantes de recuperación ya existían; faltaba el endpoint —ahora en
 * src/pages/api/chat.js— y esta interfaz.
 *
 * La home entrega la pregunta por ?q= y acá se dispara sola al cargar.
 *
 * IDENTIFICACIÓN VISIBLE COMO IA: la exige la regla 3 del proyecto para
 * todo lo que hable de Ale generado por IA. Está en el aviso de arriba y
 * repetida al pie del hilo, no escondida en una nota legal.
 *
 * La clave de API NO llega acá: el navegador sólo habla con /api/chat.
 */
import Base from '../layouts/Base.astro';
import '../components/secciones/libros/ed.css';

const chips = [
  '¿Qué es el capital de vida?',
  '¿Cómo ve el futuro del trabajo con la IA?',
  '¿Qué aprendió en los 80 años de AYAX?',
];
---

<Base
  title="Preguntale a Ale — Alejandro Curcio"
  description="Un chat entrenado con sus libros y su prensa. Responde sólo con lo que Alejandro publicó."
>
  <section class="pg ed-grid">
    <div class="pg-glow" aria-hidden="true"></div>
    <div class="ed-wrap pg-grid">
      <div class="pg-head">
        <div class="pg-top ed-mono">
          <span class="kicker pg-k">El chat</span>
          <span class="pg-n" aria-hidden="true">[ IA ]</span>
        </div>
        <h1 class="pg-title ed-display" data-split="lines">Preguntale a Ale.</h1>
        <p class="pg-lead" data-reveal>
          Responde a partir de sus dos libros, su prensa y su cronología. Si la respuesta no está en
          ese archivo, lo dice en vez de inventarla.
        </p>
        <p class="pg-aviso" data-reveal>
          <strong>Esto es una IA</strong>, no es Alejandro. Habla <em>sobre</em> él, nunca en su
          nombre, y cita de dónde sale cada cosa.
        </p>
      </div>

      <div class="pg-term ed-crop" id="terminal" data-estado="listo">
        <div class="pg-bar ed-mono" aria-hidden="true">
          <span class="pg-dots"><i></i><i></i><i></i></span>
          <span class="pg-bar-t">preguntale — IA</span>
          <span class="pg-status">
            <i></i>
            <b class="s-listo">Listo</b>
            <b class="s-buscando">Buscando</b>
            <b class="s-error">Error</b>
          </span>
        </div>

        <div class="pg-screen">
          <div class="pg-empty ed-mono" aria-hidden="true">
            <span>&gt;</span><span class="pg-caret"></span>
          </div>
          <div class="pg-hilo" id="hilo" aria-live="polite" aria-label="Conversación" data-lenis-prevent></div>
        </div>

        <div class="pg-pie">
          <div class="pg-chips" id="chips">
            {chips.map((c) => <button class="pg-chip" type="button" data-chip>{c}</button>)}
          </div>

          <form class="pg-form" id="form" autocomplete="off">
            <span class="pg-prompt ed-mono" aria-hidden="true">&gt;</span>
            <input
              id="preguntale-input"
              class="pg-input"
              type="text"
              name="q"
              maxlength="500"
              placeholder="¿Qué es el capital de vida?"
              aria-label="Tu pregunta sobre Alejandro"
              required
            />
            <button class="pg-send" type="submit" aria-label="Enviar pregunta" data-magnetic>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </button>
          </form>
        </div>
      </div>
      <p class="pg-micro ed-mono">Respuestas generadas por IA a partir del archivo verificado de Alejandro Curcio.</p>
    </div>
  </section>
</Base>

<style>
  .pg {
    position: relative;
    isolation: isolate;
    background: var(--ed-bg);
    color: #fff;
    min-height: 100svh;
    padding: clamp(120px, 15vh, 180px) 0 clamp(56px, 7vw, 110px);
    overflow: clip;
  }
  .pg-glow {
    position: absolute;
    inset: 10% -20% auto 40%;
    height: 80%;
    z-index: -1;
    background: radial-gradient(closest-side, rgb(232 200 116 / 0.12), transparent 70%);
    pointer-events: none;
  }
  .pg-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    grid-template-areas:
      'head term'
      '.    micro';
    gap: 16px clamp(32px, 5vw, 88px);
    align-items: start;
  }
  .pg-head {
    grid-area: head;
    position: sticky;
    top: 110px;
  }
  .pg-top {
    display: flex;
    justify-content: space-between;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--ed-line-strong);
  }
  .pg-k {
    margin: 0;
    font: inherit;
    letter-spacing: inherit;
    color: var(--ed-accent);
  }
  .pg-n {
    color: rgb(255 255 255 / 0.45);
  }
  .pg-title {
    font-size: clamp(3rem, 0.8rem + 5.6vw, 7.5rem);
    line-height: 0.96;
    letter-spacing: -0.05em;
    margin: clamp(24px, 3vw, 40px) 0 0;
    color: #fff;
    max-width: 8ch;
  }
  .pg-lead {
    font-size: var(--text-lead, 1.125rem);
    line-height: 1.55;
    color: rgb(255 255 255 / 0.7);
    margin: 24px 0 0;
    max-width: 44ch;
  }
  .pg-aviso {
    margin: 22px 0 0;
    padding: 14px 16px;
    border: 1px solid rgb(232 200 116 / 0.35);
    border-left: 3px solid var(--ed-accent);
    border-radius: 6px;
    background: rgb(232 200 116 / 0.06);
    font-size: 14px;
    line-height: 1.5;
    color: rgb(255 255 255 / 0.75);
    max-width: 48ch;
  }
  .pg-aviso strong { color: #fff; }

  /* ---- terminal ---- */
  .pg-term {
    grid-area: term;
    display: flex;
    flex-direction: column;
    border-radius: 20px;
    border: 1px solid var(--ed-line-strong);
    background:
      repeating-linear-gradient(180deg, rgb(255 255 255 / 0.018) 0 1px, transparent 1px 4px),
      linear-gradient(180deg, #14100a, #0e0b07);
    box-shadow: 0 40px 100px rgb(0 0 0 / 0.5), inset 0 1px 0 rgb(255 255 255 / 0.06);
    min-height: min(72svh, 680px);
  }
  .pg-bar {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 18px;
    border-bottom: 1px solid var(--ed-line-strong);
    color: rgb(255 255 255 / 0.5);
  }
  .pg-dots { display: inline-flex; gap: 6px; }
  .pg-dots i {
    width: 9px; height: 9px; border-radius: 50%;
    background: rgb(255 255 255 / 0.16);
  }
  .pg-dots i:first-child { background: var(--ed-accent); }
  .pg-bar-t { margin-right: auto; }
  .pg-status { display: inline-flex; align-items: center; gap: 8px; }
  .pg-status i {
    width: 7px; height: 7px; border-radius: 50%;
    background: #8fd18a;
    box-shadow: 0 0 0 3px rgb(143 209 138 / 0.15);
  }
  .pg-status b { font-weight: 500; display: none; }
  .pg-term[data-estado='listo'] .s-listo,
  .pg-term[data-estado='buscando'] .s-buscando,
  .pg-term[data-estado='error'] .s-error { display: inline; }
  .pg-term[data-estado='buscando'] .pg-status i {
    background: var(--ed-accent);
    box-shadow: 0 0 0 3px rgb(232 200 116 / 0.2);
    animation: pg-pulse 1s ease-in-out infinite;
  }
  .pg-term[data-estado='error'] .pg-status i {
    background: #e2776b;
    box-shadow: 0 0 0 3px rgb(226 119 107 / 0.18);
  }
  @keyframes pg-pulse { 50% { opacity: 0.3; } }

  .pg-screen {
    position: relative;
    flex: 1;
    padding: 22px clamp(16px, 2.4vw, 28px);
    min-height: 220px;
    max-height: 60svh;
    overflow-y: auto;
  }
  .pg-empty {
    display: flex;
    gap: 10px;
    align-items: center;
    color: var(--ed-accent);
    font-size: 14px;
  }
  .pg-term.has-msgs .pg-empty { display: none; }
  .pg-caret {
    width: 9px;
    height: 17px;
    background: var(--ed-accent);
    animation: pg-blink 1.1s steps(2, start) infinite;
  }
  @keyframes pg-blink { to { visibility: hidden; } }

  /* ---- hilo ---- */
  .pg-hilo { display: flex; flex-direction: column; gap: 22px; }
  .pg-hilo :global(.pg-msg) { max-width: 54rem; }
  .pg-hilo :global(.pg-msg--yo) {
    align-self: stretch;
    display: flex;
    gap: 10px;
    font-family: var(--ed-mono);
    font-size: 14px;
    line-height: 1.55;
    color: #fff;
    padding: 0;
    background: none;
    border: 0;
  }
  .pg-hilo :global(.pg-msg--yo)::before {
    content: '>';
    color: var(--ed-accent);
    flex: none;
  }
  .pg-hilo :global(.pg-msg--ale) {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 16px 18px;
    border-radius: 12px;
    background: rgb(255 255 255 / 0.04);
    border: 1px solid var(--ed-line-strong);
    animation: pg-in 0.6s var(--ed-expo) both;
  }
  .pg-hilo :global(.pg-msg--ale)::before {
    content: 'IA';
    align-self: flex-start;
    font-family: var(--ed-mono);
    font-size: 10.5px;
    letter-spacing: 0.1em;
    padding: 3px 7px;
    border-radius: 4px;
    background: var(--ed-accent);
    color: var(--ed-ink);
  }
  @keyframes pg-in {
    from { opacity: 0; transform: translateY(10px); }
  }
  .pg-hilo :global(.pg-cuerpo) {
    font-size: 1rem;
    line-height: 1.68;
    color: rgb(255 255 255 / 0.9);
  }
  .pg-hilo :global(.pg-cuerpo p) { margin: 0 0 12px; }
  .pg-hilo :global(.pg-cuerpo p:last-child) { margin-bottom: 0; }
  .pg-hilo :global(.pg-cuerpo em) { font-style: italic; }
  .pg-hilo :global(.pg-fuentes) {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding-top: 10px;
    border-top: 1px solid var(--ed-line-strong);
  }
  .pg-hilo :global(.pg-fuente) {
    font-family: var(--ed-mono);
    font-size: 11px;
    letter-spacing: 0.02em;
    color: rgb(255 255 255 / 0.6);
    border: 1px solid var(--ed-line-strong);
    border-radius: 4px;
    padding: 4px 8px;
  }
  .pg-hilo :global(.pg-pensando) {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--ed-mono);
    font-size: 13px;
    color: var(--ed-accent);
  }
  .pg-hilo :global(.pg-pensando)::before {
    content: '';
    width: 14px;
    height: 14px;
    border-radius: 50%;
    border: 1.5px solid rgb(232 200 116 / 0.3);
    border-top-color: var(--ed-accent);
    animation: pg-spin 0.8s linear infinite;
  }
  @keyframes pg-spin { to { transform: rotate(360deg); } }
  .pg-hilo :global(.pg-error) {
    font-family: var(--ed-mono);
    font-size: 13px;
    line-height: 1.5;
    color: #f0b2a9;
    border-left: 2px solid #e2776b;
    padding-left: 12px;
  }

  /* ---- pie ---- */
  .pg-pie {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 16px clamp(14px, 2vw, 22px) 18px;
    border-top: 1px solid var(--ed-line-strong);
  }
  .pg-chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .pg-chip {
    min-height: 44px;
    font-family: var(--ed-mono);
    font-size: 12px;
    letter-spacing: 0.01em;
    color: rgb(255 255 255 / 0.75);
    background: transparent;
    border: 1px solid var(--ed-line-strong);
    border-radius: 6px;
    padding: 8px 12px;
    cursor: pointer;
    text-align: left;
    transition: border-color 0.3s var(--ed-expo), color 0.3s var(--ed-expo), background 0.3s var(--ed-expo);
  }
  .pg-chip:hover { border-color: var(--ed-accent); color: #fff; background: rgb(232 200 116 / 0.08); }
  .pg-chip:focus-visible { outline: 2px solid var(--ed-accent); outline-offset: 2px; }
  .pg-form {
    display: flex;
    gap: 10px;
    align-items: center;
    padding: 6px 6px 6px 16px;
    border: 1px solid var(--ed-line-strong);
    border-radius: 12px;
    background: rgb(0 0 0 / 0.3);
    transition: border-color 0.3s var(--ed-expo);
  }
  .pg-form:focus-within { border-color: var(--ed-accent); }
  .pg-prompt { color: var(--ed-accent); font-size: 14px; }
  .pg-input {
    flex: 1;
    min-width: 0;
    background: transparent;
    border: 0;
    padding: 12px 4px;
    font-family: var(--ed-mono);
    font-size: 14px;
    color: #fff;
    caret-color: var(--ed-accent);
  }
  .pg-input::placeholder { color: rgb(255 255 255 / 0.4); }
  .pg-input:focus { outline: none; }
  .pg-send {
    flex-shrink: 0;
    width: 44px; height: 44px;
    border-radius: 8px;
    display: grid; place-items: center;
    background: var(--ed-accent);
    color: var(--ed-ink);
    cursor: pointer;
    border: 0;
    transition: background 0.3s var(--ed-expo);
  }
  .pg-send:hover:not(:disabled) { background: #fff; }
  .pg-send:focus-visible { outline: 2px solid #fff; outline-offset: 2px; }
  .pg-send:disabled { opacity: 0.45; cursor: default; }
  .pg-micro {
    grid-area: micro;
    color: rgb(255 255 255 / 0.5);
    margin: 4px 0 0;
    text-transform: none;
    letter-spacing: 0.02em;
  }

  @media (max-width: 900px) {
    .pg-grid {
      grid-template-columns: 1fr;
      grid-template-areas: 'head' 'term' 'micro';
    }
    .pg-head { position: static; }
    .pg-term { min-height: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .pg-caret,
    .pg-term[data-estado='buscando'] .pg-status i,
    .pg-hilo :global(.pg-msg--ale),
    .pg-hilo :global(.pg-pensando)::before { animation: none; }
  }
</style>

<script>
  const hilo = document.getElementById('hilo');
  const form = document.getElementById('form') as HTMLFormElement | null;
  const input = document.getElementById('preguntale-input') as HTMLInputElement | null;
  const enviar = form?.querySelector('.pg-send') as HTMLButtonElement | null;

  const term = document.getElementById('terminal');
  /** Estado visible de la terminal (sólo UI): listo · buscando · error. */
  const estado = (e: 'listo' | 'buscando' | 'error') => {
    if (term) term.dataset.estado = e;
  };

  if (hilo && form && input) {
    let ocupado = false;

    const nodo = (cls: string, texto?: string) => {
      const el = document.createElement('div');
      el.className = cls;
      if (texto) el.textContent = texto;
      return el;
    };

    /** Párrafos + *cursivas*. Se arma con createElement y textContent, nunca
     *  con innerHTML: lo que vuelve del modelo es texto, no markup. */
    const pintarCuerpo = (texto: string) => {
      const cont = nodo('pg-cuerpo');
      for (const parrafo of texto.split(/\n{2,}/)) {
        const p = document.createElement('p');
        for (const [i, trozo] of parrafo.split(/\*([^*]+)\*/g).entries()) {
          if (!trozo) continue;
          if (i % 2 === 1) {
            const em = document.createElement('em');
            em.textContent = trozo;
            p.appendChild(em);
          } else {
            p.appendChild(document.createTextNode(trozo));
          }
        }
        cont.appendChild(p);
      }
      return cont;
    };

    async function preguntar(pregunta: string) {
      if (ocupado || !pregunta.trim()) return;
      ocupado = true;
      if (enviar) enviar.disabled = true;
      estado('buscando');
      term?.classList.add('has-msgs');

      hilo.appendChild(nodo('pg-msg pg-msg--yo', pregunta));
      const pensando = nodo('pg-pensando', 'Buscando en el archivo…');
      hilo.appendChild(pensando);
      pensando.scrollIntoView({ block: 'nearest', behavior: 'smooth' });

      try {
        const res = await fetch('/api/chat', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ pregunta }),
        });
        const datos = await res.json();
        pensando.remove();

        if (!res.ok || datos.error) {
          hilo.appendChild(nodo('pg-error', datos.error ?? 'No se pudo responder.'));
          estado('error');
        } else {
          estado('listo');
          const bloque = nodo('pg-msg pg-msg--ale');
          bloque.appendChild(pintarCuerpo(datos.respuesta));
          if (datos.fuentes?.length) {
            const fs = nodo('pg-fuentes');
            for (const f of datos.fuentes) fs.appendChild(nodo('pg-fuente', f.detail));
            bloque.appendChild(fs);
          }
          hilo.appendChild(bloque);
          bloque.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
        }
      } catch {
        pensando.remove();
        hilo.appendChild(nodo('pg-error', 'Se cortó la conexión. Probá de nuevo.'));
        estado('error');
      } finally {
        ocupado = false;
        if (enviar) enviar.disabled = false;
      }
    }

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const q = input.value;
      input.value = '';
      preguntar(q);
    });

    document.querySelectorAll<HTMLButtonElement>('[data-chip]').forEach((chip) => {
      chip.addEventListener('click', () => preguntar(chip.textContent ?? ''));
    });

    // La home entrega la pregunta por ?q= — se dispara sola.
    const q = new URLSearchParams(location.search).get('q');
    if (q) preguntar(q);
  }
</script>
