    else if (m.status === 'stopped') say('Respuesta detenida.');
    else say('Respuesta de Ale (IA): ' + plain(m.content));
    if (!coarse) input.focus({ preventScroll: true });
  }

  /* ---------------------------------------------------------------- nueva */
  btnNew.addEventListener('click', function () {
    if (ctrl) ctrl.abort();
    msgs = [];
    save();
    var go = function () {
      log.replaceChildren();
      setMode();
      scroller.scrollTop = 0;
