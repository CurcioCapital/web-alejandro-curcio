  /* ------------------------------------------------------------- red / SSE */
  function errorFor(status, msg) {
    if (status === 429) return { title: 'Esperá un ratito.', text: msg || 'Hubo muchas preguntas seguidas. En unos segundos podés volver a intentar.', wait: 15 };
    if (status === 'net') return { title: 'Se cortó la conexión.', text: 'Revisá tu conexión y probá de nuevo.' };
    if (status === 404 || status === 405) return { title: 'El chat no está disponible.', text: 'Probá de nuevo más tarde.' };
    return { title: 'No se pudo responder.', text: msg || 'Probá de nuevo en un rato.' };
  }
  function HttpErr(status, msg) { this.status = status; this.msg = msg; }

  async function readJsonError(res) {
    var d = null;
    try { d = await res.json(); } catch (e) {}
    return new HttpErr(res.status, d && d.error);
  }

  /** Pide la respuesta. Llama a on.meta(fuentes), on.delta(t). Devuelve al terminar. */
  async function request(body, on, signal) {
    var res = await fetch(API, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', Accept: 'text/event-stream' },
      body: JSON.stringify(body),
      signal: signal
    });
    if (!res.ok) throw await readJsonError(res);
    var ct = res.headers.get('content-type') || '';
    if (ct.indexOf('event-stream') === -1 || !res.body || !res.body.getReader) {
      var d = await res.json();
      if (d.error) throw new HttpErr(res.status, d.error);
      on.meta(d.fuentes || []);
      on.delta(d.respuesta || '');
      return;
    }
    var reader = res.body.getReader();
    var dec = new TextDecoder();
    var buf = '';
    var gotDone = false;
    for (;;) {
      var r = await reader.read();
      if (r.done) break;
      buf += dec.decode(r.value, { stream: true });
      var parts = buf.split(/\r?\n\r?\n/);
      buf = parts.pop();
      for (var i = 0; i < parts.length; i++) {
        var ev = 'message', data = '';
        parts[i].split(/\r?\n/).forEach(function (line) {
          if (line.indexOf('event:') === 0) ev = line.slice(6).trim();
          else if (line.indexOf('data:') === 0) data += (data ? '\n' : '') + line.slice(5).replace(/^ /, '');
        });
        var payload = {};
        try { payload = data ? JSON.parse(data) : {}; } catch (e) { continue; }
        if (ev === 'meta') on.meta(payload.fuentes || [], payload.categoria);
        else if (ev === 'delta') on.delta(payload.t || '');
        else if (ev === 'error') throw new HttpErr(200, payload.error);
        else if (ev === 'done') { gotDone = true; }
      }
      if (gotDone) { try { reader.cancel(); } catch (e) {} break; }
    }
    if (!gotDone && !on.received()) throw new HttpErr('net');
  }
  async function requestJson(body, signal) {
    var res = await fetch(API, {
      method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
      body: JSON.stringify(body), signal: signal
    });
    if (!res.ok) throw await readJsonError(res);
    var d = await res.json();
    if (d.error) throw new HttpErr(res.status, d.error);
    return d;
  }

  function historial() {
    return msgs.filter(function (m) { return m.content && !m.error; })
      .slice(-8).map(function (m) { return { role: m.role, content: String(m.content).slice(0, 1200) }; });
  }

  /* ------------------------------------------------------------------ ask */
  async function ask(raw, opts) {
    opts = opts || {};
    var q = String(raw || '').trim().slice(0, MAX);
    if (!q || busy) return;
    var hist = historial();
    if (!opts.retry) { msgs.push({ role: 'user', content: q }); renderUser(q); save(); }
    log.querySelectorAll('.chat-next').forEach(function (n) { n.remove(); });
    setBusy(true); setMode();
    revealApp();
    if (coarse) input.blur();

    var view = renderAiShell(false);
    var m = { role: 'assistant', content: '', fuentes: [] };
    view.msg = m;
    stick = true;
    requestAnimationFrame(function () { toBottom(true); });

    // pensando
    avLive(view.av, true);
    var think = el('div', 'chat-think');
    think.setAttribute('aria-hidden', 'true');
    var dots = el('span', 'chat-dots'); dots.appendChild(el('i')); dots.appendChild(el('i')); dots.appendChild(el('i'));
    var tt = el('span', 'chat-think-t', THINK[0]);
    think.appendChild(tt); think.appendChild(dots);
    view.body.insertBefore(think, view.md);
    var phrases = THINK.slice(), pi = 0;
    var rot = setInterval(function () {
      pi = (pi + 1) % phrases.length;
      tt.classList.add('is-out');
      setTimeout(function () { tt.textContent = phrases[pi]; tt.classList.remove('is-out'); }, 280);
    }, 1900);
