    magnetic(b, 0.05);
    b.addEventListener('click', function () { ask(b.dataset.q); });
  });
  root.querySelectorAll('[data-av-static]').forEach(wireImg);

  /* --------------------------------------------------------------- inicio */
  msgs = load();
  var lastQ = '';
  msgs.forEach(function (m) {
    if (m.role === 'user') { renderUser(m.content, true); lastQ = m.content; return; }
    var v = renderAiShell(true);
    v.msg = m;
    finishView(v, m, lastQ, true);
  });
  if (msgs.length) {
    var lastAi = log.querySelector('.chat-msg--ai:last-child');
    var lastM = msgs[msgs.length - 1];
    if (lastAi && lastM.role === 'assistant' && !lastM.error) renderNext({ body: lastAi.querySelector('.chat-ai-body') });
  }
  setMode();
  syncInput();
  if (msgs.length) requestAnimationFrame(function () { toBottom(false); });

  // La home entrega la pregunta por ?q= — se dispara sola (y se limpia de la URL).
  var params = new URLSearchParams(location.search);
  var qp = params.get('q');
  if (qp) {
    try { params.delete('q'); var rest = params.toString(); history.replaceState(history.state, '', location.pathname + (rest ? '?' + rest : '') + location.hash); } catch (e) {}
    ask(qp);
  } else if (!coarse && !msgs.length) {
    setTimeout(function () { input.focus({ preventScroll: true }); }, 400);
  }
})();
</script>
</Base>
