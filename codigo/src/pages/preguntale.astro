---
/**
 * preguntale.astro — interfaz de conversación de «Preguntale a Ale».
 *
 * Rediseño 11/2026: chat tipo asistente (hilo + composer fijo abajo),
 * streaming SSE desde POST /api/chat/ (fetch + ReadableStream; si el stream
 * falla antes de recibir texto, cae a la respuesta JSON), historial corto
 * (últimos 8 mensajes) y persistencia en sessionStorage.
 *
 * VOZ: por decisión del cliente la IA responde en primera persona, como Ale.
 * IDENTIFICACIÓN VISIBLE COMO IA (regla del proyecto): aviso fijo en la barra,
 * etiqueta «Ale · IA» junto al avatar de cada respuesta y «Generado por IA» al
 * pie de cada una.
 *
 * La home entrega la pregunta por ?q= y acá se dispara sola al cargar.
 * Avatar: /media/img/ale-avatar/ (cabeza 96/256, cuerpo entero para el estado
 * vacío en desktop, loop «pensando» sólo mientras espera/escribe). Sin video
 * con prefers-reduced-motion.
 *
 * CSS y JS van is:inline (prefijo .chat-) para que el HTML publicado y esta
 * fuente sean idénticos. La clave de API NO llega acá.
 */
import Base from '../layouts/Base.astro';
import '../components/secciones/libros/ed.css';
---

<Base
  title="Preguntale a Ale — Alejandro Curcio"
  description="Un chat entrenado con sus libros y su prensa. Responde sólo con lo que Alejandro publicó."
>
<style is:inline>
/* ===== Preguntale a Ale — interfaz de conversación (prefijo .chat-) ===== */
.chat {
  --c-bg: #0c0a06;
  --c-gold: #e2bf63;
  --c-gold-rgb: 226 191 99;
  --c-grad: linear-gradient(135deg, #b8892a 0%, #e8c874 46%, #c9992f 100%);
  --c-t1: rgb(255 255 255 / .92);
  --c-t2: rgb(255 255 255 / .62);
  --c-t3: rgb(255 255 255 / .5);
  --c-line: rgb(255 255 255 / .08);
  --c-line2: rgb(255 255 255 / .15);
  --c-ease: cubic-bezier(.16, 1, .3, 1);
  --c-sans: "Geist Variable", "Archivo Variable", -apple-system, BlinkMacSystemFont, "Segoe UI", Arial, sans-serif;
  --c-mono: "JetBrains Mono Variable", ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  --c-serif: "Instrument Serif", "Instrument Serif Fallback", Georgia, serif;
  --chat-col: 760px;
  position: relative;
  isolation: isolate;
  display: flex;
  justify-content: center;
  height: calc(100svh - var(--chat-top, 112px));
  min-height: 540px;
  background: var(--c-bg);
  color: var(--c-t1);
  font-family: var(--c-sans);
  overflow: clip;
}
.chat *, .chat *::before, .chat *::after { box-sizing: border-box; }
.chat button { font: inherit; color: inherit; cursor: pointer; -webkit-tap-highlight-color: transparent; }
.chat :focus-visible { outline: 2px solid var(--c-gold); outline-offset: 3px; border-radius: 10px; }
.chat [hidden] { display: none !important; }
.chat-sr { position: absolute !important; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }

.chat-glow {
  position: absolute; z-index: -1; pointer-events: none;
  left: 50%; top: -30%; width: min(1100px, 140vw); height: 80%;
  transform: translateX(-50%);
  background: radial-gradient(closest-side, rgb(var(--c-gold-rgb) / .11), transparent 72%);
  transition: opacity 1.2s var(--c-ease), transform 1.2s var(--c-ease);
}
.chat[data-state="chat"] .chat-glow { opacity: .55; transform: translateX(-50%) translateY(-12%); }
.chat[data-busy] .chat-glow { opacity: 1; }

.chat-app {
  position: relative;
  display: flex; flex-direction: column;
  width: 100%; max-width: calc(var(--chat-col) + 2 * clamp(16px, 4vw, 40px));
  height: 100%;
  padding: 0 clamp(16px, 4vw, 40px);
}

/* ---------- barra ---------- */
.chat-bar {
  display: flex; flex-wrap: wrap; align-items: center;
  gap: 10px 18px;
  padding: 14px 0 13px;
  border-bottom: 1px solid var(--c-line);
}
.chat-id { display: flex; align-items: center; gap: 10px; margin-right: auto; }
.chat-id-mark {
  width: 18px; height: 18px; flex: none;
  background: var(--c-grad);
  -webkit-mask: var(--chat-trebol) no-repeat center / contain;
  mask: var(--chat-trebol) no-repeat center / contain;
}
.chat-h1 { white-space: nowrap; margin: 0; font-size: 15px; font-weight: 600; letter-spacing: -.01em; color: #fff; line-height: 1.2; }
.chat-tag {
  font-family: var(--c-mono); font-size: 10px; font-weight: 600; letter-spacing: .12em;
  padding: 3px 6px 2px; border-radius: 5px;
  background: var(--c-grad); color: var(--c-bg);
}
.chat-aviso {
  order: 3; flex: 1 1 100%;
  display: flex; align-items: flex-start; gap: 9px;
  margin: 0; font-size: 12.5px; line-height: 1.45; color: var(--c-t2);
}
.chat-aviso strong { color: var(--c-t1); font-weight: 600; }
.chat-aviso-dot {
  flex: none; width: 6px; height: 6px; margin-top: .48em; border-radius: 50%;
  background: var(--c-gold); box-shadow: 0 0 0 3px rgb(var(--c-gold-rgb) / .16);
}
.chat-new {
  display: inline-flex; align-items: center; gap: 7px;
  min-height: 36px; padding: 0 13px 0 10px;
  border: 1px solid var(--c-line2); border-radius: 999px; background: transparent;
  font-family: var(--c-mono) !important; font-size: 11px !important; letter-spacing: .06em; text-transform: uppercase;
  color: var(--c-t2) !important;
  transition: border-color .3s var(--c-ease), color .3s var(--c-ease), background .3s var(--c-ease);
}
.chat-new:hover { border-color: rgb(var(--c-gold-rgb) / .6); color: #fff !important; background: rgb(var(--c-gold-rgb) / .07); }
@media (max-width: 559px) { .chat-new span { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); } .chat-new { width: 36px; padding: 0; justify-content: center; } }
@media (min-width: 900px) {
  .chat-bar { flex-wrap: nowrap; gap: 24px; }
  .chat-aviso { order: 0; flex: 1 1 auto; max-width: 440px; margin-left: auto; }
  .chat-id { margin-right: 0; }
  .chat-new { flex: none; }
}

/* ---------- zona de scroll ---------- */
.chat-scroll {
  position: relative; flex: 1; min-height: 0;
  overflow-y: auto; overflow-x: hidden;
  overscroll-behavior: contain;
  scrollbar-width: thin; scrollbar-color: rgb(255 255 255 / .14) transparent;
  -webkit-mask-image: linear-gradient(to bottom, transparent 0, #000 22px, #000 calc(100% - 18px), transparent 100%);
  mask-image: linear-gradient(to bottom, transparent 0, #000 22px, #000 calc(100% - 18px), transparent 100%);
  margin: 0 calc(-1 * clamp(16px, 4vw, 40px));
  padding: 0 clamp(16px, 4vw, 40px);
}
.chat-scroll::-webkit-scrollbar { width: 8px; }
.chat-scroll::-webkit-scrollbar-thumb { background: rgb(255 255 255 / .12); border-radius: 8px; border: 2px solid var(--c-bg); }

/* ---------- estado vacío ---------- */
.chat-empty {
  min-height: 100%;
  display: flex; flex-direction: column; justify-content: center;
  padding: clamp(12px, 2vh, 40px) 0 clamp(12px, 2vh, 28px);
}
.chat[data-state="chat"] .chat-empty { display: none; }
.chat-empty > * { animation: chat-rise .9s var(--c-ease) both; }
.chat-empty > :nth-child(2) { animation-delay: .06s; }
.chat-empty > :nth-child(3) { animation-delay: .12s; }
.chat-empty-top { display: flex; align-items: center; gap: 16px; }
.chat-kicker {
  margin: 0; font-family: var(--c-mono); font-size: 11px; letter-spacing: .1em; text-transform: uppercase;
  color: var(--c-t3); line-height: 1.5;
}
.chat-kicker-b { color: var(--c-gold); margin-right: 6px; }
.chat-hello {
  margin: clamp(14px, 2vh, 26px) 0 0;
  font-size: clamp(1.9rem, 1rem + 2.4vw, 2.75rem);
  line-height: 1.04; letter-spacing: -.04em; font-weight: 500;
  color: #fff; max-width: 17ch;
  text-wrap: balance;
}
.chat-hello em {
  display: block;
  font-family: var(--c-serif); font-style: italic; font-weight: 400;
  letter-spacing: -.005em; font-size: .9em; line-height: 1.02; margin-top: .12em;
  background: var(--c-grad); -webkit-background-clip: text; background-clip: text; color: transparent;
  padding-bottom: .06em;
}
.chat-sub { margin: 14px 0 0; max-width: 54ch; font-size: 15.5px; line-height: 1.55; color: var(--c-t2); }

.chat-sugs {
  list-style: none; margin: clamp(18px, 2.6vh, 34px) 0 0; padding: 0;
  display: flex; flex-wrap: wrap; gap: 8px;
}
.chat-sugs li { animation: chat-rise .8s var(--c-ease) both; animation-delay: calc(.18s + var(--i) * .05s); }
.chat-sug {
  --tx: 0px; --ty: 0px; --mx: 50%; --my: 50%;
  position: relative; overflow: hidden;
  display: inline-flex; align-items: center; gap: 10px;
  min-height: 44px; padding: 10px 14px;
  text-align: left; font-size: 14.5px !important; line-height: 1.3; color: var(--c-t1) !important;
  background: rgb(255 255 255 / .03);
  border: 1px solid var(--c-line2); border-radius: 14px;
  transform: translate3d(var(--tx), var(--ty), 0);
  transition: transform .5s var(--c-ease), border-color .35s var(--c-ease), background .35s var(--c-ease);
}
.chat-sug::before {
  content: ""; position: absolute; inset: 0; pointer-events: none; opacity: 0;
  background: radial-gradient(180px circle at var(--mx) var(--my), rgb(var(--c-gold-rgb) / .16), transparent 70%);
  transition: opacity .35s var(--c-ease);
}
.chat-sug:hover { border-color: rgb(var(--c-gold-rgb) / .5); background: rgb(var(--c-gold-rgb) / .045); }
.chat-sug:hover::before { opacity: 1; }
.chat-sug:active { transform: translate3d(var(--tx), var(--ty), 0) scale(.985); }
.chat-sug-n { display: none; font-family: var(--c-mono); font-size: 10.5px; letter-spacing: .1em; color: var(--c-gold); }
.chat-sug-t { position: relative; }
.chat-sug-a { display: none; color: var(--c-t3); transition: transform .45s var(--c-ease), color .3s; }
@media (min-width: 720px) {
  .chat-sugs { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; }
  .chat-sug {
    width: 100%; height: 100%; min-height: 80px;
    flex-direction: column; align-items: flex-start; justify-content: space-between; gap: 10px;
    padding: 13px 16px 14px; border-radius: 16px; font-size: 15px !important;
  }
  .chat-sug-n { display: block; }
  .chat-sug-a { display: block; position: absolute; top: 13px; right: 13px; }
  .chat-sug:hover .chat-sug-a { color: var(--c-gold); transform: translate(2px, -2px); }
}

/* figura de cuerpo entero (solo desktop) */
.chat-hero { display: flex; align-items: flex-end; gap: 24px; }
.chat-hero-txt { flex: 1; min-width: 0; }
.chat-figure { display: none; }
@media (min-width: 900px) and (min-height: 700px) {
  .chat-figure {
    position: relative; display: block; flex: none; margin: 0 -12px -8px 0;
    width: clamp(200px, 26vh, 268px);
    animation: chat-rise 1.1s var(--c-ease) .1s both;
  }
  .chat-figure picture, .chat-figure img { display: block; width: 100%; height: auto; }
  .chat-figure img {
    position: relative; z-index: 1;
    filter: drop-shadow(0 18px 30px rgb(0 0 0 / .55));
    animation: chat-float 6s ease-in-out 1.2s infinite;
    transform-origin: 50% 100%;
  }
  .chat-figure-glow {
    position: absolute; z-index: 0; left: 50%; top: 4%; width: 120%; aspect-ratio: 1; transform: translateX(-50%);
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(var(--c-gold-rgb) / .22), rgb(var(--c-gold-rgb) / .06) 55%, transparent 72%);
  }
  .chat-figure::after {
    content: ""; position: absolute; z-index: 0; left: 18%; right: 18%; bottom: 0; height: 14px; border-radius: 50%;
    background: radial-gradient(closest-side, rgb(0 0 0 / .7), transparent);
  }
  .chat-figure-cap {
    position: absolute; z-index: 2; right: 6px; bottom: 6px;
    font-family: var(--c-mono); font-size: 9.5px; letter-spacing: .14em; text-transform: uppercase; color: var(--c-t3);
  }
  .chat-empty-top .chat-av { display: none; }
}
@media (min-width: 720px) and (max-height: 760px) { .chat-sub { display: none; } }
@media (max-width: 559px) and (max-height: 900px) { .chat-sub { display: none; } }
@keyframes chat-float { 0%, 100% { transform: translateY(0) rotate(0); } 50% { transform: translateY(-6px) rotate(-.6deg); } }

/* ---------- avatar ---------- */
.chat-av { position: relative; flex: none; display: inline-grid; width: 34px; height: 34px; }
.chat-av--lg { width: 56px; height: 56px; }
.chat-av-face {
  position: relative; width: 100%; height: 100%; border-radius: 50%; overflow: hidden;
  background: radial-gradient(circle at 50% 30%, #1d160b, #120e06 70%);
  box-shadow: 0 0 0 1px rgb(var(--c-gold-rgb) / .45), 0 6px 18px rgb(0 0 0 / .45);
}
.chat-av-fb {
  position: absolute; inset: 0; border-radius: 50%;
  background: var(--c-grad);
}
.chat-av-fb::after {
  content: ""; position: absolute; inset: 24%;
  background: var(--c-bg);
  -webkit-mask: var(--chat-trebol) no-repeat center / contain;
  mask: var(--chat-trebol) no-repeat center / contain;
}
.chat-av picture, .chat-av img, .chat-av video {
  position: absolute; inset: 0; width: 100%; height: 100%; display: block;
  object-fit: cover; border-radius: 50%;
}
.chat-av img { opacity: 0; transition: opacity .4s; object-position: 50% 0; }
.chat-av.img-ok img { opacity: 1; }
.chat-av video { opacity: 0; transition: opacity .35s; }
.chat-av.has-vid video { opacity: 1; }
.chat-av::before, .chat-av::after {
  content: ""; position: absolute; inset: 0; border-radius: 50%; pointer-events: none; opacity: 0;
}
.chat-av::before { box-shadow: 0 0 0 0 rgb(var(--c-gold-rgb) / .5); }
.chat-av::after {
  inset: -3px;
  background: conic-gradient(from var(--chat-a, 0deg), transparent 0 55%, rgb(var(--c-gold-rgb) / .95) 80%, transparent 100%);
  -webkit-mask: radial-gradient(farthest-side, transparent calc(100% - 1.5px), #000 calc(100% - 1px));
  mask: radial-gradient(farthest-side, transparent calc(100% - 1.5px), #000 calc(100% - 1px));
}
.chat-av.is-live .chat-av-face { animation: chat-breathe 2.4s ease-in-out infinite; }
.chat-av.is-live::before { opacity: 1; animation: chat-halo 1.8s var(--c-ease) infinite; }
.chat-av.is-live::after { opacity: 1; animation: chat-spin 1.6s linear infinite; }
@property --chat-a { syntax: "<angle>"; inherits: false; initial-value: 0deg; }

/* ---------- hilo ---------- */
.chat-log { display: flex; flex-direction: column; gap: clamp(26px, 4vh, 38px); padding: 26px 0 30px; }
.chat[data-state="empty"] .chat-log { display: none; }
.chat-msg { animation: chat-in .6s var(--c-ease) both; }
.chat-msg.is-static { animation: none; }

.chat-msg--user { align-self: flex-end; max-width: min(84%, 560px); }
.chat-bubble {
  margin: 0;
  padding: 11px 16px 12px;
  border-radius: 20px 20px 6px 20px;
  background: linear-gradient(180deg, rgb(var(--c-gold-rgb) / .12), rgb(var(--c-gold-rgb) / .06));
  border: 1px solid rgb(var(--c-gold-rgb) / .2);
  font-size: 16px; line-height: 1.5; color: #fff;
  white-space: pre-wrap; overflow-wrap: anywhere;
}

.chat-msg--ai { display: grid; grid-template-columns: auto 1fr; align-items: center; column-gap: 11px; }
.chat-msg--ai .chat-av { width: 30px; height: 30px; }
.chat-ai-label {
  font-family: var(--c-mono); font-size: 10.5px; letter-spacing: .12em; text-transform: uppercase;
  color: var(--c-t3);
}
.chat-ai-label { display: inline-flex; align-items: center; gap: 8px; color: var(--c-t1); font-weight: 600; letter-spacing: .14em; }
.chat-ai-tag {
  font-weight: 600; font-size: 9.5px; letter-spacing: .12em; line-height: 1;
  padding: 3px 5px 2px; border-radius: 4px; background: var(--c-grad); color: var(--c-bg);
}
.chat-ai-body { grid-column: 1 / -1; min-width: 0; margin-top: 12px; }
@media (min-width: 720px) {
  .chat-msg--ai { column-gap: 14px; }
  .chat-msg--ai .chat-av { width: 36px; height: 36px; }
  .chat-ai-body { grid-column: 2; margin-top: 8px; }
}

.chat-md {
  max-width: 68ch;
  font-size: clamp(16.5px, .95rem + .2vw, 17.5px);
  line-height: 1.62; color: var(--c-t1);
  overflow-wrap: break-word;
}
.chat-md > * { margin: 0 0 .9em; }
.chat-md > :last-child { margin-bottom: 0; }
.chat-md strong { color: #fff; font-weight: 600; }
.chat-md em { font-family: var(--c-serif); font-style: italic; font-size: 1.12em; line-height: 1; color: #f1dfae; letter-spacing: .005em; }
.chat-md ul, .chat-md ol { padding-left: 1.3em; list-style: disc outside; }
.chat-md ol { list-style: decimal outside; }
.chat-md li { margin: .38em 0; padding-left: .2em; }
.chat-md li::marker { color: var(--c-gold); }
.chat-md ol li::marker { font-family: var(--c-mono); font-size: .82em; }
.chat-md blockquote {
  padding: .1em 0 .1em 1em; border-left: 2px solid var(--c-gold);
  font-family: var(--c-serif); font-style: italic; font-size: 1.28em; line-height: 1.35; color: #f6ecd2;
}
.chat-md blockquote em { font-size: 1em; }
.chat-md .chat-mh { font-weight: 600; color: #fff; letter-spacing: -.01em; }
.chat-caret {
  display: inline-block; width: .55em; height: 1.08em; margin-left: 3px; vertical-align: -.17em;
  border-radius: 2px; background: var(--c-grad);
  box-shadow: 0 0 14px rgb(var(--c-gold-rgb) / .55);
  animation: chat-blink 1s steps(2, start) infinite;
}

/* pensando */
.chat-think {
  display: inline-flex; align-items: center; gap: 10px; min-height: 28px;
  font-family: var(--c-mono); font-size: 12px; letter-spacing: .06em;
}
.chat-think-t {
  background: linear-gradient(90deg, rgb(var(--c-gold-rgb) / .55) 0%, #fff4d2 45%, rgb(var(--c-gold-rgb) / .55) 70%);
  background-size: 220% 100%;
  -webkit-background-clip: text; background-clip: text; color: transparent;
  animation: chat-shimmer 2.2s linear infinite;
  transition: opacity .3s, transform .3s var(--c-ease);
}
.chat-think-t.is-out { opacity: 0; transform: translateY(-4px); }
.chat-dots { display: inline-flex; gap: 4px; }
.chat-dots i { width: 4px; height: 4px; border-radius: 50%; background: var(--c-gold); animation: chat-dot 1.2s ease-in-out infinite; }
.chat-dots i:nth-child(2) { animation-delay: .15s; }
.chat-dots i:nth-child(3) { animation-delay: .3s; }

/* fuentes */
.chat-src { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 8px; margin-top: 18px; animation: chat-in .6s var(--c-ease) both; }
.chat-src-k { font-family: var(--c-mono); font-size: 10.5px; letter-spacing: .12em; text-transform: uppercase; color: var(--c-t3); margin-right: 2px; }
.chat-chip {
  display: inline-flex; align-items: center; gap: 7px; max-width: 100%;
  padding: 5px 10px 5px 8px; border-radius: 999px;
  border: 1px solid var(--c-line2); background: rgb(255 255 255 / .02);
  font-family: var(--c-mono); font-size: 11px; letter-spacing: .01em; color: var(--c-t2);
}
.chat-chip i { font-style: normal; color: var(--c-gold); font-size: 10px; }
.chat-chip span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

/* acciones */
.chat-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 2px; margin-top: 14px; margin-left: -7px; animation: chat-in .6s var(--c-ease) both; }
.chat-act {
  display: inline-grid; place-items: center; width: 34px; height: 34px;
  border: 0; border-radius: 9px; background: transparent; color: var(--c-t3) !important;
  transition: background .25s, color .25s, transform .25s var(--c-ease);
}
.chat-act:hover { background: rgb(255 255 255 / .06); color: var(--c-t1) !important; }
.chat-act:active { transform: scale(.92); }
.chat-act[aria-pressed="true"] { color: var(--c-gold) !important; background: rgb(var(--c-gold-rgb) / .1); }
.chat-act.is-done { color: var(--c-gold) !important; }
.chat-gen {
  margin-left: 8px; font-family: var(--c-mono); font-size: 10px; letter-spacing: .12em; text-transform: uppercase; color: var(--c-t3);
  display: inline-flex; align-items: center; gap: 6px;
}
.chat-gen::before { content: ""; width: 5px; height: 5px; border-radius: 50%; background: var(--c-gold); opacity: .8; }
.chat-note { margin-top: 10px; font-family: var(--c-mono); font-size: 11px; letter-spacing: .06em; color: var(--c-t3); }

/* para seguir */
.chat-next { margin-top: 20px; display: flex; flex-direction: column; align-items: flex-start; gap: 6px; animation: chat-in .7s var(--c-ease) .1s both; }
.chat-next-k { font-family: var(--c-mono); font-size: 10.5px; letter-spacing: .12em; text-transform: uppercase; color: var(--c-t3); margin-bottom: 2px; }
.chat-follow {
  --tx: 0px; --ty: 0px;
  display: inline-flex; align-items: center; gap: 10px; min-height: 40px; max-width: 100%;
  padding: 8px 14px 8px 11px; border-radius: 12px;
  border: 1px solid var(--c-line); background: transparent;
  font-size: 15px !important; text-align: left; color: var(--c-t2) !important;
  transform: translate3d(var(--tx), var(--ty), 0);
  transition: border-color .3s var(--c-ease), color .3s, background .3s, transform .5s var(--c-ease);
}
.chat-follow svg { flex: none; color: var(--c-gold); transition: transform .4s var(--c-ease); }
