        }
        var li = el('li'); inline(li, ordered ? m[2] : m[1]); list.appendChild(li);
        return;
      }
      if ((m = line.match(/^\s*>\s?(.*)$/))) { flushPara(); list = null; (quote = quote || []).push(m[1]); return; }
      if ((m = line.match(/^\s*#{1,4}\s+(.*)$/))) { flushAll(); var h = el('p', 'chat-mh'); inline(h, m[1]); frag.appendChild(h); return; }
