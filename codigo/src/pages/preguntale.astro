      if (shown < target.length) {
        var gap = target.length - shown;
        var step = reduced() ? gap : Math.max(finished ? 6 : 2, Math.ceil(gap / (finished ? 4 : 12)));
        shown = Math.min(target.length, shown + step);
        var cc = target.charCodeAt(shown - 1);
        if (cc >= 0xd800 && cc <= 0xdbff && shown < target.length) shown++;
        paint(view.md, target.slice(0, shown), true);
        follow();
      }
      if (shown < target.length) raf = requestAnimationFrame(tick);
      else if (finished) resolveFlush();
    }
    function kick() { if (!raf) raf = requestAnimationFrame(tick); }

    ctrl = new AbortController();
    var received = false;
    var on = {
      meta: function (f) {
        m.fuentes = Array.isArray(f) ? f.slice(0, 6) : [];
        if (m.fuentes.length) phrases = ['Leyendo ' + m.fuentes.length + (m.fuentes.length === 1 ? ' fuente…' : ' fuentes…'), THINK[2]];
      },
      delta: function (t) {
        if (!t) return;
        if (!received) { received = true; startStream(); }
        target += t; m.content = target; kick();
