  /* ------------------------------------------------------------- markdown */
  // Markdown mínimo y seguro: todo se arma con createElement/textContent.
  function inline(parent, text) {
    var re = /\*\*([^*]+?)\*\*|\*([^*\n]+?)\*/g, last = 0, m;
    while ((m = re.exec(text))) {
      if (m.index > last) parent.appendChild(document.createTextNode(text.slice(last, m.index)));
      if (m[1] != null) { var b = el('strong'); inline(b, m[1]); parent.appendChild(b); }
      else parent.appendChild(el('em', null, m[2]));
      last = re.lastIndex;
    }
    if (last < text.length) parent.appendChild(document.createTextNode(text.slice(last)));
  }
  function inlineLines(parent, lines) {
    lines.forEach(function (l, i) { if (i) parent.appendChild(el('br')); inline(parent, l); });
  }
  function md(text, streaming) {
    text = String(text || '').replace(/\r/g, '');
    if (streaming) {
      if (((text.match(/\*\*/g) || []).length) % 2) text += '**';
      var singles = text.replace(/\*\*/g, '').replace(/^\s*\* /gm, '');
      if (((singles.match(/\*/g) || []).length) % 2) text += '*';
    }
    var frag = document.createDocumentFragment();
    var para = null, list = null, quote = null;
    var flushPara = function () { if (para) { var p = el('p'); inlineLines(p, para); frag.appendChild(p); para = null; } };
    var flushQuote = function () { if (quote) { var q = el('blockquote'); inlineLines(q, quote); frag.appendChild(q); quote = null; } };
    var flushAll = function () { flushPara(); flushQuote(); list = null; };
    text.split('\n').forEach(function (line) {
      var m;
      if (!line.trim()) { flushAll(); return; }
      if ((m = line.match(/^\s*[-*•]\s+(.*)$/)) || (m = line.match(/^\s*(\d+)[.)]\s+(.*)$/))) {
        var ordered = m.length === 3;
        flushPara(); flushQuote();
        var tag = ordered ? 'OL' : 'UL';
        if (!list || list.tagName !== tag) {
          list = el(tag.toLowerCase());
