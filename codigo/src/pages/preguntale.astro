      var txt = plain(m.content) + (m.fuentes && m.fuentes.length ? '\n\nFuentes: ' + m.fuentes.map(function (f) { return f.detail || f.label; }).join(' · ') : '') + '\n\n(Generado por IA · Preguntale a Ale)';
