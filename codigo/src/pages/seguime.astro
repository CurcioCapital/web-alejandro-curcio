---
/**
 * seguime.astro — Seguime / Contacto section. Instagram (@alecurcio_
 * capitaldevida) is the protagonist: it's the real, unscripted channel
 * where Capital de Vida gets lived day to day, and everything else on
 * the site (books, chat, press) points back to it rather than competing
 * with it. Copy: sitio-copy/seguime.md. Channels: Web/Ecosistema Digital
 * Actual.md — only the four confirmed there render as cards; hrefs stay
 * "#" with a TODO next to each until an official profile URL is
 * confirmed (no fabricated URLs). Media: public/media/manifest.json.
 * D8: forjado, no heredado — no framing here touches inheritance either.
 */
import Base from '../layouts/Base.astro';
import '../components/secciones/libros/ed.css';
import EdSection from '../components/secciones/libros/EdSection.astro';
import EdHero from '../components/secciones/libros/EdHero.astro';
import ChannelCard from '../components/secciones/seguime/ChannelCard.astro';

// Marquesina: SÓLO los handles que ya figuran en las tarjetas de abajo.
const handles = ['@alecurcio_capitaldevida', 'Alejandro Curcio - Capital de Vida', '@curciocapital', 'Alejandro Curcio'];
---

<Base
	title="Seguime — Alejandro Curcio"
	description="Instagram, YouTube, libros y charlas. Un solo lugar para cada cosa."
>
<!-- 12/11/2026: Seguime: 2 tarjetas (Instagram, YouTube; LinkedIn se quitó el 13/11/2026) que entran en una pantalla. Sin el Instagram institucional de Curcio Capital (no existe). -->
<section id="canales" class="sg" aria-labelledby="sg-t"><style is:inline>.sg{min-height:calc(100svh - 112px);padding:clamp(40px,6vh,72px) clamp(20px,4vw,64px) clamp(48px,7vh,88px);display:flex;flex-direction:column;justify-content:center;background:#0c0a06;color:#f3ead6}.sg-head{max-width:1560px;width:100%;margin:0 auto clamp(28px,4vh,48px)}.sg-kick{margin:0 0 12px;font-family:"JetBrains Mono Variable","JetBrains Mono",ui-monospace,monospace;font-size:11.5px;letter-spacing:.14em;text-transform:uppercase;color:#e2bf63}.sg-title{margin:0;font-family:var(--font-display,inherit);font-weight:var(--display-wght,560);font-size:clamp(48px,6.5vw,112px);line-height:.92;letter-spacing:-.05em;color:#fff}.sg-grid{max-width:1560px;width:100%;margin:0 auto;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:clamp(14px,1.6vw,24px)}.sgc{display:flex;flex-direction:column;border:1px solid rgba(243,234,214,.12);border-radius:22px;padding:12px;background:linear-gradient(180deg,rgba(243,234,214,.03),rgba(243,234,214,.01))}.sgc--main{border-color:rgba(232,200,116,.35)}.sgc-tile{position:relative;height:clamp(150px,22vh,230px);border-radius:14px;overflow:hidden;padding:16px 18px;display:flex;flex-direction:column;justify-content:space-between;background:radial-gradient(120% 90% at 100% 0%,rgba(232,200,116,.16),transparent 55%),#100d08;background-image:radial-gradient(120% 90% at 100% 0%,rgba(232,200,116,.16),transparent 55%),linear-gradient(rgba(243,234,214,.05) 1px,transparent 1px),linear-gradient(90deg,rgba(243,234,214,.05) 1px,transparent 1px);background-size:auto,100% 25%,25% 100%}.sgc-top{display:flex;justify-content:space-between;gap:12px;font-family:"JetBrains Mono Variable","JetBrains Mono",ui-monospace,monospace;font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:#e2bf63}.sgc-top span+span{color:rgba(243,234,214,.45)}.sgc-name{font-family:var(--font-display,inherit);font-weight:var(--display-wght,560);font-size:clamp(40px,4.4vw,80px);line-height:.9;letter-spacing:-.05em;color:#fff}.sgc-body{display:flex;flex-direction:column;align-items:flex-start;gap:10px;padding:18px 8px 8px;flex:1}.sgc-kick{font-family:"JetBrains Mono Variable","JetBrains Mono",ui-monospace,monospace;font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:#e2bf63}.sgc-stat{font-family:var(--font-display,inherit);font-weight:var(--display-wght,560);font-size:clamp(28px,2.4vw,40px);line-height:1;letter-spacing:-.04em;color:#e8c874}.sgc-body p{margin:0;font-size:15.5px;line-height:1.55;color:rgba(243,234,214,.72);max-width:44ch}.sgc-btn{margin-top:auto;display:inline-flex;align-items:center;gap:12px;padding:12px 20px;border-radius:999px;border:1px solid rgba(243,234,214,.25);font-family:"JetBrains Mono Variable","JetBrains Mono",ui-monospace,monospace;font-size:11.5px;letter-spacing:.12em;text-transform:uppercase;color:#fff;text-decoration:none;transition:background .3s,color .3s,border-color .3s}.sgc-btn:hover{background:#e8c874;color:#0c0a06;border-color:#e8c874}.sgc--main .sgc-btn{background:#e8c874;color:#0c0a06;border-color:#e8c874}@media (max-width:960px){.sg-grid{grid-template-columns:1fr}.sg{min-height:0}}</style><header class="sg-head"><h1 id="sg-t" class="sg-title">Seguime.</h1></header><div class="sg-grid"><article class="sgc sgc--main"><div class="sgc-tile"><div class="sgc-top"><span>@alecurcio_capitaldevida</span><span aria-hidden="true">[ 01 ]</span></div><span class="sgc-name">Instagram</span></div><div class="sgc-body"><span class="sgc-kick">Canal principal</span><span class="sgc-stat">375.000+ seguidores</span><p>El día a día de Capital de Vida. Lo que después se convierte en libro, podcast o charla, primero se piensa acá.</p><a class="sgc-btn" href="https://www.instagram.com/alecurcio_capitaldevida/" target="_blank" rel="noopener noreferrer"><span>Seguir en Instagram</span><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg></a></div></article><article class="sgc"><div class="sgc-tile"><div class="sgc-top"><span>Alejandro Curcio - Capital de Vida</span><span aria-hidden="true">[ 02 ]</span></div><span class="sgc-name">YouTube</span></div><div class="sgc-body"><span class="sgc-kick">Las conversaciones largas</span><p>Podcasts y entrevistas, con apariciones de Nando Parrado y Berch Rupenian. Donde Instagram muestra la idea, acá se desarrolla.</p><a class="sgc-btn" href="https://www.youtube.com/@alejandrocurcio-capitaldev5482" target="_blank" rel="noopener noreferrer"><span>Mirá el canal</span><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg></a></div></article></div></section>
</Base>

<style>
	.handles {
		position: relative;
		overflow: hidden;
		background: var(--ed-accent);
		color: var(--ed-ink);
		border-block: 1px solid rgb(12 10 6 / 0.2);
		padding: 18px 0;
	}
	.handles-track {
		display: flex;
		gap: 0;
		white-space: nowrap;
	}
	.handles-item {
		display: inline-flex;
		align-items: center;
		gap: 28px;
		padding-right: 28px;
		flex: none;
	}
	.handles-h {
		font-family: var(--ed-display);
		font-weight: 540;
		font-size: clamp(2rem, 1rem + 3.4vw, 4.5rem);
		line-height: 1.05;
		letter-spacing: -0.045em;
	}
	.handles-dot {
		font-size: clamp(1rem, 0.8rem + 1vw, 1.75rem);
	}
	.channels-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: clamp(16px, 2vw, 28px);
		margin-top: clamp(48px, 6vw, 96px);
	}
	.channels-grid > :global(.channel-card--featured) {
		grid-column: 1 / -1;
	}
	@media (max-width: 900px) {
		.channels-grid {
			grid-template-columns: 1fr;
		}
	}

	.press-note {
		display: flex;
		gap: 18px;
		align-items: baseline;
		margin-top: clamp(40px, 5vw, 72px);
		max-width: 900px;
		padding: clamp(22px, 3vw, 40px);
		border-radius: 18px;
		background: rgb(12 10 6 / 0.04);
		border: 1px solid rgb(12 10 6 / 0.14);
	}
	.press-note-k {
		color: var(--ed-accent-ink);
		flex: none;
	}
	.press-note p {
		margin: 0;
		font-family: var(--ed-serif);
		font-style: italic;
		font-size: clamp(1.5rem, 1rem + 1.6vw, 2.5rem);
		line-height: 1.15;
		color: var(--ed-ink);
	}

	.back-home {
		text-align: center;
		padding: 48px var(--ed-gutter) 24px;
		background: var(--ed-bg);
	}
	.back-home a {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		padding: 0 12px;
		font-family: var(--ed-mono);
		font-size: 12px;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: rgba(255, 255, 255, 0.6);
		transition: color 0.3s var(--ed-expo);
	}
	.back-home a:hover {
		color: var(--ed-accent);
	}
</style>

<style is:inline>.trebol-sep{display:inline-block;width:max(16px,.62em);height:max(16px,.62em);vertical-align:middle;background:currentColor;-webkit-mask:url(/media/marca/trebol.png) no-repeat center/contain;mask:url(/media/marca/trebol.png) no-repeat center/contain}</style>
