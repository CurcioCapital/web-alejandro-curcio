	if (pmv) {
		const prm = matchMedia('(prefers-reduced-motion: reduce)');
		let raf = 0;
		const check = () => {
			raf = 0;
			const r = pmv.getBoundingClientRect();
			const ver = r.bottom > 0 && r.top < innerHeight;
			if (ver && pmv.paused && (!prm.matches || !pmv.muted)) pmv.play().catch(() => {});
			else if (!ver && !pmv.paused) pmv.pause();
		};
		addEventListener('scroll', () => { if (!raf) raf = requestAnimationFrame(check); }, { passive: true });
		check();
		pmb?.addEventListener('click', () => {
			pmv.muted = !pmv.muted;
			if (!pmv.muted) { pmv.currentTime = pmv.currentTime; pmv.play().catch(() => {}); }
			pmb.setAttribute('aria-pressed', String(!pmv.muted));
			const l = pmb.querySelector('[data-pm-sound-label]');
			if (l) l.textContent = pmv.muted ? 'Activar sonido' : 'Silenciar';
		});
	}
</script>
