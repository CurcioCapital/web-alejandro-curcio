---
/**
 * solidario.astro — Récord Guinness Ice Challenge 2024, migrado tal cual
 * desde /aventura (hero con video, carrusel, sello Guinness, mismas
 * clases y animaciones). La cita de cierre es la de la faceta Solidario
 * de la home (Pilar «La Figura»).
 */
import Base from '../layouts/Base.astro';
import QuoteOverlay from '../components/QuoteOverlay.astro';
import BlurImage from '../components/BlurImage.astro';

import MediaTextBlock from '../components/secciones/aventura/MediaTextBlock.astro';
import Carousel from '../components/kit/Carousel.astro';

import GuinnessSeal from '../components/secciones/aventura/GuinnessSeal.astro';
import '../components/secciones/historia/pa-kit.css';

const guinnessSlides = [
  {
    id: 'guinness-01',
    caption: 'Con la campera Toyota Gazoo Racing, junto a autoridades',
  },
  {
    id: 'guinness-02',
    caption: 'La entrada al barril de hielo',
  },
  {
    id: 'guinness-03',
    caption: 'Adentro del barril, cronómetro en mano — el estoicismo físico',
  },
  {
    id: 'guinness-04',
    caption: 'La piscina, entre los demás — no auspiciando, participando',
  },
  {
    id: 'guinness-05',
    caption: 'La cuenta regresiva: 01:48',
  },
  {
    id: 'guinness-06',
    caption: 'La formación en estrella, vista aérea de todo el predio',
  },
  {
    id: 'guinness-07',
    caption: '00:00 — el clímax de la celebración',
  },
];
---

<Base
	title="Solidario — Alejandro Curcio"
	description="Récord Guinness Ice Challenge 2024: meterse al hielo con los demás. Esa es la diferencia entre auspiciar y participar."
>
<div class="pa pa--av pa--sol">
	<!-- HERO con VIDEO a sangre (corte 16:9 del máster propio del Ice
	     Challenge 2024). Display gigante + ficha en mono. -->
	<section class="av-hero-wrap">
		<figure class="av-plate" data-scrub>
			<div class="av-plate-media" data-parallax="0.2">
				<video
					class="av-plate-video"
					data-audio="auto"
					src="/media/video/ice-challenge-aftermovie.mp4"
					poster="/media/video/ice-challenge-aftermovie-poster.jpg"
					muted
					loop
					autoplay
					playsinline
					preload="metadata"
					aria-label="Alejandro Curcio dentro del barril de hielo en el récord Guinness Ice Challenge 2024"
				></video>
			</div>
			<span class="av-plate-scrim" aria-hidden="true"></span>

			<figcaption class="wrap av-plate-copy">
				<p class="pa-kick"><span class="pa-idx">[ 01 ]</span>Solidario</p>
				<h1 class="av-plate-title pa-display" data-split="lines">La disciplina también<br />se entrena en frío.</h1>
				<p class="av-plate-ficha pa-mono">
					Ice Challenge 2024 <span aria-hidden="true">·</span> Récord Guinness
					<span aria-hidden="true">·</span> Centro Horizonte
				</p>
			</figcaption>
			<span class="pa-mono pa-scrollcue av-cue" aria-hidden="true"><i></i>Scroll</span>
		</figure>
	</section>

	<div class="section-gap"></div>


	<div class="section-gap"></div>

	<!-- RÉCORD GUINNESS -->
	<section id="guinness" class="pa-cap pa-grid av-cap">
		<div class="wrap">
			<header class="pa-cap-head">
				<p class="pa-kick"><span class="pa-idx">[ 02 ]</span>Récord Guinness · 13 abril 2024</p>
				<h2 class="pa-display pa-cap-title" data-split="lines">Meterse al hielo con los demás.</h2>
				<p class="pa-lead" data-reveal>El 13 de abril de 2024, Montevideo fue sede del Ice Challenge 2024: el récord Guinness al mayor número de personas tomando un baño de hielo de forma simultánea. Lo organizó Alejandro Curcio, y no lo miró desde afuera: se metió al hielo con los demás.</p>
			</header>
		</div>

		<div class="guinness-gal" data-cursor="drag" data-cursor-label="Arrastrá">
			<div class="wrap">
				<Carousel ariaLabel="Momentos del récord Guinness Ice Challenge 2024" gap={16}>
					{
						guinnessSlides.map((s, i) => (
							<div class="guinness-slide" data-reveal="mask">
								<BlurImage id={s.id} alt={s.caption} width={640} sizes="(max-width: 560px) 76vw, 360px" />
							</div>
						))
					}
				</Carousel>
			</div>
		</div>

		<div class="wrap">
			<div class="guinness-pie">
				{/* 11/11/2026: se quitó «Se metió al barril…» (pedido de Emi). */}
				<!-- Cifras de la nota oficial de Guinness World Records y de El
				     Observador («05 — Hechos verificados.md»). Se publica 929 (la
				     cifra homologada), nunca el «más de 1.000» de la prensa. -->
				<GuinnessSeal
					participantes={929}
					minutos={3}
					grados={13}
					piscinas={90}
					recordAnterior={509}
					recordAnteriorNota="Perth, Australia — enero 2024"
				/>
			</div>
<!-- 11/11/2026: beneficio destacado (Centro Horizonte) + certificación Guinness (4 fotos oficiales). -->
<div class="sol-benef">
<div><p class="pa-mono sol-benef__kick">A beneficio de</p><p class="pa-display sol-benef__name">Centro Horizonte</p><p class="sol-benef__nota">Educación de niños con parálisis cerebral.</p></div>
<p class="sol-benef__monto"><span class="pa-mono sol-benef__kick">El evento recaudó</span><strong class="pa-display">más de $975.000</strong></p>
</div>
<!-- 11/11/2026: qué es Centro Horizonte (texto entregado por Emi = horizonte.com.uy) + foto de la donación. -->
<div class="sol-ch">
<figure class="sol-ch__img"><picture><source type="image/webp" srcset="/media/img/guinness-cert/horizonte-donacion-800.webp 800w, /media/img/guinness-cert/horizonte-donacion-1206.webp 1206w" sizes="(min-width: 900px) 50vw, 100vw"><img src="/media/img/guinness-cert/horizonte-donacion-800.jpg" srcset="/media/img/guinness-cert/horizonte-donacion-800.jpg 800w, /media/img/guinness-cert/horizonte-donacion-1206.jpg 1206w" sizes="(min-width: 900px) 50vw, 100vw" width="1206" height="808" loading="lazy" decoding="async" alt="Alejandro Curcio sostiene el cheque gigante del Ice Challenge 2024: «Donamos a nombre de la fundación Centro Horizonte»"></picture></figure>
<div class="sol-ch__txt">
<p class="pa-mono sol-benef__kick">¿Qué es Centro Horizonte?</p>
<p>La Escuela Horizonte nació en 1962 para brindar educación a niños con parálisis cerebral excluidos del sistema educativo.</p>
<p>Evolucionó y obtuvo apoyo público, estableciendo convenios con INAU en 1991 y 1998 para programas de atención parcial y tiempo completo.</p>
<p>En 2020, se modernizó con enfoque reflexivo e interacción, cambiando su nombre a Centro para destacar dos proyectos integrados.</p>
<p>Este cambio no solo reafirma el compromiso del Centro con el tratamiento y desarrollo de personas con parálisis cerebral, sino que también lo posiciona como líder en la promoción de la integración social y la innovación en este campo.</p>
<a class="pa-btn sol-ch__btn" href="https://www.horizonte.com.uy/" target="_blank" rel="noopener noreferrer"><span>Conocé más de Centro Horizonte</span><span class="pa-btn-ico" aria-hidden="true"><svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></span></a>
</div>
</div>
<div class="sol-cert">
<p class="pa-mono sol-cert__kick">Certificación oficial · Guinness World Records&trade;</p>
<div class="sol-cert__grid">
<figure class="sol-cert__fig" data-reveal><picture><source type="image/webp" srcset="/media/img/guinness-cert/cert-1-800.webp 800w, /media/img/guinness-cert/cert-1-1400.webp 1400w" sizes="(min-width: 900px) 50vw, 100vw"><img src="/media/img/guinness-cert/cert-1-800.jpg" srcset="/media/img/guinness-cert/cert-1-800.jpg 800w, /media/img/guinness-cert/cert-1-1400.jpg 1400w" sizes="(min-width: 900px) 50vw, 100vw" width="1400" height="933" loading="lazy" decoding="async" alt="Escenario del Ice Challenge 2024 en Montevideo durante la entrega del certificado Guinness World Records"></picture></figure>
<figure class="sol-cert__fig" data-reveal><picture><source type="image/webp" srcset="/media/img/guinness-cert/cert-2-800.webp 800w, /media/img/guinness-cert/cert-2-1400.webp 1400w" sizes="(min-width: 900px) 50vw, 100vw"><img src="/media/img/guinness-cert/cert-2-800.jpg" srcset="/media/img/guinness-cert/cert-2-800.jpg 800w, /media/img/guinness-cert/cert-2-1400.jpg 1400w" sizes="(min-width: 900px) 50vw, 100vw" width="1400" height="933" loading="lazy" decoding="async" alt="Entrega del certificado oficial de Guinness World Records del Ice Challenge 2024"></picture></figure>
<figure class="sol-cert__fig" data-reveal><picture><source type="image/webp" srcset="/media/img/guinness-cert/cert-3-800.webp 800w, /media/img/guinness-cert/cert-3-1400.webp 1400w" sizes="(min-width: 900px) 50vw, 100vw"><img src="/media/img/guinness-cert/cert-3-800.jpg" srcset="/media/img/guinness-cert/cert-3-800.jpg 800w, /media/img/guinness-cert/cert-3-1400.jpg 1400w" sizes="(min-width: 900px) 50vw, 100vw" width="1400" height="933" loading="lazy" decoding="async" alt="La adjudicadora de Guinness World Records entrega el certificado del récord en el escenario del Ice Challenge 2024"></picture></figure>
<figure class="sol-cert__fig" data-reveal><picture><source type="image/webp" srcset="/media/img/guinness-cert/cert-4-800.webp 800w, /media/img/guinness-cert/cert-4-1400.webp 1400w" sizes="(min-width: 900px) 50vw, 100vw"><img src="/media/img/guinness-cert/cert-4-800.jpg" srcset="/media/img/guinness-cert/cert-4-800.jpg 800w, /media/img/guinness-cert/cert-4-1400.jpg 1400w" sizes="(min-width: 900px) 50vw, 100vw" width="1400" height="933" loading="lazy" decoding="async" alt="Participantes del Ice Challenge 2024 celebran con el certificado Guinness World Records, 13 de abril de 2024"></picture></figure>
</div>
</div>
<style is:inline>
.sol-benef{margin-top:clamp(56px,7vw,104px);padding:clamp(32px,4vw,56px) 0;border-top:1px solid rgba(232,200,116,.35);border-bottom:1px solid rgba(232,200,116,.35);display:grid;grid-template-columns:minmax(0,1.2fr) minmax(0,1fr);gap:clamp(24px,4vw,64px);align-items:end}
.sol-benef__kick,.sol-cert__kick{font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:var(--accent,#e8c874);margin:0 0 14px}
.sol-benef__name{font-size:clamp(44px,7vw,112px);line-height:.92;letter-spacing:-.04em;margin:0;color:var(--ink-hi,#fff)}
.sol-benef__nota{font-size:clamp(18px,1rem + .5vw,24px);line-height:1.4;margin:16px 0 0;color:var(--ink-mid,rgba(255,255,255,.75))}
.sol-benef__monto{margin:0;display:grid;gap:10px}
.sol-benef__monto strong{font-size:clamp(48px,7.5vw,120px);line-height:.9;letter-spacing:-.05em;font-weight:var(--display-wght,560);background:linear-gradient(135deg,#b8892a 0%,#e8c874 46%,#c9992f 100%);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}
.cir-grid{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(0,1fr);gap:clamp(24px,4vw,64px);align-items:center;margin-top:clamp(28px,4vw,56px)}
.cir-video{border-radius:18px;overflow:hidden;aspect-ratio:16/9;background:#000}
.cir-video video{display:block;width:100%;height:100%;object-fit:cover}
.cir-txt p{margin:0 0 16px;font-size:clamp(16px,.95rem + .25vw,19px);line-height:1.6;color:var(--ink-mid,rgba(255,255,255,.78))}
.cir-txt .cir-dato{display:grid;gap:8px;margin-bottom:24px}
.cir-dato strong{font-size:clamp(48px,6vw,96px);line-height:.9;letter-spacing:-.05em;background:linear-gradient(135deg,#b8892a 0%,#e8c874 46%,#c9992f 100%);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}
.cir-dato span{color:var(--ink-hi,#fff)}
@media (max-width:860px){.cir-grid{grid-template-columns:1fr}}
.tel{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,1fr);gap:clamp(28px,5vw,80px);align-items:start;margin:clamp(24px,3vw,40px) 0 clamp(48px,6vw,96px);padding:clamp(28px,3.5vw,48px) 0;border-top:1px solid rgba(20,17,12,.14);border-bottom:1px solid rgba(20,17,12,.14)}
.tel-kick{font-size:11.5px;letter-spacing:.1em;text-transform:uppercase;color:#8a6a24;margin:0 0 16px}
.tel-intro p{margin:0 0 14px;font-size:clamp(16px,.95rem + .25vw,18px);line-height:1.6;color:#4a443a}
.tel-intro p.tel-lead{font-size:clamp(22px,1rem + 1.1vw,32px);line-height:1.25;letter-spacing:-.01em;color:#14110c}
.tel-btn{margin-top:10px}
.tel-stats{margin:0;display:grid;gap:22px}
.tel-stats div{display:grid;grid-template-columns:auto 1fr;gap:18px;align-items:baseline;padding-bottom:18px;border-bottom:1px solid rgba(20,17,12,.1)}
.tel-stats dt{font-size:clamp(44px,5vw,80px);line-height:.9;letter-spacing:-.05em;background:linear-gradient(135deg,#b8892a 0%,#e8c874 46%,#c9992f 100%);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;min-width:2.2ch}
.tel-stats dd{margin:0;font-size:15px;line-height:1.45;color:#4a443a}
@media (max-width:860px){.tel{grid-template-columns:1fr}}
.tely-list{display:grid;gap:clamp(56px,7vw,110px);margin-top:clamp(32px,4vw,56px)}
.tely-head{display:grid;grid-template-columns:auto 1fr auto;gap:clamp(16px,3vw,40px);align-items:end;padding-bottom:18px;border-bottom:1px solid rgba(20,17,12,.14)}
.tely-year{font-size:clamp(64px,9vw,150px);line-height:.82;letter-spacing:-.06em;background:linear-gradient(135deg,#b8892a 0%,#e8c874 46%,#c9992f 100%);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}
.tely-name{margin:0;font-size:clamp(22px,1rem + 1.2vw,34px);line-height:1.05;letter-spacing:-.02em;color:#14110c}
.tely-meta{margin:8px 0 0;font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:#8b8475}
.tely-don{margin:0;display:grid;justify-items:end;gap:6px;text-align:right}
.tely-don span{font-size:10.5px;letter-spacing:.1em;text-transform:uppercase;color:#8a6a24}
.tely-don strong{font-size:clamp(28px,1rem + 2vw,48px);line-height:1;letter-spacing:-.03em;color:#14110c}
.tely-txt{margin:20px 0 22px;max-width:68ch;font-size:clamp(16px,.95rem + .25vw,19px);line-height:1.6;color:#4a443a}
.tely-grid{display:grid;grid-template-columns:minmax(0,.8fr) repeat(2,minmax(0,1.2fr));grid-auto-rows:clamp(150px,15vw,240px);gap:12px}
.tely-video{grid-row:span 2;border-radius:16px;overflow:hidden;background:#000}
.tely-video video{display:block;width:100%;height:100%;object-fit:cover}
.tely-foto{margin:0;border-radius:16px;overflow:hidden}
.tely-foto picture,.tely-foto img{display:block;width:100%;height:100%;object-fit:cover}
.tely--novideo .tely-grid{grid-template-columns:repeat(3,minmax(0,1fr));grid-auto-rows:clamp(180px,20vw,300px)}
@media (max-width:860px){.tely-head{grid-template-columns:1fr}.tely-don{justify-items:start;text-align:left}.tely-grid,.tely--novideo .tely-grid{grid-template-columns:1fr 1fr;grid-auto-rows:clamp(140px,40vw,240px)}.tely-video{grid-row:span 2;grid-column:span 1}}
.sol-ch{margin-top:clamp(40px,5vw,72px);display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,1fr);gap:clamp(24px,4vw,64px);align-items:center}.sol-ch__img{margin:0;border-radius:18px;overflow:hidden}.sol-ch__img img{display:block;width:100%;height:auto}.sol-ch__txt p{margin:0 0 14px;font-size:clamp(16px,.95rem + .2vw,18px);line-height:1.6;color:var(--ink-mid,rgba(255,255,255,.78))}.sol-ch__txt p.sol-benef__kick{margin-bottom:18px}.sol-ch__btn{margin-top:14px}@media (max-width:820px){.sol-ch{grid-template-columns:1fr}}
.sol-cert{margin-top:clamp(56px,7vw,104px)}
.sol-cert__grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:clamp(12px,1.4vw,20px)}
.sol-cert__fig{margin:0;overflow:hidden}
.teleton-records .tr-grid{grid-template-columns:repeat(3,minmax(0,1fr))}
@media (max-width:820px){.teleton-records .tr-grid{grid-template-columns:1fr}}
.sol-cert__fig img{display:block;width:100%;height:auto}
@media (max-width:820px){.sol-benef{grid-template-columns:1fr}}
@media (max-width:600px){.sol-cert__grid{grid-template-columns:1fr}}
</style>
		</div>
	</section>

	<div class="section-gap"></div>

	<!-- DRIFT ARENA SOLIDARIO · TELETÓN. Material: el reel propio del evento
	     (manifest «drift-solidario», noviembre 2024). La copia se limita a lo
	     verificado: nombre, fecha, Teletón y lo que se ve en el video. -->
	<section id="drift-solidario" class="pa-cap pa-cap--bone pa-grid">
		<div class="wrap">
			<header class="pa-cap-head">
				<p class="pa-kick"><span class="pa-idx">[ 03 ]</span>Teletón · Drift solidario · 2022 — 2024</p>
				<h2 class="pa-display pa-cap-title" data-split="lines">Teletón.<br />Drift solidario.</h2>
			</header>
<!-- 11/11/2026: Teletón con el mismo peso que el récord Guinness (pedido de Emi). Cifras: Teletón vía Montevideo Portal (2025) y cuenta pública 2016. -->
<div class="tel">
<div class="tel-intro">
<p class="pa-mono tel-kick">¿Qué es Teletón?</p>
<p class="tel-lead">La Fundación Teletón Uruguay brinda rehabilitación integral y gratuita a niños, niñas y adolescentes con discapacidad motriz, en todo el país.</p>
<p>Su centro de Montevideo abrió en 2006 y el de Fray Bentos atiende desde 2012. Cada noviembre, la maratón televisiva reúne los fondos que sostienen esa atención durante todo el año. El drift solidario de Toyota Gazoo Racing suma su parte a esa causa.</p>
<a class="pa-btn tel-btn" href="https://www.teleton.org.uy/" target="_blank" rel="noopener noreferrer"><span>Conocé más de Teletón</span><span class="pa-btn-ico" aria-hidden="true"><svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></span></a>
</div>
<dl class="tel-stats">
<div><dt class="pa-display">2</dt><dd>Centros de rehabilitación: Montevideo y Fray Bentos</dd></div>
<div><dt class="pa-display">+5.800</dt><dd>Niños y adolescentes atendidos</dd></div>
<div><dt class="pa-display">3</dt><dd>Años seguidos de récord de recaudación en el drift solidario</dd></div>
</dl>
</div>

			<MediaTextBlock>
				<Fragment slot="media">
					<div class="drift-media pa-crop" data-reveal="mask">
						<video
							class="drift-video"
							data-audio="auto"
							src="/media/video/drift-solidario-card-audio.mp4"
							poster="/media/video/drift-solidario-card-poster.jpg"
							muted
							loop
							autoplay
							playsinline
							preload="metadata"
							aria-label="Auto de Toyota Gazoo Racing derrapando ante el público en el Drift Arena Solidario, noviembre de 2024"
						></video>
					</div>
					<span class="drift-caption pa-mono">Drift Arena Solidario — noviembre 2024</span>
				</Fragment>

				<p class="aventura-para aventura-para--big" data-reveal>
					El 9 de noviembre de 2024, el Antel Arena se convirtió en pista: los autos de Toyota Gazoo
					Racing derrapando frente a las tribunas llenas, con entrada libre, para contribuir a la
					movilidad de los niños de la Fundación Teletón.
				</p>

				<dl class="drift-datos" data-reveal>
					<div><dt class="pa-mono">Fecha</dt><dd>9 de noviembre de 2024</dd></div>
					<div><dt class="pa-mono">Lugar</dt><dd>Antel Arena, Montevideo</dd></div>
					<div><dt class="pa-mono">Entrada</dt><dd>Libre</dd></div>
					<div><dt class="pa-mono">A beneficio de</dt><dd>Fundación Teletón — movilidad de los niños</dd></div>
				</dl>
			</MediaTextBlock>

			<!-- Récords de recaudación (10/11/2026): fotos y montos de los cheques
			     entregados a Teletón en 2022, 2023 y 2024 (material de Emi). -->
			<div class="teleton-records">
			<div class="tr-head">
			<p class="pa-mono tr-kick">2022 · 2023 · 2024</p>
			<h3 class="pa-display tr-title" data-split="lines">Tres años consecutivos,<br> récord de recaudación.</h3>
			<p class="aventura-para tr-lead" data-reveal>Tres ediciones seguidas del drift solidario, y en cada una se rompió el récord de recaudación para la Fundación Teletón.</p>
			</div>
			<div class="tely-list"><article class="tely" data-reveal>
<header class="tely-head"><span class="pa-display tely-year">2022</span><div><p class="tely-name pa-display">Drift Park Solidario</p><p class="pa-mono tely-meta">5 de noviembre de 2022</p></div><p class="tely-don"><span class="pa-mono">Donación a Teletón</span><strong class="pa-display">$ 3.036.400</strong></p></header>
<p class="tely-txt">La primera edición: pilotos de Toyota Gazoo Racing, autos de calle y de competencia, y un público que fue a ver drift y terminó donando para la Fundación Teletón.</p>
<div class="tely-grid"><div class="tely-video"><video data-audio="auto" src="/media/video/drift-solidario-2022.mp4" poster="/media/video/drift-solidario-2022-poster.jpg" muted loop autoplay playsinline preload="none" aria-label="Video del Drift Park Solidario 2022"></video></div><figure class="tely-foto tely-cheque"><picture>
