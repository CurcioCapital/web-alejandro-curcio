  --trb-mid: rgba(255, 255, 255, 0.62);
  --trb-mono: 'JetBrains Mono Variable', 'JetBrains Mono', ui-monospace, monospace;
  --trb-serif: 'Instrument Serif', 'Instrument Serif Fallback', Georgia, serif;
  --trb-sans: 'Geist Variable', -apple-system, system-ui, sans-serif;
  position: relative;
  background: var(--trb-bgc);
  color: var(--trb-ink);
  font-family: var(--trb-sans);
}
