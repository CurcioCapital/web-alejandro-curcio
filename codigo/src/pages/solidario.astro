  width: min(100%, 1440px);
  margin: 0 auto;
  padding: 0 clamp(20px, 4vw, 64px);
}

/* ---- Columna fija: trébol + % ---- */
.trb-side {
  position: sticky;
  top: var(--trb-top);
  height: calc(100svh - var(--trb-top));
  display: grid;
  grid-template-rows: auto 1fr auto;
  padding: 18px 0 clamp(20px, 4vh, 40px);
  z-index: 2;
}
.trb-top { display: flex; align-items: center; justify-content: space-between; gap: 16px; }
.trb-kick {
  font-family: var(--trb-mono); font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase;
  color: var(--trb-gold); display: flex; align-items: center; gap: 12px;
}
.trb-kick::after { content: ''; width: 40px; height: 1px; background: currentColor; opacity: 0.5; }
.trb-skip {
  font-family: var(--trb-mono); font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase;
  color: var(--trb-mid); text-decoration: none; display: inline-flex; align-items: center; gap: 8px;
  min-height: 44px; padding: 0 2px; transition: color 0.25s;
}
.trb-skip:hover, .trb-skip:focus-visible { color: var(--trb-gold); }
.trb-skip:focus-visible { outline: 1px solid var(--trb-gold); outline-offset: 4px; }

.trb-mark { display: grid; place-items: center; align-content: center; gap: clamp(18px, 3vh, 32px); min-height: 0; }
.trb-svgbox { position: relative; width: min(30vw, 46vh, 420px); aspect-ratio: 1; }
.trb-svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
.trb-ghost path { fill: rgba(255, 255, 255, 0.07); }
.trb-leaf path { fill: url(#trb-oro); }
.trb-glow { opacity: 0.55; }
.trb-leafshine { opacity: 0; }
.trb-spark { opacity: 0; }
.trb.is-painting .trb-spark { opacity: 1; }
.trb.is-complete .trb-glow { animation: trb-breathe 3.2s ease-in-out infinite; }
@keyframes trb-breathe { 0%, 100% { opacity: 0.55; } 50% { opacity: 0.9; } }

.trb-meta { display: grid; justify-items: center; gap: 8px; text-align: center; }
.trb-pct {
  font-family: var(--trb-mono); font-variant-numeric: tabular-nums;
  font-size: clamp(28px, 1rem + 1.6vw, 44px); line-height: 1; letter-spacing: -0.02em;
  background: var(--trb-oro); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent;
}
.trb-pct small { font-size: 0.5em; margin-left: 2px; }
.trb-leafline {
  font-family: var(--trb-mono); font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--trb-mid);
  min-height: 1.4em;
}
.trb-leafline b { color: var(--trb-gold); font-weight: 500; }
.trb-bar { width: min(220px, 60%); height: 2px; background: rgba(255, 255, 255, 0.12); border-radius: 2px; overflow: hidden; }
.trb-bar i { display: block; height: 100%; background: var(--trb-oro); transform-origin: 0 50%; transform: scaleX(var(--trb-p, 0)); will-change: transform; }

/* ---- Columna de texto: scroll nativo ---- */
.trb-text { position: relative; padding: 0 0 0; z-index: 1; }
.trb-fade {
  position: sticky; height: 0; z-index: 3; pointer-events: none;
}
.trb-fade i { position: absolute; left: -2px; right: -2px; height: clamp(110px, 22vh, 220px); display: block; }
.trb-fade--top { top: 0; }
.trb-fade--top i { top: 0; height: calc(var(--trb-top) + clamp(90px, 18vh, 180px)); background: linear-gradient(var(--trb-bgc) 0, var(--trb-bgc) calc(var(--trb-top) + 10px), rgba(12, 10, 6, 0)); }
.trb-fade--bot { bottom: 0; }
.trb-fade--bot i { bottom: 0; background: linear-gradient(rgba(12, 10, 6, 0), var(--trb-bgc) 88%); }

.trb-reel { max-width: 40rem; padding: 34vh 0 44vh; }
.trb-item { will-change: opacity; }
.trb-intro { margin-bottom: 22vh; }
.trb-intro-kick { font-family: var(--trb-mono); font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--trb-mid); margin-bottom: 18px !important; }
.trb-title { font-size: clamp(2.8rem, 1.2rem + 4.4vw, 6rem); line-height: 0.96; letter-spacing: -0.04em; font-weight: 560; color: #fff; }
.trb-title em { font-family: var(--trb-serif); font-style: italic; font-weight: 400; letter-spacing: -0.01em; background: var(--trb-oro); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; padding-right: 0.06em; }
.trb-sub { margin-top: 22px !important; font-size: clamp(17px, 1rem + 0.3vw, 21px); line-height: 1.5; color: var(--trb-mid); max-width: 30rem; }

.trb-act { margin-top: 16vh; }
.trb-act:first-of-type { margin-top: 0; }
.trb-act-head { display: flex; align-items: center; gap: 14px; font-family: var(--trb-mono); font-size: 11px; font-weight: 400; letter-spacing: 0.16em; text-transform: uppercase; color: var(--trb-mid); margin-bottom: 4vh !important; }
.trb-act-no { color: var(--trb-gold); }
.trb-act-head::after { content: ''; width: 28px; height: 1px; background: currentColor; opacity: 0.6; order: 1; }
.trb-act-label { order: 2; }

.trb-beat--read { font-size: clamp(20px, 0.95rem + 0.75vw, 29px); line-height: 1.48; letter-spacing: -0.012em; color: var(--trb-ink); margin-bottom: 1.15em !important; text-wrap: pretty; }
.trb-beat--big, .trb-beat--final {
  font-family: var(--trb-serif); font-style: italic; font-weight: 400;
  font-size: clamp(34px, 1.1rem + 3.2vw, 68px); line-height: 1.06; letter-spacing: -0.012em;
  margin: 13vh 0 !important; text-wrap: balance;
  background: var(--trb-oro); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent;
}
.trb-beat--final { margin-bottom: 4vh !important; }
.trb-sign { display: flex; align-items: center; gap: 14px; font-family: var(--trb-serif); font-style: italic; font-size: clamp(20px, 1rem + 0.6vw, 28px); color: var(--trb-ink); }
.trb-sign-dash { width: 40px; height: 1px; background: var(--trb-gold); opacity: 0.7; }
#trb-fin:focus { outline: none; }

/* ---- Móvil: el trébol pasa a una barra fija arriba ---- */
@media (max-width: 860px) {
  .trb { --trb-top: 64px; }
  .trb-grid { grid-template-columns: 1fr; gap: 0; }
  .trb-side {
    height: auto; top: var(--trb-top); padding: 10px 0 12px;
    grid-template-rows: auto; grid-template-columns: auto 1fr auto; align-items: center; gap: 14px;
    background: var(--trb-bgc);
  }
  .trb-top { display: contents; }
  .trb-kick { display: none; }
  .trb-skip { order: 3; font-size: 10px; }
  .trb-mark { order: 1; grid-template-columns: auto 1fr; justify-items: start; place-items: center start; gap: 14px; grid-column: 1 / 3; }
  .trb-svgbox { width: 64px; }
  .trb-meta { justify-items: start; text-align: left; gap: 5px; }
  .trb-pct { font-size: 24px; }
  .trb-leafline { font-size: 10px; }
  .trb-bar { width: 100%; max-width: 180px; }
  .trb-side::before { content: ''; position: absolute; left: -40px; right: -40px; bottom: 100%; height: var(--trb-top); background: var(--trb-bgc); }
  .trb-fade--top i { height: calc(var(--trb-top) + 88px + 80px); background: linear-gradient(var(--trb-bgc) 0, var(--trb-bgc) calc(var(--trb-top) + 88px), rgba(12, 10, 6, 0)); }
  .trb-reel { padding: 26vh 0 40vh; }
}

/* ---- Movimiento reducido: texto corrido completo, sin fundidos ---- */
@media (prefers-reduced-motion: reduce) {
  .trb-fade { display: none; }
  .trb-item { opacity: 1 !important; }
  .trb-reel { padding: 12vh 0 16vh; }
  .trb-spark { display: none; }
  .trb.is-complete .trb-glow { animation: none; }
}
</style>
<script is:inline>
/* La historia del trébol — v2 (fluida). Vanilla, sin dependencias.
   - El texto se mueve con el scroll nativo/Lenis (sin transform por JS).
   - Un único rAF mientras la sección está cerca: lee scrollY una vez,
     calcula el progreso de lectura con medidas cacheadas y:
       · pinta el trébol en dorado en proporción exacta al % leído
         (las 4 hojas en orden, como un cuentakilómetros),
       · actualiza el % y la barra,
       · ajusta la opacidad de cada párrafo según su distancia a la
         línea de lectura (continuo, sin saltos).
   - Nada de lecturas de layout por frame; se re-mide con ResizeObserver. */
(function () {
  var root = document.querySelector('[data-trb]');
  if (!root || root.__trb2) return;
  root.__trb2 = true;

  var reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  var text = root.querySelector('.trb-text');
  var pctEl = root.querySelector('[data-trb-pct]');
  var leafEl = root.querySelector('[data-trb-leaf]');
  var spark = root.querySelector('.trb-spark');
  var skip = root.querySelector('.trb-skip');
  var fin = root.querySelector('#trb-fin');
  var items = [].slice.call(root.querySelectorAll('.trb-item, .trb-act-head, .trb-sign'));
  var acts = [].slice.call(root.querySelectorAll('.trb-act')).map(function (el, i) {
    return { el: el, label: el.getAttribute('data-label') || '', n: i + 1 };
  });
  var leaves = [1, 2, 3, 4].map(function (n) {
    var mp = root.querySelector('#trb-m' + n + ' path');
    return {
      mp: mp,
      shine: root.querySelector('.trb-leafshine[data-leaf="' + n + '"]'),
      g: root.querySelector('.trb-leaf[data-leaf="' + n + '"]'), full: false,
      len: 0, lut: [], last: -1, lastShine: -1
    };
  });

  var c01 = function (v) { return v < 0 ? 0 : v > 1 ? 1 : v; };
  var smooth = function (t) { t = c01(t); return t * t * (3 - 2 * t); };

  // ---- Geometría del trébol (una sola vez)
  var total = 0;
  leaves.forEach(function (L) {
    if (!L.mp || !L.mp.getTotalLength) return;
    L.len = L.mp.getTotalLength();
    L.start = total;
    total += L.len;
    L.mp.style.strokeDasharray = L.len + ' ' + (L.len + 1);
    L.mp.style.strokeDashoffset = L.len;
    var N = 80;
    for (var i = 0; i <= N; i++) {
      var pt = L.mp.getPointAtLength(L.len * i / N);
      L.lut.push([pt.x, pt.y]);
    }
  });

  // ---- Medidas cacheadas
  var M = { top: 0, start: 0, end: 1, vh: 1, items: [], acts: [] };
  function absTop(el) {
    var r = el.getBoundingClientRect();
    return r.top + (window.scrollY || window.pageYOffset);
  }
  function measure() {
    M.vh = window.innerHeight;
    var first = root.querySelector('.trb-act') || text;
    var finEl = fin || text;
    // Línea de lectura al 52% de la pantalla. 0% cuando arranca la Hoja 1,
    // 100% cuando la frase final llega a esa línea.
    M.line = M.vh * 0.52;
    M.start = absTop(first) - M.line;
    M.end = absTop(finEl) + finEl.offsetHeight * 0.5 - M.line;
    if (M.end <= M.start) M.end = M.start + 1;
    M.items = items.map(function (el) {
      return { el: el, c: absTop(el) + el.offsetHeight * 0.5, h: el.offsetHeight, o: -1 };
    });
    M.acts = acts.map(function (a) { return { a: a, y: absTop(a.el) - M.line }; });
    M.secTop = absTop(root);
    M.secBot = M.secTop + root.offsetHeight;
    dirty = true;
  }

  // ---- Pintura
  var lastPct = -1, lastAct = -1, lastState = '';
  function paint(p) {
    var drawn = p * total;
    var tipLeaf = null, tipT = 0;
    for (var i = 0; i < leaves.length; i++) {
      var L = leaves[i];
      if (!L.len) continue;
      var d = drawn - L.start;
      d = d < 0 ? 0 : d > L.len ? L.len : d;
      var off = L.len - d;
      if (Math.abs(off - L.last) > 0.05) { L.mp.style.strokeDashoffset = off.toFixed(2); L.last = off; }
      var full = d >= L.len;
      if (L.g && full !== L.full) { if (full) L.g.removeAttribute('mask'); else L.g.setAttribute('mask', 'url(#trb-m' + (i + 1) + ')'); L.full = full; }
      var sh = d / L.len;
      sh = sh >= 1 ? 1 : sh * 0.35;
      if (L.shine && Math.abs(sh - L.lastShine) > 0.004) { L.shine.style.opacity = sh.toFixed(3); L.lastShine = sh; }
      if (d > 0 && d < L.len) { tipLeaf = L; tipT = d / L.len; }
    }
    if (spark) {
      if (tipLeaf && p > 0 && p < 1) {
        var f = tipT * (tipLeaf.lut.length - 1), k = Math.floor(f), r = f - k;
        var a = tipLeaf.lut[k], b = tipLeaf.lut[Math.min(k + 1, tipLeaf.lut.length - 1)];
        spark.setAttribute('cx', (a[0] + (b[0] - a[0]) * r).toFixed(1));
        spark.setAttribute('cy', (a[1] + (b[1] - a[1]) * r).toFixed(1));
      }
    }
    var state = p <= 0 ? 'idle' : p >= 1 ? 'done' : 'painting';
    if (state !== lastState) {
      root.classList.toggle('is-painting', state === 'painting');
      root.classList.toggle('is-complete', state === 'done');
      lastState = state;
    }
    var pct = Math.round(p * 100);
    if (pct !== lastPct && pctEl) {
      pctEl.textContent = (pct < 10 ? '00' : pct < 100 ? '0' : '') + pct;
      lastPct = pct;
    }
    root.style.setProperty('--trb-p', p.toFixed(4));
  }

  function setAct(y) {
    var idx = -1;
    for (var i = 0; i < M.acts.length; i++) if (y >= M.acts[i].y - 2) idx = i;
    if (idx !== lastAct && leafEl) {
      lastAct = idx;
      if (idx < 0) leafEl.innerHTML = 'Una historia en cuatro hojas';
      else {
        var a = M.acts[idx].a, n = a.n < 10 ? '0' + a.n : a.n;
        leafEl.innerHTML = '<b>Hoja ' + n + '</b> / 04 · ' + a.label;
      }
    }
  }

  function fade(y) {
    if (reduce.matches) return;
    var line = y + M.line, span = M.vh * 0.62;
    for (var i = 0; i < M.items.length; i++) {
      var it = M.items[i];
      var dist = Math.abs(it.c - line) - it.h * 0.5;
      var o = 1 - smooth(dist / span) * 0.8; // 1 en la línea, 0.2 lejos
      if (dist <= 0) o = 1;
      if (Math.abs(o - it.o) > 0.01) { it.el.style.opacity = o.toFixed(3); it.o = o; }
    }
  }

  // ---- Loop
  var raf = 0, running = false, dirty = true, lastY = -1;
  function frame() {
    raf = 0;
    if (!running) return;
    var y = window.scrollY || window.pageYOffset;
    if (y !== lastY || dirty) {
      lastY = y; dirty = false;
      var p = c01((y - M.start) / (M.end - M.start));
      paint(p);
      setAct(y);
      fade(y);
    }
    raf = requestAnimationFrame(frame);
  }
  function start() { if (!running) { running = true; dirty = true; raf = requestAnimationFrame(frame); } }
  function stop() { running = false; if (raf) cancelAnimationFrame(raf); raf = 0; }

  if ('IntersectionObserver' in window) {
    new IntersectionObserver(function (es) {
      es.forEach(function (e) { if (e.isIntersecting) start(); else { dirty = true; frame(); stop(); } });
    }, { rootMargin: '200px 0px' }).observe(root);
  } else start();

  var rq = 0;
  function remeasure() { if (rq) return; rq = requestAnimationFrame(function () { rq = 0; measure(); if (!running) { running = true; frame(); running = false; } }); }
  measure();
  if ('ResizeObserver' in window) new ResizeObserver(remeasure).observe(text);
  window.addEventListener('resize', remeasure, { passive: true });
  if (document.fonts && document.fonts.ready) document.fonts.ready.then(remeasure);
  window.addEventListener('load', remeasure);
  // Estado inicial correcto aunque la sección no esté visible
  running = true; frame(); running = false;

  // ---- Saltar historia → cierre (trébol completo)
  if (skip) skip.addEventListener('click', function (ev) {
    ev.preventDefault();
    measure();
    var target = M.end + 2;
    var lenis = window.__lenis || window.lenis;
    if (lenis && lenis.scrollTo) lenis.scrollTo(target, { duration: 1.4, force: true });
    else window.scrollTo({ top: target, behavior: reduce.matches ? 'auto' : 'smooth' });
    if (fin) setTimeout(function () { try { fin.focus({ preventScroll: true }); } catch (e) {} }, 1500);
  });
})();
</script>

